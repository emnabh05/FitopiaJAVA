<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Pidev3A49.controllers.MonthlyRankingController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            stylesheets="@styles/admin-theme.css"
            style="-fx-background: #EAF9F3; -fx-background-color: #EAF9F3;">
    <content>
        <VBox prefWidth="1440.0"
              spacing="28.0"
              style="-fx-background-color: linear-gradient(to bottom right, #F8FFFC, #E8F7F1);">
            <children>
                <VBox styleClass="navbar-container">
                    <HBox alignment="CENTER_LEFT" styleClass="top-navbar-strip">
                        <Label text="Phone no: +216 58 938 889 or email us: customerservice@fitopia.com" styleClass="top-navbar-text" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="10">
                            <Label text="FB" styleClass="social-icon" />
                            <Label text="X" styleClass="social-icon" />
                            <Label text="IG" styleClass="social-icon" />
                        </HBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="navbar-shell">
                        <VBox alignment="CENTER" spacing="0">
                            <Label text="&#127811;" styleClass="navbar-logo-icon" />
                            <Label text="FITOPIA" styleClass="navbar-logo-text" />
                        </VBox>

                        <Region prefWidth="20" />

                        <Label text="Home" styleClass="navbar-link navbar-link-active" />
                        <Label text="About&#10;Fitopia" textAlignment="CENTER" styleClass="navbar-link" />

                        <Region prefWidth="10" />

                        <Button onAction="#openSupplementShowcase" text="EXPLORE&#10;SUPPLEMENTS" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                        <Button onAction="#openProgressTracker" text="MY&#10;PROGRESS" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                        <Button text="MONTHLY&#10;RANKING" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                        <Button onAction="#openSupplementShowcase" text="CHECKOUT" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                        <Button onAction="#openMyOrders" text="MY&#10;ORDERS" textAlignment="CENTER" styleClass="navbar-btn-blue" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button onAction="#openMyOrders" text="MY&#10;PROFILE" textAlignment="CENTER" styleClass="navbar-btn-green" />
                        <Button onAction="#openBackEnd" text="LOGOUT" textAlignment="CENTER" styleClass="navbar-btn-red" />
                    </HBox>
                </VBox>

                <VBox spacing="18.0">
                    <padding>
                        <Insets top="0.0" right="36.0" bottom="36.0" left="36.0"/>
                    </padding>
                    <children>
                        <VBox spacing="14.0"
                              style="-fx-background-color: linear-gradient(to right, #123B49, #1B8B76); -fx-background-radius: 28; -fx-effect: dropshadow(gaussian, rgba(6, 39, 34, 0.18), 24, 0.22, 0, 10);">
                            <padding>
                                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                            </padding>
                            <children>
                                <Label text="GLOBAL RANKING"
                                       style="-fx-text-fill: rgba(255,255,255,0.72); -fx-font-size: 13px; -fx-font-weight: 900; -fx-letter-spacing: 1px;"/>
                                <Label text="MONTHLY CONSISTENCY LEADERBOARD"
                                       wrapText="true"
                                       style="-fx-text-fill: #07161F; -fx-font-size: 48px; -fx-font-weight: 900;"/>
                                <Label text="Healthy ranking: longest active streak, then consistency %, then goal completion."
                                       wrapText="true"
                                       style="-fx-text-fill: rgba(255,255,255,0.88); -fx-font-size: 17px; -fx-font-weight: 600;"/>

                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <TextField fx:id="monthInputField"
                                                   promptText="yyyy-MM"
                                                   prefWidth="170.0"
                                                   style="-fx-background-color: rgba(255,255,255,0.10); -fx-background-radius: 14; -fx-border-color: rgba(255,255,255,0.20); -fx-border-radius: 14; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                        <Button text="Load Month"
                                                onAction="#loadMonthRanking"
                                                style="-fx-background-color: white; -fx-background-radius: 14; -fx-text-fill: #123748; -fx-font-size: 14px; -fx-font-weight: 800; -fx-padding: 10 16 10 16;"/>
                                        <Label fx:id="selectedMonthLabel"
                                               text="Month: -"
                                               style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                    </children>
                                </HBox>

                                <Label fx:id="rankingNotificationLabel"
                                       text="Ranking is based on active streak, consistency %, then goal completion."
                                       wrapText="true"
                                       maxWidth="980.0"
                                       style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 14; -fx-border-color: rgba(255,255,255,0.20); -fx-border-radius: 14; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700; -fx-padding: 10 14 10 14;"/>
                            </children>
                        </VBox>

                        <VBox spacing="10.0"
                              style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 20; -fx-border-color: #D5E3EA; -fx-border-radius: 20;">
                            <padding>
                                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                            </padding>
                            <children>
                                <Label text="Safety first: quantity does not improve rank. Follow your personal daily plan only."
                                       wrapText="true"
                                       style="-fx-text-fill: #2B7A68; -fx-font-size: 13px; -fx-font-weight: 700;"/>

                                <VBox fx:id="leaderboardRowsContainer" spacing="8.0"/>

                                <Label fx:id="leaderboardEmptyLabel"
                                       text="No adherence logs were found for this month yet."
                                       style="-fx-text-fill: #8A9BA7; -fx-font-size: 16px; -fx-font-weight: 600;"/>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Button text="Return"
                                        onAction="#goBackOrExit"
                                        prefWidth="130.0"
                                        prefHeight="44.0"
                                        style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #CBD8E0; -fx-border-radius: 14; -fx-text-fill: #163848; -fx-font-size: 14px; -fx-font-weight: 800;"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
