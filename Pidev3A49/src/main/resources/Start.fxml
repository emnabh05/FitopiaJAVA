<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Pidev3A49.controllers.LandingController"
      spacing="28.0"
      style="-fx-background-color: linear-gradient(to bottom right, #F5FBF9, #E5F4EF);">
    <padding>
        <Insets top="36.0" right="36.0" bottom="36.0" left="36.0"/>
    </padding>

    <children>
        <VBox spacing="18.0"
              style="-fx-background-color: linear-gradient(to right, #123C47, #1C725B); -fx-background-radius: 32; -fx-effect: dropshadow(gaussian, rgba(7, 37, 31, 0.18), 26, 0.20, 0, 12);">
            <padding>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
            </padding>
            <children>
                <Label text="FITOPIA"
                       style="-fx-text-fill: rgba(255,255,255,0.76); -fx-font-size: 14px; -fx-font-weight: 900; -fx-letter-spacing: 2px;"/>
                <Label text="Choose Your Workspace"
                       style="-fx-text-fill: white; -fx-font-size: 48px; -fx-font-weight: 900;"/>
                <Label text="Open the customer-facing store or the admin dashboard from the first screen."
                       wrapText="true"
                       maxWidth="720.0"
                       style="-fx-text-fill: rgba(255,255,255,0.88); -fx-font-size: 18px; -fx-font-weight: 600;"/>
            </children>
        </VBox>

        <HBox spacing="24.0">
            <children>
                <VBox spacing="18.0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 28; -fx-border-color: rgba(17, 76, 70, 0.08); -fx-border-radius: 28; -fx-effect: dropshadow(gaussian, rgba(9, 44, 42, 0.08), 18, 0.14, 0, 8);">
                    <padding>
                        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                    </padding>
                    <children>
                        <StackPane prefWidth="72.0" prefHeight="72.0"
                                   maxWidth="72.0" maxHeight="72.0"
                                   style="-fx-background-color: #E5F7F0; -fx-background-radius: 22;">
                            <children>
                                <Label text="FRONT"
                                       style="-fx-text-fill: #0F6A58; -fx-font-size: 16px; -fx-font-weight: 900;"/>
                            </children>
                        </StackPane>
                        <Label text="Front End"
                               style="-fx-text-fill: #123748; -fx-font-size: 32px; -fx-font-weight: 900;"/>
                        <Label text="Browse supplements, open progress tracking, monthly ranking, cart, and checkout."
                               wrapText="true"
                               style="-fx-text-fill: #6C7F8A; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button text="Open Front End"
                                onAction="#openFrontEnd"
                                prefHeight="48.0"
                                maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: linear-gradient(to right, #124A4D, #0F6A58); -fx-background-radius: 16; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 800;"/>
                    </children>
                </VBox>

                <VBox spacing="18.0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 28; -fx-border-color: rgba(17, 76, 70, 0.08); -fx-border-radius: 28; -fx-effect: dropshadow(gaussian, rgba(9, 44, 42, 0.08), 18, 0.14, 0, 8);">
                    <padding>
                        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                    </padding>
                    <children>
                        <StackPane prefWidth="72.0" prefHeight="72.0"
                                   maxWidth="72.0" maxHeight="72.0"
                                   style="-fx-background-color: #E7F0FF; -fx-background-radius: 22;">
                            <children>
                                <Label text="ADMIN"
                                       style="-fx-text-fill: #1E4F8A; -fx-font-size: 16px; -fx-font-weight: 900;"/>
                            </children>
                        </StackPane>
                        <Label text="Back End"
                               style="-fx-text-fill: #123748; -fx-font-size: 32px; -fx-font-weight: 900;"/>
                        <Label text="Manage supplement records and use the admin dashboard tools."
                               wrapText="true"
                               style="-fx-text-fill: #6C7F8A; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button text="Open Back End"
                                onAction="#openBackEnd"
                                prefHeight="48.0"
                                maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: linear-gradient(to right, #123C47, #255D71); -fx-background-radius: 16; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 800;"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER_LEFT">
            <children>
                <Button text="Return"
                        onAction="#goBackOrExit"
                        prefWidth="130.0"
                        prefHeight="46.0"
                        style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #C8D7E0; -fx-border-radius: 16; -fx-text-fill: #123748; -fx-font-size: 15px; -fx-font-weight: 800;"/>
            </children>
        </HBox>
    </children>
</VBox>
