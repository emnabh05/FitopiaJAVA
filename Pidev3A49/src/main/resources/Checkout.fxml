<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Pidev3A49.controllers.CheckoutController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background: #F3F7FA; -fx-background-color: #F3F7FA;">
    <fx:define>
        <ToggleGroup fx:id="paymentMethodGroup"/>
    </fx:define>

    <content>
        <VBox prefWidth="1380.0"
              spacing="24.0"
              style="-fx-background-color: linear-gradient(to bottom right, #F7FBFD, #EAF4F7);">
            <padding>
                <Insets top="28.0" right="28.0" bottom="34.0" left="28.0"/>
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT"
                      spacing="16.0"
                      style="-fx-background-color: linear-gradient(to right, #123C47, #206A57); -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(6, 36, 33, 0.18), 24, 0.22, 0, 10);">
                    <padding>
                        <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
                    </padding>
                    <children>
                        <StackPane prefWidth="42.0" prefHeight="42.0"
                                   style="-fx-background-color: rgba(255,255,255,0.14); -fx-background-radius: 14;">
                            <children>
                                <Label text="LOCK"
                                       style="-fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: 900;"/>
                            </children>
                        </StackPane>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="SECURE CHECKOUT"
                                       style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: 900;"/>
                                <Label text="Customer details, order review, and a real checkout save to MySQL."
                                       style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 14px; -fx-font-weight: 600;"/>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Store"
                                onAction="#openSupplementShowcase"
                                prefHeight="40.0"
                                style="-fx-background-color: rgba(255,255,255,0.14); -fx-background-radius: 14; -fx-border-color: rgba(255,255,255,0.26); -fx-border-radius: 14; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700; -fx-padding: 0 18 0 18;"/>
                        <Button text="Back End"
                                onAction="#openBackEnd"
                                prefHeight="40.0"
                                style="-fx-background-color: rgba(255,255,255,0.14); -fx-background-radius: 14; -fx-border-color: rgba(255,255,255,0.26); -fx-border-radius: 14; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700; -fx-padding: 0 18 0 18;"/>
                        <Button text="My Orders"
                                onAction="#openMyOrders"
                                prefHeight="40.0"
                                style="-fx-background-color: rgba(255,255,255,0.14); -fx-background-radius: 14; -fx-border-color: rgba(255,255,255,0.26); -fx-border-radius: 14; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700; -fx-padding: 0 18 0 18;"/>
                    </children>
                </HBox>

                <FlowPane hgap="24.0" vgap="24.0" prefWrapLength="1180.0">
                    <children>
                        <VBox spacing="22.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="18.0"
                                      style="-fx-background-color: white; -fx-background-radius: 26; -fx-border-color: rgba(17, 76, 70, 0.09); -fx-border-radius: 26; -fx-effect: dropshadow(gaussian, rgba(9, 44, 42, 0.10), 18, 0.16, 0, 8);">
                                    <padding>
                                        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                                    </padding>
                                    <children>
                                        <VBox spacing="6.0">
                                            <children>
                                                <Label text="Customer details"
                                                       style="-fx-text-fill: #0E3040; -fx-font-size: 26px; -fx-font-weight: 900;"/>
                                                <Label text="Fill in the shipping information exactly as it should appear on delivery."
                                                       wrapText="true"
                                                       style="-fx-text-fill: #6B7D88; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                                            </children>
                                        </VBox>

                                        <HBox spacing="12.0">
                                            <children>
                                                <TextField fx:id="firstNameField"
                                                           promptText="First name"
                                                           prefHeight="48.0"
                                                           HBox.hgrow="ALWAYS"
                                                           style="-fx-background-color: #FBFDFE; -fx-background-radius: 14; -fx-border-color: #D6E2EA; -fx-border-radius: 14; -fx-font-size: 14px; -fx-prompt-text-fill: #8A9CA7;"/>
                                                <TextField fx:id="lastNameField"
                                                           promptText="Last name"
                                                           prefHeight="48.0"
                                                           HBox.hgrow="ALWAYS"
                                                           style="-fx-background-color: #FBFDFE; -fx-background-radius: 14; -fx-border-color: #D6E2EA; -fx-border-radius: 14; -fx-font-size: 14px; -fx-prompt-text-fill: #8A9CA7;"/>
                                            </children>
                                        </HBox>

                                        <TextField fx:id="emailField"
                                                   promptText="Email"
                                                   prefHeight="48.0"
                                                   style="-fx-background-color: #FBFDFE; -fx-background-radius: 14; -fx-border-color: #D6E2EA; -fx-border-radius: 14; -fx-font-size: 14px; -fx-prompt-text-fill: #8A9CA7;"/>

                                        <TextField fx:id="phoneField"
                                                   promptText="Phone"
                                                   prefHeight="48.0"
                                                   style="-fx-background-color: #FBFDFE; -fx-background-radius: 14; -fx-border-color: #D6E2EA; -fx-border-radius: 14; -fx-font-size: 14px; -fx-prompt-text-fill: #8A9CA7;"/>

                                        <TextField fx:id="addressField"
                                                   promptText="Address"
                                                   prefHeight="48.0"
                                                   style="-fx-background-color: #FBFDFE; -fx-background-radius: 14; -fx-border-color: #D6E2EA; -fx-border-radius: 14; -fx-font-size: 14px; -fx-prompt-text-fill: #8A9CA7;"/>

                                        <HBox spacing="12.0">
                                            <children>
                                                <TextField fx:id="cityField"
                                                           promptText="City"
                                                           prefHeight="48.0"
                                                           HBox.hgrow="ALWAYS"
                                                           style="-fx-background-color: #FBFDFE; -fx-background-radius: 14; -fx-border-color: #D6E2EA; -fx-border-radius: 14; -fx-font-size: 14px; -fx-prompt-text-fill: #8A9CA7;"/>
                                                <TextField fx:id="postalCodeField"
                                                           promptText="Postal code"
                                                           prefHeight="48.0"
                                                           HBox.hgrow="ALWAYS"
                                                           style="-fx-background-color: #FBFDFE; -fx-background-radius: 14; -fx-border-color: #D6E2EA; -fx-border-radius: 14; -fx-font-size: 14px; -fx-prompt-text-fill: #8A9CA7;"/>
                                            </children>
                                        </HBox>

                                        <TextArea fx:id="notesArea"
                                                  promptText="Notes (optional)"
                                                  prefHeight="112.0"
                                                  wrapText="true"
                                                  style="-fx-background-color: #FBFDFE; -fx-background-radius: 16; -fx-border-color: #D6E2EA; -fx-border-radius: 16; -fx-font-size: 14px; -fx-prompt-text-fill: #8A9CA7;"/>
                                    </children>
                                </VBox>

                                <VBox spacing="16.0"
                                      style="-fx-background-color: white; -fx-background-radius: 26; -fx-border-color: rgba(17, 76, 70, 0.09); -fx-border-radius: 26; -fx-effect: dropshadow(gaussian, rgba(9, 44, 42, 0.10), 18, 0.16, 0, 8);">
                                    <padding>
                                        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                                    </padding>
                                    <children>
                                        <VBox spacing="6.0">
                                            <children>
                                                <Label text="Payment method"
                                                       style="-fx-text-fill: #0E3040; -fx-font-size: 24px; -fx-font-weight: 900;"/>
                                                <Label text="Choose the payment flow that fits your checkout preferences."
                                                       wrapText="true"
                                                       style="-fx-text-fill: #6B7D88; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                                            </children>
                                        </VBox>

                                        <HBox fx:id="visaOption">
                                            <children>
                                                <RadioButton fx:id="visaRadio"
                                                             selected="true"
                                                             toggleGroup="$paymentMethodGroup"
                                                             onAction="#updatePaymentStyles"
                                                             style="-fx-mark-color: #118465;"/>
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="Visa"
                                                               style="-fx-text-fill: #0D3040; -fx-font-size: 18px; -fx-font-weight: 800;"/>
                                                        <Label text="Fastest card checkout for standard orders."
                                                               style="-fx-text-fill: #6E808B; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                                                    </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label text="Recommended"
                                                       style="-fx-background-color: #DFF3EB; -fx-background-radius: 999; -fx-text-fill: #0F6A58; -fx-font-size: 11px; -fx-font-weight: 900; -fx-padding: 8 12 8 12;"/>
                                            </children>
                                        </HBox>

                                        <HBox fx:id="mastercardOption">
                                            <children>
                                                <RadioButton fx:id="mastercardRadio"
                                                             toggleGroup="$paymentMethodGroup"
                                                             onAction="#updatePaymentStyles"
                                                             style="-fx-mark-color: #118465;"/>
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="Mastercard"
                                                               style="-fx-text-fill: #0D3040; -fx-font-size: 18px; -fx-font-weight: 800;"/>
                                                        <Label text="International card support with the same secure flow."
                                                               style="-fx-text-fill: #6E808B; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <HBox fx:id="paypalOption">
                                            <children>
                                                <RadioButton fx:id="paypalRadio"
                                                             toggleGroup="$paymentMethodGroup"
                                                             onAction="#updatePaymentStyles"
                                                             style="-fx-mark-color: #118465;"/>
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="PayPal"
                                                               style="-fx-text-fill: #0D3040; -fx-font-size: 18px; -fx-font-weight: 800;"/>
                                                        <Label text="Pay through your wallet with express confirmation."
                                                               style="-fx-text-fill: #6E808B; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <HBox fx:id="cashOnDeliveryOption">
                                            <children>
                                                <RadioButton fx:id="cashOnDeliveryRadio"
                                                             toggleGroup="$paymentMethodGroup"
                                                             onAction="#updatePaymentStyles"
                                                             style="-fx-mark-color: #118465;"/>
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="Cash on Delivery"
                                                               style="-fx-text-fill: #0D3040; -fx-font-size: 18px; -fx-font-weight: 800;"/>
                                                        <Label text="Confirm the order now and pay when it arrives."
                                                               style="-fx-text-fill: #6E808B; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <HBox spacing="12.0">
                                            <children>
                                                <TextField fx:id="discountCodeField"
                                                           promptText="Discount code"
                                                           prefHeight="46.0"
                                                           HBox.hgrow="ALWAYS"
                                                           style="-fx-background-color: #FBFDFE; -fx-background-radius: 14; -fx-border-color: #D6E2EA; -fx-border-radius: 14; -fx-font-size: 14px; -fx-prompt-text-fill: #8A9CA7;"/>
                                                <Button text="Apply"
                                                        onAction="#applyDiscountCode"
                                                        prefWidth="110.0"
                                                        prefHeight="46.0"
                                                        style="-fx-background-color: #123C47; -fx-background-radius: 14; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 800;"/>
                                            </children>
                                        </HBox>

                                        <Label fx:id="checkoutStatusLabel"
                                               wrapText="true"
                                               style="-fx-text-fill: #255D71; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox prefWidth="340.0"
                              maxWidth="340.0"
                              spacing="16.0"
                              style="-fx-background-color: white; -fx-background-radius: 26; -fx-border-color: rgba(17, 76, 70, 0.09); -fx-border-radius: 26; -fx-effect: dropshadow(gaussian, rgba(9, 44, 42, 0.10), 18, 0.16, 0, 8);">
                            <padding>
                                <Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/>
                            </padding>
                            <children>
                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="ORDER SUMMARY"
                                               style="-fx-text-fill: #0B2E3E; -fx-font-size: 26px; -fx-font-weight: 900;"/>
                                        <Label fx:id="orderSummaryHintLabel"
                                               text="One quick review before the payment step."
                                               wrapText="true"
                                               style="-fx-text-fill: #6D808C; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                                    </children>
                                </VBox>

                                <VBox fx:id="orderItemsContainer" spacing="12.0"/>

                                <Region prefHeight="1.0"
                                        style="-fx-background-color: #E1EBF1;"/>

                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Subtotal"
                                               style="-fx-text-fill: #345061; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="subtotalLabel"
                                               text="0.00 DT"
                                               style="-fx-text-fill: #123748; -fx-font-size: 15px; -fx-font-weight: 800;"/>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Shipping"
                                               style="-fx-text-fill: #345061; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="shippingLabel"
                                               text="0.00 DT"
                                               style="-fx-text-fill: #123748; -fx-font-size: 15px; -fx-font-weight: 800;"/>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Discount"
                                               style="-fx-text-fill: #345061; -fx-font-size: 15px; -fx-font-weight: 600;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="discountLabel"
                                               text="0.00 DT"
                                               style="-fx-text-fill: #123748; -fx-font-size: 15px; -fx-font-weight: 800;"/>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT"
                                      style="-fx-background-color: linear-gradient(to right, #123C47, #1B705A); -fx-background-radius: 18;">
                                    <padding>
                                        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                                    </padding>
                                    <children>
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label text="TOTAL"
                                                       style="-fx-text-fill: rgba(255,255,255,0.78); -fx-font-size: 12px; -fx-font-weight: 900; -fx-letter-spacing: 1px;"/>
                                                <Label fx:id="totalLabel"
                                                       text="0.00 DT"
                                                       style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: 900;"/>
                                            </children>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Includes delivery"
                                               style="-fx-text-fill: rgba(255,255,255,0.82); -fx-font-size: 12px; -fx-font-weight: 700;"/>
                                    </children>
                                </HBox>

                                <Button fx:id="placeOrderButton"
                                        text="PLACE ORDER"
                                        onAction="#placeOrder"
                                        prefHeight="48.0"
                                        maxWidth="1.7976931348623157E308"
                                        style="-fx-background-color: linear-gradient(to right, #0E5D4E, #13846A); -fx-background-radius: 16; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 900;"/>

                                <Label text="Use FIT10 or WELCOME5 for a discount before confirming the order."
                                       wrapText="true"
                                       style="-fx-text-fill: #8395A0; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                            </children>
                        </VBox>
                    </children>
                </FlowPane>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button text="Return"
                                onAction="#goBackOrExit"
                                prefWidth="130.0"
                                prefHeight="46.0"
                                style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #CBD8E0; -fx-border-radius: 14; -fx-text-fill: #163848; -fx-font-size: 14px; -fx-font-weight: 800;"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
