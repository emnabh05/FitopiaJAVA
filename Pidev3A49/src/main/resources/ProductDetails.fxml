<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Pidev3A49.controllers.ProductDetailsController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            stylesheets="@styles/admin-theme.css"
            style="-fx-background: #E9FBF3; -fx-background-color: #E9FBF3;">
    <content>
        <VBox spacing="22.0"
              style="-fx-background-color: linear-gradient(to bottom right, #F7FFFB, #E6FBF3);">
            <padding>
                <Insets top="30.0" right="30.0" bottom="34.0" left="30.0"/>
            </padding>
            <children>
                <VBox styleClass="navbar-container">
                    <HBox alignment="CENTER_LEFT" styleClass="top-navbar-strip">
                        <Label text="Phone no: +216 58 938 889 or email us: customerservice@fitopia.com" styleClass="top-navbar-text" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="10">
                            <Label text="FB" styleClass="social-icon" />
                            <Label text="X" styleClass="social-icon" />
                            <Label text="IG" styleClass="social-icon" />
                        </HBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="navbar-shell">
                        <VBox alignment="CENTER" spacing="0">
                            <Label text="&#127811;" styleClass="navbar-logo-icon" />
                            <Label text="FITOPIA" styleClass="navbar-logo-text" />
                        </VBox>

                        <Region prefWidth="20" />

                        <Label text="Home" styleClass="navbar-link navbar-link-active" />
                        <Label text="About&#10;Fitopia" textAlignment="CENTER" styleClass="navbar-link" />

                        <Region prefWidth="10" />

                        <Button onAction="#goBack" text="EXPLORE&#10;SUPPLEMENTS" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                        <Button onAction="#goBack" text="MY&#10;PROGRESS" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                        <Button onAction="#goBack" text="MONTHLY&#10;RANKING" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                        <Button onAction="#openCheckout" text="CHECKOUT" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                        <Button onAction="#openMyOrders" text="MY&#10;ORDERS" textAlignment="CENTER" styleClass="navbar-btn-blue" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button onAction="#openMyOrders" text="MY&#10;PROFILE" textAlignment="CENTER" styleClass="navbar-btn-green" />
                        <Button onAction="#goBack" text="LOGOUT" textAlignment="CENTER" styleClass="navbar-btn-red" />
                    </HBox>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button text="Back to Store"
                                onAction="#goBack"
                                prefHeight="42.0"
                                style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #CFE1DA; -fx-border-radius: 14; -fx-text-fill: #163848; -fx-font-size: 14px; -fx-font-weight: 800; -fx-padding: 0 16 0 16;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Go to Checkout"
                                onAction="#openCheckout"
                                prefHeight="42.0"
                                style="-fx-background-color: linear-gradient(to right, #0D3141, #1B7A61); -fx-background-radius: 14; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 800; -fx-padding: 0 16 0 16;"/>
                        <Button text="🔔"
                                onAction="#openMyOrders"
                                prefHeight="42.0"
                                prefWidth="46.0"
                                style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #CFE1DA; -fx-border-radius: 14; -fx-text-fill: #0F6A58; -fx-font-size: 18px; -fx-font-weight: 900;"/>
                    </children>
                </HBox>

                <VBox spacing="18.0"
                      style="-fx-background-color: white; -fx-background-radius: 26; -fx-border-color: rgba(11, 84, 76, 0.10); -fx-border-radius: 26; -fx-effect: dropshadow(gaussian, rgba(7, 35, 29, 0.10), 22, 0.22, 0, 8);">
                    <padding>
                        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                    </padding>
                    <children>
                        <Label text="PRODUCT DETAILS"
                               style="-fx-text-fill: #4E877A; -fx-font-size: 13px; -fx-font-weight: 900; -fx-letter-spacing: 1px;"/>
                        <Label fx:id="productNameLabel"
                               text="-"
                               wrapText="true"
                               style="-fx-text-fill: #123748; -fx-font-size: 42px; -fx-font-weight: 900;"/>

                        <HBox spacing="24.0">
                            <children>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Brand:"
                                                       style="-fx-text-fill: #6B8190; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                                <Label fx:id="brandValueLabel"
                                                       text="-"
                                                       style="-fx-text-fill: #183948; -fx-font-size: 15px; -fx-font-weight: 800;"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Category:"
                                                       style="-fx-text-fill: #6B8190; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                                <Label fx:id="categoryValueLabel"
                                                       text="-"
                                                       style="-fx-text-fill: #183948; -fx-font-size: 15px; -fx-font-weight: 800;"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Price:"
                                                       style="-fx-text-fill: #6B8190; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                                <Label fx:id="priceValueLabel"
                                                       text="-"
                                                       style="-fx-text-fill: #0F6A58; -fx-font-size: 20px; -fx-font-weight: 900;"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Calories:"
                                                       style="-fx-text-fill: #6B8190; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                                <Label fx:id="caloriesValueLabel"
                                                       text="-"
                                                       style="-fx-text-fill: #183948; -fx-font-size: 15px; -fx-font-weight: 800;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Stock:"
                                                       style="-fx-text-fill: #6B8190; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                                <Label fx:id="stockValueLabel"
                                                       text="-"
                                                       style="-fx-text-fill: #183948; -fx-font-size: 15px; -fx-font-weight: 800;"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Posted at:"
                                                       style="-fx-text-fill: #6B8190; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                                <Label fx:id="postedAtValueLabel"
                                                       text="-"
                                                       style="-fx-text-fill: #183948; -fx-font-size: 15px; -fx-font-weight: 800;"/>
                                            </children>
                                        </HBox>
                                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Updated at:"
                                                       style="-fx-text-fill: #6B8190; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                                <Label fx:id="updatedAtValueLabel"
                                                       text="-"
                                                       style="-fx-text-fill: #183948; -fx-font-size: 15px; -fx-font-weight: 800;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="8.0">
                            <children>
                                <Label text="Description"
                                       style="-fx-text-fill: #153D4E; -fx-font-size: 18px; -fx-font-weight: 900;"/>
                                <Label fx:id="descriptionValueLabel"
                                       text="-"
                                       wrapText="true"
                                       style="-fx-text-fill: #607887; -fx-font-size: 15px; -fx-font-weight: 600; -fx-line-spacing: 3px;"/>
                            </children>
                        </VBox>

                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <children>
                                <Button fx:id="addToCartButton"
                                        text="ADD TO CART"
                                        onAction="#addSelectedToCart"
                                        prefHeight="44.0"
                                        prefWidth="200.0"
                                        style="-fx-background-color: linear-gradient(to right, #124A4D, #0F6A58); -fx-background-radius: 14; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 900;"/>
                                <Label fx:id="statusLabel"
                                       text=""
                                       wrapText="true"
                                       style="-fx-text-fill: #0F6A58; -fx-font-size: 13px; -fx-font-weight: 700;"/>
                            </children>
                        </HBox>

                        <VBox spacing="12.0"
                              style="-fx-background-color: #F8FCFA; -fx-background-radius: 18; -fx-border-color: #DDEBE5; -fx-border-radius: 18; -fx-padding: 16 16 16 16;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label text="Ratings &amp; Comments"
                                               style="-fx-text-fill: #153D4E; -fx-font-size: 20px; -fx-font-weight: 900;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Average:"
                                               style="-fx-text-fill: #6B8190; -fx-font-size: 13px; -fx-font-weight: 700;"/>
                                        <Label fx:id="averageRatingValueLabel"
                                               text="-"
                                               style="-fx-text-fill: #0F6A58; -fx-font-size: 14px; -fx-font-weight: 900;"/>
                                        <Label fx:id="totalReviewsValueLabel"
                                               text="-"
                                               style="-fx-text-fill: #6B8190; -fx-font-size: 13px; -fx-font-weight: 700;"/>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Button fx:id="star1Button"
                                                text="&#9734;"
                                                userData="1"
                                                onAction="#selectRating"/>
                                        <Button fx:id="star2Button"
                                                text="&#9734;"
                                                userData="2"
                                                onAction="#selectRating"/>
                                        <Button fx:id="star3Button"
                                                text="&#9734;"
                                                userData="3"
                                                onAction="#selectRating"/>
                                        <Button fx:id="star4Button"
                                                text="&#9734;"
                                                userData="4"
                                                onAction="#selectRating"/>
                                        <Button fx:id="star5Button"
                                                text="&#9734;"
                                                userData="5"
                                                onAction="#selectRating"/>
                                        <Label fx:id="selectedRatingLabel"
                                               text="Choose a rating (1-5 stars)."
                                               style="-fx-text-fill: #607887; -fx-font-size: 13px; -fx-font-weight: 700;"/>
                                    </children>
                                </HBox>

                                <TextArea fx:id="reviewCommentTextArea"
                                          promptText="Write your comment about this product..."
                                          wrapText="true"
                                          prefRowCount="4"
                                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #D5E4DE; -fx-border-radius: 12; -fx-text-fill: #1E3F4D; -fx-font-size: 14px;"/>

                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Button fx:id="submitReviewButton"
                                                text="SUBMIT REVIEW"
                                                onAction="#submitReview"
                                                prefHeight="40.0"
                                                style="-fx-background-color: linear-gradient(to right, #124A4D, #0F6A58); -fx-background-radius: 12; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 900; -fx-padding: 0 16 0 16;"/>
                                        <Label fx:id="reviewStatusLabel"
                                               text=""
                                               wrapText="true"
                                               style="-fx-text-fill: #0F6A58; -fx-font-size: 13px; -fx-font-weight: 700;"/>
                                    </children>
                                </HBox>

                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="Recent comments"
                                               style="-fx-text-fill: #153D4E; -fx-font-size: 15px; -fx-font-weight: 900;"/>
                                        <VBox fx:id="reviewsContainer" spacing="8.0"/>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
