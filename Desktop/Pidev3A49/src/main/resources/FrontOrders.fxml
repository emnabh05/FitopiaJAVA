<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Pidev3A49.controllers.FrontOrdersController"
            prefWidth="1400.0"
            prefHeight="900.0"
            style="-fx-background-color: linear-gradient(to bottom right, #F7FFFB, #E5FBF3);">

    <top>
        <HBox spacing="12.0" alignment="CENTER_LEFT"
              style="-fx-background-color: linear-gradient(to right, #0D3141, #1B7A61); -fx-background-radius: 0 0 20 20;">
            <padding>
                <Insets top="16.0" right="20.0" bottom="16.0" left="20.0"/>
            </padding>
            <children>
                <StackPane prefWidth="40.0" prefHeight="40.0"
                           style="-fx-background-color: rgba(255,255,255,0.14); -fx-background-radius: 12;">
                    <children>
                        <Label text="ORD" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: 900;"/>
                    </children>
                </StackPane>
                <Label text="My Orders"
                       style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: 900;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Store" onAction="#openStore"
                        style="-fx-background-color: rgba(255,255,255,0.14); -fx-background-radius: 14; -fx-border-color: rgba(255,255,255,0.26); -fx-border-radius: 14; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700;"/>
                <Button text="Checkout" onAction="#openCheckout"
                        style="-fx-background-color: rgba(255,255,255,0.14); -fx-background-radius: 14; -fx-border-color: rgba(255,255,255,0.26); -fx-border-radius: 14; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700;"/>

                <StackPane prefWidth="52.0" prefHeight="46.0">
                    <children>
                        <Button text="🔔"
                                fx:id="notificationBellButton"
                                onAction="#toggleNotificationsMenu"
                                prefWidth="46.0"
                                prefHeight="46.0"
                                style="-fx-background-color: rgba(255,255,255,0.14); -fx-background-radius: 14; -fx-border-color: rgba(255,255,255,0.26); -fx-border-radius: 14; -fx-text-fill: white; -fx-font-size: 19px; -fx-font-weight: 900;"/>

                        <Label fx:id="notificationBadgeLabel"
                               visible="false"
                               managed="false"
                               StackPane.alignment="TOP_RIGHT"
                               style="-fx-background-color: #FF4D4F; -fx-background-radius: 999; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: 900; -fx-padding: 2 6 2 6;"/>
                    </children>
                </StackPane>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
            </padding>
            <children>
                <HBox spacing="12.0" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 16 16 16 16;">
                    <children>
                        <TextField fx:id="emailSearchField" promptText="Enter your email..."
                                   HBox.hgrow="ALWAYS" prefHeight="42.0"
                                   style="-fx-background-color: #FBFDFE; -fx-background-radius: 12; -fx-border-color: #D6E2EA; -fx-border-radius: 12; -fx-font-size: 14px;"/>
                        <Button text="Check Orders" onAction="#searchOrders" prefHeight="42.0"
                                style="-fx-background-color: linear-gradient(to right, #124A4D, #0F6A58); -fx-background-radius: 12; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 800;"/>
                    </children>
                </HBox>

                <Label fx:id="statusLabel"
                       style="-fx-text-fill: #255D71; -fx-font-size: 14px; -fx-font-weight: 700;"/>

                <ScrollPane fitToWidth="true"
                            prefHeight="620.0"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <content>
                        <VBox fx:id="ordersCardsContainer" spacing="12.0"
                              style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #E1EBF1; -fx-border-radius: 18; -fx-padding: 14 14 14 14;"/>
                    </content>
                </ScrollPane>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button text="Return" onAction="#goBackOrExit"
                                prefWidth="130.0" prefHeight="44.0"
                                style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #CBD8E0; -fx-border-radius: 14; -fx-text-fill: #163848; -fx-font-size: 14px; -fx-font-weight: 800;"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
