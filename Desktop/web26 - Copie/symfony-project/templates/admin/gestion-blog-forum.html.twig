{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion forum et blog | Fitopia{% endblock %}

{% block stylesheets %}
<style>
  .agenda-hero {
    background: linear-gradient(135deg, #0b3a3d 0%, #0d5b50 55%, #0f7a5f 100%);
    color: #fff;
    border-radius: 16px;
    padding: 2rem 2.5rem;
    box-shadow: 0 18px 50px rgba(14, 30, 37, 0.18);
    position: relative;
    overflow: hidden;
  }
  .agenda-hero::after {
    content: "";
    position: absolute;
    right: -60px;
    top: -60px;
    width: 180px;
    height: 180px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
  }
  .agenda-hero h2 {
    font-weight: 800;
    margin: 0 0 0.4rem;
  }
  .agenda-hero p {
    margin: 0;
    opacity: 0.9;
  }
  .option-grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .option-card {
    background: #fff;
    border-radius: 14px;
    padding: 1.5rem;
    box-shadow: 0 12px 30px rgba(14, 30, 37, 0.08);
    border: 1px solid #eef2f6;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }
  .option-card.selected {
    border-color: #0f7a5f;
    box-shadow: 0 0 0 3px rgba(15, 122, 95, 0.15);
  }
  .panel {
    margin-top: 2rem;
    background: #fff;
    border-radius: 16px;
    padding: 1.75rem;
    border: 1px solid #eef2f6;
    box-shadow: 0 12px 30px rgba(14, 30, 37, 0.08);
    display: none;
    transform: translateY(12px);
    opacity: 0;
    transition: all 0.25s ease;
  }
  .panel.active {
    display: block;
    transform: translateY(0);
    opacity: 1;
  }
  .panel h3 {
    margin-top: 0;
    font-weight: 800;
  }
  .panel .muted { color: #6b7280; }
  .cta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .cta-card {
    border: 1px dashed #cbd5e1;
    border-radius: 14px;
    padding: 1.25rem;
    background: #f8fafc;
  }
  .form-wrap {
    background: #ffffff;
    border-radius: 14px;
    border: 1px solid #eef2f6;
    padding: 1.5rem;
  }
  .icon-input {
    position: relative;
  }
  .icon-input i {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #0f7a5f;
  }
  .icon-input input,
  .icon-input textarea,
  .icon-input select {
    padding-left: 38px;
  }
  .form-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, #0b3a3d 0%, #0d5b50 55%, #0f7a5f 100%);
    color: #fff;
    border-radius: 14px;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
  }
  .form-hero strong { font-weight: 700; }
  .form-label {
    font-weight: 600;
    color: #0f172a;
  }
  .form-control {
    border-radius: 12px;
  }
  .success-toast {
    background: #e6fffa;
    color: #0b3a3d;
    border: 1px solid #b7f3ea;
    border-radius: 12px;
    padding: 0.85rem 1rem;
    margin-bottom: 1rem;
    animation: popIn 0.5s ease;
  }
  @keyframes popIn {
    from { transform: translateY(-8px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  .list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1rem;
    border: 1px solid #eef2f6;
    border-radius: 12px;
    margin-bottom: 0.75rem;
  }
  .badge {
    background: #0b3a3d;
    color: #fff;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .action-btn {
    background: #0b3a3d;
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 0.45rem 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .feed-card {
    border: 1px solid #eef2f6;
    border-radius: 14px;
    padding: 1rem 1.25rem;
    margin-bottom: 0.8rem;
  }
  .feed-image {
    width: 100%;
    border-radius: 12px;
    margin: 0.75rem 0;
    max-height: 260px;
    object-fit: cover;
  }
  .role-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #0b3a3d;
    color: #fff;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .option-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(14, 30, 37, 0.15);
  }
  .option-card h4 {
    margin-top: 0;
    font-weight: 700;
  }
  .option-card p {
    color: #6b7280;
  }
  .option-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #e6f0ee;
    color: #0b3a3d;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }
  @media (max-width: 991px) {
    .option-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
{% endblock %}

{% block body %}
  <div class="agenda-hero">
    <h2>Hello Mr Forum & Blog Manager</h2>
    <p>Be creative — what is your agenda for today?</p>
  </div>

  <div class="option-grid">
    <div class="option-card" data-action="create">
      <div class="option-icon"><i class="fa fa-plus"></i></div>
      <h4>Create a forum or a blog</h4>
      <p>Start something new and set the tone for your community.</p>
    </div>
    <div class="option-card" data-action="update">
      <div class="option-icon"><i class="fa fa-refresh"></i></div>
      <h4>Update an existing forum or blog</h4>
      <p>Keep your content fresh and relevant.</p>
    </div>
    <div class="option-card" data-action="delete">
      <div class="option-icon"><i class="fa fa-trash"></i></div>
      <h4>Delete an existing forum or blog</h4>
      <p>Remove outdated or unwanted content.</p>
    </div>
    <div class="option-card" data-action="explore">
      <div class="option-icon"><i class="fa fa-globe"></i></div>
      <h4>View live and explore Forum & Blog</h4>
      <p>See what’s live and how users are engaging.</p>
    </div>
  </div>

{% set items = items|default([]) %}

  <div id="panel-create" class="panel">
    <h3>Create a forum or a blog</h3>
    <p class="muted">Start something new for your community.</p>
    <div class="form-wrap">
      {% for message in app.flashes('success') %}
        <div class="success-toast">{{ message }}</div>
      {% endfor %}
      <div class="form-hero">
        <div>You're posting as <strong>{{ app.user ? app.user.userIdentifier : 'Admin' }}</strong></div>
        <div><i class="fa fa-feather"></i></div>
      </div>
      {{ form_start(blogForm) }}
        <div class="mb-3">
          {{ form_label(blogForm.title) }}
          <div class="icon-input">
            <i class="fa fa-heading"></i>
            {{ form_widget(blogForm.title, {'attr': {'class': 'form-control'}}) }}
          </div>
          {{ form_errors(blogForm.title) }}
        </div>
        <div class="mb-3">
          {{ form_label(blogForm.content) }}
          <div class="icon-input">
            <i class="fa fa-align-left"></i>
            {{ form_widget(blogForm.content, {'attr': {'class': 'form-control'}}) }}
          </div>
          {{ form_errors(blogForm.content) }}
        </div>
        <div class="mb-3">
          {{ form_label(blogForm.excerpt) }}
          <div class="icon-input">
            <i class="fa fa-quote-left"></i>
            {{ form_widget(blogForm.excerpt, {'attr': {'class': 'form-control'}}) }}
          </div>
          {{ form_errors(blogForm.excerpt) }}
        </div>
        <div class="mb-3">
          {{ form_label(blogForm.category) }}
          <div class="icon-input">
            <i class="fa fa-tags"></i>
            {{ form_widget(blogForm.category, {'attr': {'class': 'form-control'}}) }}
          </div>
          {{ form_errors(blogForm.category) }}
        </div>
        <div class="mb-3">
          {{ form_label(blogForm.featuredImageFile, 'Featured image') }}
          <div class="icon-input">
            <i class="fa fa-image"></i>
            {{ form_widget(blogForm.featuredImageFile, {'attr': {'class': 'form-control'}}) }}
          </div>
          {{ form_errors(blogForm.featuredImageFile) }}
        </div>
        <button class="action-btn" type="submit">Publish</button>
      {{ form_end(blogForm) }}
    </div>
  </div>

  <div id="panel-update" class="panel">
    <h3>Update an existing forum or blog</h3>
    {% if items is empty %}
      <p class="muted">No forum or blog available yet.</p>
    {% else %}
      {% for item in items %}
        <div class="list-item">
          <div>
            <strong>{{ item.title }}</strong><br>
            <small class="muted">{{ item.date }} · {{ item.email }}</small>
            <span class="role-badge"><i class="fa fa-id-badge"></i> {{ item.role }}</span>
          </div>
          <button class="action-btn js-edit-toggle" type="button" data-post-id="{{ item.id }}">Update</button>
        </div>
        <div class="form-wrap" id="edit-form-{{ item.id }}" style="display:none;margin-bottom:1rem;">
          {{ form_start(editForms[item.id]) }}
            <div class="mb-3">
              {{ form_label(editForms[item.id].title) }}
              <div class="icon-input">
                <i class="fa fa-heading"></i>
                {{ form_widget(editForms[item.id].title, {'attr': {'class': 'form-control'}}) }}
              </div>
            </div>
            <div class="mb-3">
              {{ form_label(editForms[item.id].content) }}
              <div class="icon-input">
                <i class="fa fa-align-left"></i>
                {{ form_widget(editForms[item.id].content, {'attr': {'class': 'form-control'}}) }}
              </div>
            </div>
            <div class="mb-3">
              {{ form_label(editForms[item.id].excerpt) }}
              <div class="icon-input">
                <i class="fa fa-quote-left"></i>
                {{ form_widget(editForms[item.id].excerpt, {'attr': {'class': 'form-control'}}) }}
              </div>
            </div>
            <div class="mb-3">
              {{ form_label(editForms[item.id].category) }}
              <div class="icon-input">
                <i class="fa fa-tags"></i>
                {{ form_widget(editForms[item.id].category, {'attr': {'class': 'form-control'}}) }}
              </div>
            </div>
            <div class="mb-3">
              {{ form_label(editForms[item.id].featuredImageFile, 'Featured image') }}
              <div class="icon-input">
                <i class="fa fa-image"></i>
                {{ form_widget(editForms[item.id].featuredImageFile, {'attr': {'class': 'form-control'}}) }}
              </div>
            </div>
            <button class="action-btn" type="submit">Save changes</button>
          {{ form_end(editForms[item.id]) }}
        </div>
      {% endfor %}
    {% endif %}
  </div>

  <div id="panel-delete" class="panel">
    <h3>Delete an existing forum or blog</h3>
    {% if items is empty %}
      <p class="muted">No forum or blog available to delete.</p>
    {% else %}
      {% for item in items %}
        <div class="list-item">
          <div>
            <strong>{{ item.title }}</strong><br>
            <small class="muted">{{ item.date }} · {{ item.email }}</small>
            <span class="role-badge"><i class="fa fa-id-badge"></i> {{ item.role }}</span>
          </div>
          <form method="post" action="{{ path('admin_blog_forum_delete', {'id': item.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_blog_post_' ~ item.id) }}">
            <button class="action-btn" type="submit">Delete</button>
          </form>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  <div id="panel-explore" class="panel">
    <h3>View live and explore Forum & Blog</h3>
    {% if items is empty %}
      <p class="muted">No forum or blog available to explore.</p>
    {% else %}
      {% for item in items %}
        <div class="feed-card">
          <strong>{{ item.title }}</strong>
          <div class="muted" style="margin-top:0.25rem;">
            Published by {{ item.email }} · <span class="role-badge"><i class="fa fa-id-badge"></i> {{ item.role }}</span>
          </div>
          {% if item.image %}
            <img src="{{ asset('uploads/blog/' ~ item.image) }}" alt="Featured image" class="feed-image">
          {% endif %}
          <p class="muted">{{ item.excerpt }}</p>
          <small class="muted">{{ item.date }}</small>
        </div>
      {% endfor %}
    {% endif %}
  </div>
{% endblock %}

{% block javascripts %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.option-card');
    const panels = {
      create: document.getElementById('panel-create'),
      update: document.getElementById('panel-update'),
      delete: document.getElementById('panel-delete'),
      explore: document.getElementById('panel-explore'),
    };
    const editToggles = document.querySelectorAll('.js-edit-toggle');
    cards.forEach(card => {
      card.addEventListener('click', () => {
        cards.forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        Object.values(panels).forEach(p => p.classList.remove('active'));
        const key = card.getAttribute('data-action');
        if (panels[key]) {
          panels[key].classList.add('active');
        }
      });
    });
    editToggles.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-post-id');
        const form = document.getElementById('edit-form-' + id);
        if (!form) return;
        form.style.display = form.style.display === 'none' ? 'block' : 'none';
      });
    });
  });
</script>
{% endblock %}
