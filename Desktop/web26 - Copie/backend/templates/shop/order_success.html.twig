{% extends 'shop/base.html.twig' %}

{% block title %}Commande Confirmée - Fitopia Supplements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/cart.css') }}">
    <link rel="stylesheet" href="{{ asset('css/checkout.css') }}">
    <link rel="stylesheet" href="{{ asset('css/payment.css') }}">
{% endblock %}

{% block body %}
    <!-- Success Section -->
    <section class="success-section">
        <div class="container">
            <div class="success-content">
                <div class="success-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                
                <h1>Commande confirmée!</h1>
                <p class="success-message">Merci pour votre commande. Nous avons bien reçu votre demande.</p>
                
                <div class="order-number">
                    <span>Numéro de commande:</span>
                    <strong>{{ order.orderNumber }}</strong>
                </div>

                <div class="order-details-card">
                    <h3>Détails de la commande</h3>
                    
                    <div class="detail-row">
                        <span>Date de commande:</span>
                        <strong>{{ order.createdAt|date('d/m/Y à H:i') }}</strong>
                    </div>
                    
                    <div class="detail-row">
                        <span>Méthode de paiement:</span>
                        <strong>{{ order.paymentMethod }}</strong>
                    </div>
                    
                    <div class="detail-row">
                        <span>Statut:</span>
                        <strong>{{ order.status }}</strong>
                    </div>
                    
                    <div class="detail-row">
                        <span>Montant total:</span>
                        <strong class="total-amount">{{ order.total }} DT</strong>
                    </div>
                    
                    <div class="detail-row">
                        <span>Livraison estimée:</span>
                        <strong>{{ order.createdAt|date_modify('+3 days')|date('d/m/Y') }}</strong>
                    </div>
                </div>

                <div class="customer-info-card">
                    <h3>Informations de livraison</h3>
                    
                    <div class="info-row">
                        <i class="fas fa-user"></i>
                        <span>{{ order.firstName }} {{ order.lastName }}</span>
                    </div>
                    
                    <div class="info-row">
                        <i class="fas fa-envelope"></i>
                        <span>{{ order.email }}</span>
                    </div>
                    
                    <div class="info-row">
                        <i class="fas fa-phone"></i>
                        <span>{{ order.phone }}</span>
                    </div>
                    
                    <div class="info-row">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>{{ order.address }}, {{ order.city }} {{ order.postalCode }}</span>
                    </div>

                    {% if order.notes %}
                        <div class="info-row">
                            <i class="fas fa-sticky-note"></i>
                            <span>{{ order.notes }}</span>
                        </div>
                    {% endif %}
                </div>

                <div class="order-items-card">
                    <h3>Articles commandés</h3>
                    <div class="success-order-items">
                        {% for item in order.orderItems %}
                            <div class="success-order-item">
                                <div class="item-image">
                                    {% if item.supplement.image %}
                                        <img src="{{ asset('uploads/supplements/' ~ item.supplement.image) }}" alt="{{ item.supplement.name }}">
                                    {% else %}
                                        <img src="{{ asset('images/image_1.jpg') }}" alt="{{ item.supplement.name }}">
                                    {% endif %}
                                </div>
                                <div class="item-info">
                                    <h4>{{ item.supplement.name }}</h4>
                                    <p>{{ item.supplement.brand }} - {{ item.supplement.category }}</p>
                                    <p>Quantité: {{ item.quantity }}</p>
                                </div>
                                <div class="item-price">{{ item.total }} DT</div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="order-summary-totals">
                        <div class="summary-row">
                            <span>Sous-total:</span>
                            <span>{{ order.subtotal }} DT</span>
                        </div>
                        <div class="summary-row">
                            <span>Livraison:</span>
                            <span>{{ order.shipping > 0 ? order.shipping ~ ' DT' : 'GRATUIT' }}</span>
                        </div>
                        {% if order.discount > 0 %}
                            <div class="summary-row">
                                <span>Réduction ({{ order.discountCode }}):</span>
                                <span class="discount-amount">-{{ order.discount }} DT</span>
                            </div>
                        {% endif %}
                        <div class="summary-row total-row">
                            <span>Total:</span>
                            <span class="total-amount">{{ order.total }} DT</span>
                        </div>
                    </div>
                </div>

                <div class="success-actions">
                    <button onclick="window.print()" class="btn-print">
                        <i class="fas fa-print"></i> Imprimer le reçu
                    </button>
                    <a href="{{ path('app_shop_index') }}" class="btn-continue">
                        <i class="fas fa-shopping-bag"></i> Continuer vos achats
                    </a>
                </div>

                <div class="success-info">
                    <p><i class="fas fa-info-circle"></i> Un email de confirmation a été envoyé à <strong>{{ order.email }}</strong></p>
                    <p><i class="fas fa-truck"></i> Vous recevrez un email de suivi dès que votre commande sera expédiée</p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Confetti animation on success (optional)
        console.log('Order {{ order.orderNumber }} confirmed successfully!');
    </script>
{% endblock %}

