# Symfony Application Environment
APP_ENV=dev
APP_SECRET=your_secret_key_here_change_in_production

###> doctrine/doctrine-bundle ###
# MySQL 8.0 Configuration
# DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/fitopia_supplements?serverVersion=8.0.32&charset=utf8mb4"

# MariaDB 10.11 Configuration (Alternative)
DATABASE_URL="mysql://root:@127.0.0.1:3306/fitopia_supplements?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

# File Upload Directory
SUPPLEMENTS_UPLOAD_DIR='%kernel.project_dir%/public/uploads/supplements'


###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
