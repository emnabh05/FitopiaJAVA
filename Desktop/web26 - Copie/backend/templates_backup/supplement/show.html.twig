{% extends 'base.html.twig' %}

{% block title %}{{ supplement.name }} - Fitopia Admin{% endblock %}
{% block page_title %}Supplement Details{% endblock %}
{% block breadcrumb %}View Supplement{% endblock %}

{% block body %}
<div class="flex flex-wrap -mx-3">
    <div class="flex-none w-full max-w-full px-3">
        <div class="relative flex flex-col min-w-0 mb-6 break-words bg-white border-0 border-transparent border-solid shadow-xl dark:bg-slate-850 dark:shadow-dark-xl rounded-2xl bg-clip-border">
            <div class="p-6 pb-0 mb-0 border-b-0 border-b-solid rounded-t-2xl border-b-transparent">
                <div class="flex justify-between items-center">
                    <h6 class="dark:text-white">{{ supplement.name }}</h6>
                    <div class="flex gap-2">
                        <a href="{{ path('app_supplement_edit', {'id': supplement.id}) }}" class="inline-block px-6 py-3 font-bold text-center text-white uppercase align-middle transition-all bg-vert-sapin rounded-lg cursor-pointer leading-normal text-xs ease-in tracking-tight-rem shadow-md bg-150 bg-x-25 hover:-translate-y-px active:opacity-85 hover:shadow-md">
                            <i class="fas fa-edit mr-2"></i>Edit
                        </a>
                        <a href="{{ path('app_supplement_index') }}" class="inline-block px-6 py-3 font-bold text-center text-slate-700 uppercase align-middle transition-all bg-transparent border border-slate-700 rounded-lg cursor-pointer leading-normal text-xs ease-in tracking-tight-rem hover:bg-slate-700 hover:text-white">
                            <i class="fas fa-arrow-left mr-2"></i>Back to List
                        </a>
                    </div>
                </div>
            </div>
            <div class="flex-auto p-6">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Product Image -->
                    <div class="md:col-span-1">
                        {% if supplement.image %}
                            <img src="{{ asset('uploads/supplements/' ~ supplement.image) }}" alt="{{ supplement.name }}" class="w-full rounded-lg shadow-lg object-cover">
                        {% else %}
                            <div class="w-full h-64 bg-gradient-blue-marine rounded-lg shadow-lg flex items-center justify-center">
                                <i class="fas fa-capsules text-white text-6xl"></i>
                            </div>
                        {% endif %}
                        
                        <!-- Stock Status Badge -->
                        <div class="mt-4 text-center">
                            {% if supplement.stock > 10 %}
                                <span class="bg-gradient-to-tl from-emerald-500 to-teal-400 px-4 py-2 text-sm rounded-lg inline-block whitespace-nowrap text-center align-baseline font-bold uppercase leading-none text-white">
                                    In Stock: {{ supplement.stock }} units
                                </span>
                            {% elseif supplement.stock > 0 %}
                                <span class="bg-gradient-to-tl from-orange-500 to-yellow-500 px-4 py-2 text-sm rounded-lg inline-block whitespace-nowrap text-center align-baseline font-bold uppercase leading-none text-white">
                                    Low Stock: {{ supplement.stock }} units
                                </span>
                            {% else %}
                                <span class="bg-gradient-to-tl from-slate-600 to-slate-300 px-4 py-2 text-sm rounded-lg inline-block whitespace-nowrap text-center align-baseline font-bold uppercase leading-none text-white">
                                    Out of Stock
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Product Details -->
                    <div class="md:col-span-2">
                        <div class="space-y-6">
                            <!-- Basic Info -->
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <h6 class="text-xs font-bold uppercase text-slate-400 mb-2">Category</h6>
                                    <p class="text-lg font-semibold text-slate-700 dark:text-white">{{ supplement.category }}</p>
                                </div>
                                <div>
                                    <h6 class="text-xs font-bold uppercase text-slate-400 mb-2">Brand</h6>
                                    <p class="text-lg font-semibold text-slate-700 dark:text-white">{{ supplement.brand }}</p>
                                </div>
                            </div>

                            <!-- Price and Calories -->
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <h6 class="text-xs font-bold uppercase text-slate-400 mb-2">Price</h6>
                                    <p class="text-2xl font-bold text-vert-sapin dark:text-white">${{ supplement.price }}</p>
                                </div>
                                {% if supplement.calories %}
                                <div>
                                    <h6 class="text-xs font-bold uppercase text-slate-400 mb-2">Calories</h6>
                                    <p class="text-2xl font-bold text-blue-marine dark:text-white">{{ supplement.calories }} cal</p>
                                </div>
                                {% endif %}
                            </div>

                            <!-- Description -->
                            <div>
                                <h6 class="text-xs font-bold uppercase text-slate-400 mb-2">Description</h6>
                                <p class="text-sm text-slate-600 dark:text-white leading-relaxed">{{ supplement.description }}</p>
                            </div>

                            <!-- Metadata -->
                            <div class="border-t pt-4">
                                <div class="grid grid-cols-2 gap-4 text-xs text-slate-400">
                                    <div>
                                        <i class="fas fa-calendar-plus mr-2"></i>
                                        <strong>Created:</strong> {{ supplement.createdAt|date('M d, Y H:i') }}
                                    </div>
                                    <div>
                                        <i class="fas fa-calendar-check mr-2"></i>
                                        <strong>Updated:</strong> {{ supplement.updatedAt|date('M d, Y H:i') }}
                                    </div>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="border-t pt-4">
                                <form method="post" action="{{ path('app_supplement_delete', {'id': supplement.id}) }}" onsubmit="return confirm('Are you sure you want to delete this supplement? This action cannot be undone.');" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ supplement.id) }}">
                                    <button type="submit" class="inline-block px-6 py-3 font-bold text-center text-white uppercase align-middle transition-all bg-gradient-to-tl from-red-600 to-orange-600 rounded-lg cursor-pointer leading-normal text-xs ease-in tracking-tight-rem shadow-md bg-150 bg-x-25 hover:-translate-y-px active:opacity-85 hover:shadow-md">
                                        <i class="fas fa-trash mr-2"></i>Delete Supplement
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

