{% extends 'base.html.twig' %}

{% block title %}New Supplement - Fitopia Admin{% endblock %}
{% block page_title %}Add New Supplement{% endblock %}
{% block breadcrumb %}New Supplement{% endblock %}

{% block body %}
<div class="flex flex-wrap -mx-3">
    <div class="flex-none w-full max-w-full px-3">
        <div class="relative flex flex-col min-w-0 mb-6 break-words bg-white border-0 border-transparent border-solid shadow-xl dark:bg-slate-850 dark:shadow-dark-xl rounded-2xl bg-clip-border">
            <div class="p-6 pb-0 mb-0 border-b-0 border-b-solid rounded-t-2xl border-b-transparent">
                <div class="flex justify-between items-center">
                    <h6 class="dark:text-white">Supplement Information</h6>
                    <a href="{{ path('app_supplement_index') }}" class="inline-block px-6 py-3 font-bold text-center text-slate-700 uppercase align-middle transition-all bg-transparent border border-slate-700 rounded-lg cursor-pointer leading-normal text-xs ease-in tracking-tight-rem hover:bg-slate-700 hover:text-white">
                        <i class="fas fa-arrow-left mr-2"></i>Back to List
                    </a>
                </div>
            </div>
            <div class="flex-auto p-6">
                {{ form_start(form, {'attr': {'id': 'supplementForm', 'novalidate': 'novalidate'}}) }}
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Name -->
                    <div>
                        <label for="supplement_name" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                            Product Name <span class="text-red-500">*</span>
                        </label>
                        {{ form_widget(form.name, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white', 'id': 'supplement_name'}}) }}
                        <div class="error-message" id="name-error"></div>
                    </div>

                    <!-- Category -->
                    <div>
                        <label for="supplement_category" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                            Category <span class="text-red-500">*</span>
                        </label>
                        {{ form_widget(form.category, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white', 'id': 'supplement_category', 'placeholder': 'e.g., Protein, Creatine, Vitamins'}}) }}
                        <div class="error-message" id="category-error"></div>
                    </div>

                    <!-- Brand -->
                    <div>
                        <label for="supplement_brand" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                            Brand <span class="text-red-500">*</span>
                        </label>
                        {{ form_widget(form.brand, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white', 'id': 'supplement_brand'}}) }}
                        <div class="error-message" id="brand-error"></div>
                    </div>

                    <!-- Price -->
                    <div>
                        <label for="supplement_price" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                            Price ($) <span class="text-red-500">*</span>
                        </label>
                        {{ form_widget(form.price, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white', 'id': 'supplement_price', 'placeholder': '0.00'}}) }}
                        <div class="error-message" id="price-error"></div>
                    </div>

                    <!-- Stock -->
                    <div>
                        <label for="supplement_stock" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                            Stock Quantity <span class="text-red-500">*</span>
                        </label>
                        {{ form_widget(form.stock, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white', 'id': 'supplement_stock', 'placeholder': '0'}}) }}
                        <div class="error-message" id="stock-error"></div>
                    </div>

                    <!-- Calories -->
                    <div>
                        <label for="supplement_calories" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                            Calories (Optional)
                        </label>
                        {{ form_widget(form.calories, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white', 'id': 'supplement_calories', 'placeholder': '0'}}) }}
                        <div class="error-message" id="calories-error"></div>
                    </div>
                </div>

                <!-- Description -->
                <div class="mt-6">
                    <label for="supplement_description" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                        Description <span class="text-red-500">*</span>
                    </label>
                    {{ form_widget(form.description, {'attr': {'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white', 'id': 'supplement_description'}}) }}
                    <div class="error-message" id="description-error"></div>
                </div>

                <!-- Image Upload -->
                <div class="mt-6">
                    <label for="supplement_imageFile" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                        Product Image (JPG, PNG, WEBP - Max 5MB)
                    </label>
                    {{ form_widget(form.imageFile, {'attr': {'class': 'block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 focus:outline-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400', 'id': 'supplement_imageFile'}}) }}
                    <div class="error-message" id="image-error"></div>
                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-300">Allowed formats: JPG, PNG, WEBP. Maximum size: 5MB</p>
                </div>

                <div class="mt-8 flex gap-4">
                    <button type="submit" class="inline-block px-6 py-3 font-bold text-center text-white uppercase align-middle transition-all bg-gradient-blue-marine rounded-lg cursor-pointer leading-normal text-xs ease-in tracking-tight-rem shadow-md bg-150 bg-x-25 hover:-translate-y-px active:opacity-85 hover:shadow-md">
                        <i class="fas fa-save mr-2"></i>Create Supplement
                    </button>
                    <a href="{{ path('app_supplement_index') }}" class="inline-block px-6 py-3 font-bold text-center text-slate-700 uppercase align-middle transition-all bg-transparent border border-slate-700 rounded-lg cursor-pointer leading-normal text-xs ease-in tracking-tight-rem hover:bg-slate-700 hover:text-white">
                        Cancel
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/supplement-validation.js') }}"></script>
{% endblock %}

