<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="920.0" prefWidth="1560.0" stylesheets="@styles/admin-theme.css" styleClass="app-root"
            xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Pidev3A49.controllers.MainController">
    <left>
        <VBox prefWidth="280.0" spacing="22.0" styleClass="sidebar">
            <padding>
                <Insets bottom="28.0" left="24.0" right="24.0" top="26.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="14.0">
                <Label minHeight="46.0" minWidth="46.0" prefHeight="46.0" prefWidth="46.0" styleClass="sidebar-logo" text="F"/>
                <VBox spacing="4.0">
                    <Label styleClass="sidebar-title" text="Fitopia Admin"/>
                    <Label styleClass="sidebar-subtitle" text="Supplements and nutrition"/>
                </VBox>
            </HBox>
            <VBox spacing="10.0" styleClass="user-card">
                <Label styleClass="user-label" text="Connected as"/>
                <Label styleClass="user-mail" text="admin@fitopia.local"/>
            </VBox>
            <VBox spacing="10.0">
                <Button fx:id="btnModuleSupplements" maxWidth="1.7976931348623157E308" onAction="#afficherModuleSupplements"
                        styleClass="sidebar-nav-button sidebar-nav-button-active" text="Supplements"/>
                <Button fx:id="btnModuleRegimes" maxWidth="1.7976931348623157E308" onAction="#afficherModuleRegimes"
                        styleClass="sidebar-nav-button" text="Regimes"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button maxWidth="1.7976931348623157E308" onAction="#rafraichirDonnees" styleClass="logout-button"
                    text="Refresh data"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="app-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <StackPane>
                    <VBox fx:id="viewSupplements" fillWidth="true" spacing="22.0" styleClass="content-root">
                        <padding>
                            <Insets bottom="30.0" left="30.0" right="30.0" top="26.0"/>
                        </padding>
                        <VBox spacing="8.0" styleClass="hero-banner">
                            <Label styleClass="hero-title" text="Gestion des supplements"/>
                            <Label styleClass="hero-subtitle" text="Creez, modifiez ou supprimez les supplements enregistres dans le systeme."/>
                        </VBox>
                        <VBox fx:id="supplementWorkspace" spacing="22.0">
                            <GridPane hgap="18.0" vgap="18.0" styleClass="action-grid">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                </columnConstraints>
                                <Button fx:id="btnActionCreerSupplement" maxWidth="1.7976931348623157E308" onAction="#afficherCreationSupplement" styleClass="action-card action-card-active" text="Creer un supplement&#10;Ajoutez un nouveau supplement a votre catalogue." GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Button fx:id="btnActionModifierSupplement" maxWidth="1.7976931348623157E308" onAction="#afficherModificationSupplement" styleClass="action-card" text="Modifier un supplement&#10;Mettez a jour les informations d'un supplement existant." GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Button fx:id="btnActionSupprimerSupplement" maxWidth="1.7976931348623157E308" onAction="#afficherSuppressionSupplement" styleClass="action-card" text="Supprimer un supplement&#10;Retirez un supplement non lie a des commandes." GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Button fx:id="btnActionExplorerSupplement" maxWidth="1.7976931348623157E308" onAction="#afficherExplorationSupplement" styleClass="action-card" text="Explorer les supplements&#10;Consultez la liste de tous les supplements enregistres." GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            </GridPane>
                            <StackPane>
                                <VBox fx:id="paneSupplementCreate" spacing="18.0" styleClass="panel-card">
                                    <Label styleClass="section-title" text="Creer un supplement"/>
                                    <Label styleClass="section-subtitle" text="Ajoutez un nouveau supplement avec ses informations produit, son prix et son image."/>
                                    <HBox alignment="CENTER_LEFT" styleClass="status-banner">
                                        <Label styleClass="status-banner-text" text="Vous etes connecte en tant que admin@fitopia.local"/>
                                    </HBox>
                                    <VBox spacing="16.0" styleClass="section-block">
                                        <Label styleClass="section-block-title" text="Informations principales"/>
                                        <GridPane hgap="16.0" vgap="16.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                            </columnConstraints>
                                            <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                <Label styleClass="field-label" text="Categorie"/>
                                                <TextField fx:id="tfSupplementCategory" promptText="Ex: Proteine" styleClass="text-input"/>
                                            </VBox>
                                            <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                <Label styleClass="field-label" text="Nom du supplement"/>
                                                <TextField fx:id="tfSupplementName" promptText="Ex: Whey isolate" styleClass="text-input"/>
                                            </VBox>
                                            <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                <Label styleClass="field-label" text="Marque"/>
                                                <TextField fx:id="tfSupplementBrand" promptText="Ex: Optimum Nutrition" styleClass="text-input"/>
                                            </VBox>
                                            <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                <Label styleClass="field-label" text="Description"/>
                                                <TextArea fx:id="taSupplementDescription" prefHeight="92.0" promptText="Ajoutez une description..." styleClass="text-area-input"/>
                                            </VBox>
                                        </GridPane>
                                    </VBox>
                                    <VBox spacing="16.0" styleClass="section-block">
                                        <Label styleClass="section-block-title" text="Valeurs commerciales et nutritionnelles"/>
                                        <HBox spacing="14.0">
                                            <VBox spacing="8.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                                <Label styleClass="field-label" text="Prix"/>
                                                <TextField fx:id="tfSupplementPrice" promptText="Ex: 189.90" styleClass="text-input"/>
                                            </VBox>
                                            <VBox spacing="8.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                                <Label styleClass="field-label" text="Stock"/>
                                                <TextField fx:id="tfSupplementStock" promptText="Ex: 42" styleClass="text-input"/>
                                            </VBox>
                                            <VBox spacing="8.0" styleClass="metric-card" HBox.hgrow="ALWAYS">
                                                <Label styleClass="field-label" text="Calories"/>
                                                <TextField fx:id="tfSupplementCalories" promptText="Optionnel" styleClass="text-input"/>
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                    <VBox spacing="16.0" styleClass="section-block">
                                        <Label styleClass="section-block-title" text="Media produit"/>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <Button onAction="#choisirImageSupplement" styleClass="secondary-button" text="Choisir une image"/>
                                            <Label fx:id="lblSelectedImage" styleClass="hint-label" text="Aucune image selectionnee"/>
                                        </HBox>
                                        <StackPane styleClass="image-shell">
                                            <ImageView fx:id="imgSupplementPreview" fitHeight="170.0" fitWidth="260.0" managed="false" pickOnBounds="true" preserveRatio="true" visible="false"/>
                                            <Label fx:id="lblImagePreviewHint" styleClass="image-placeholder" text="Apercu image"/>
                                        </StackPane>
                                    </VBox>
                                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                        <Button onAction="#viderFormulaireSupplement" styleClass="secondary-button" text="Vider"/>
                                        <Button onAction="#creerSupplement" styleClass="primary-button" text="Creer le supplement"/>
                                    </HBox>
                                </VBox>
                                <VBox fx:id="paneSupplementEdit" managed="false" spacing="18.0" styleClass="panel-card" visible="false">
                                    <Label styleClass="section-title" text="Modifier un supplement"/>
                                    <Label styleClass="section-subtitle" text="Selectionnez un supplement dans le tableau, puis mettez a jour ses informations."/>
                                    <TextField fx:id="tfSupplementId" editable="false" managed="false" visible="false"/>
                                    <TableView fx:id="tableSupplementsEdit" prefHeight="280.0" styleClass="data-table">
                                        <columns>
                                            <TableColumn fx:id="colSupplementIdEdit" prefWidth="70.0" text="ID"/>
                                            <TableColumn fx:id="colSupplementNameEdit" prefWidth="220.0" text="Nom"/>
                                            <TableColumn fx:id="colSupplementCategoryEdit" prefWidth="160.0" text="Categorie"/>
                                            <TableColumn fx:id="colSupplementBrandEdit" prefWidth="180.0" text="Marque"/>
                                            <TableColumn fx:id="colSupplementPriceEdit" prefWidth="110.0" text="Prix"/>
                                            <TableColumn fx:id="colSupplementStockEdit" prefWidth="100.0" text="Stock"/>
                                            <TableColumn fx:id="colSupplementImageEdit" prefWidth="210.0" text="Image"/>
                                        </columns>
                                    </TableView>
                                    <GridPane hgap="16.0" vgap="16.0">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                        </columnConstraints>
                                        <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label styleClass="field-label" text="Categorie"/>
                                            <TextField fx:id="tfSupplementCategoryEdit" styleClass="text-input"/>
                                        </VBox>
                                        <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label styleClass="field-label" text="Nom du supplement"/>
                                            <TextField fx:id="tfSupplementNameEdit" styleClass="text-input"/>
                                        </VBox>
                                        <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <Label styleClass="field-label" text="Marque"/>
                                            <TextField fx:id="tfSupplementBrandEdit" styleClass="text-input"/>
                                        </VBox>
                                        <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <Label styleClass="field-label" text="Description"/>
                                            <TextArea fx:id="taSupplementDescriptionEdit" prefHeight="92.0" styleClass="text-area-input"/>
                                        </VBox>
                                        <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <Label styleClass="field-label" text="Prix"/>
                                            <TextField fx:id="tfSupplementPriceEdit" styleClass="text-input"/>
                                        </VBox>
                                        <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <Label styleClass="field-label" text="Stock"/>
                                            <TextField fx:id="tfSupplementStockEdit" styleClass="text-input"/>
                                        </VBox>
                                        <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                            <Label styleClass="field-label" text="Calories"/>
                                            <TextField fx:id="tfSupplementCaloriesEdit" styleClass="text-input"/>
                                        </VBox>
                                    </GridPane>
                                    <VBox spacing="12.0" styleClass="section-block">
                                        <Label styleClass="section-block-title" text="Image du supplement"/>
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <Button onAction="#choisirImageSupplementModification" styleClass="secondary-button" text="Choisir une image"/>
                                            <Label fx:id="lblSelectedImageEdit" styleClass="hint-label" text="Aucune image selectionnee"/>
                                        </HBox>
                                        <StackPane styleClass="image-shell">
                                            <ImageView fx:id="imgSupplementPreviewEdit" fitHeight="170.0" fitWidth="260.0" managed="false" pickOnBounds="true" preserveRatio="true" visible="false"/>
                                            <Label fx:id="lblImagePreviewHintEdit" styleClass="image-placeholder" text="Apercu image"/>
                                        </StackPane>
                                    </VBox>
                                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                        <Button onAction="#viderFormulaireSupplementModification" styleClass="secondary-button" text="Reinitialiser"/>
                                        <Button onAction="#mettreAJourSupplement" styleClass="primary-button" text="Mettre a jour"/>
                                    </HBox>
                                </VBox>
                                <VBox fx:id="paneSupplementDelete" managed="false" spacing="18.0" styleClass="panel-card" visible="false">
                                    <Label styleClass="section-title" text="Supprimer un supplement"/>
                                    <Label styleClass="section-subtitle" text="Selectionnez un supplement puis confirmez sa suppression."/>
                                    <TableView fx:id="tableSupplementsDelete" prefHeight="470.0" styleClass="data-table">
                                        <columns>
                                            <TableColumn fx:id="colSupplementIdDelete" prefWidth="70.0" text="ID"/>
                                            <TableColumn fx:id="colSupplementNameDelete" prefWidth="220.0" text="Nom"/>
                                            <TableColumn fx:id="colSupplementCategoryDelete" prefWidth="160.0" text="Categorie"/>
                                            <TableColumn fx:id="colSupplementBrandDelete" prefWidth="180.0" text="Marque"/>
                                            <TableColumn fx:id="colSupplementPriceDelete" prefWidth="110.0" text="Prix"/>
                                            <TableColumn fx:id="colSupplementStockDelete" prefWidth="100.0" text="Stock"/>
                                            <TableColumn fx:id="colSupplementImageDelete" prefWidth="210.0" text="Image"/>
                                        </columns>
                                    </TableView>
                                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                        <Label fx:id="lblSupplementSelectionDelete" styleClass="hint-label" text="Aucun supplement selectionne"/>
                                        <Button onAction="#supprimerSupplement" styleClass="danger-button" text="Supprimer definitivement"/>
                                    </HBox>
                                </VBox>
                                <VBox fx:id="paneSupplementExplore" managed="false" spacing="18.0" styleClass="panel-card" visible="false">
                                    <Label styleClass="section-title" text="Explorer les supplements"/>
                                    <Label styleClass="section-subtitle" text="Consultez la liste complete des supplements enregistres et leurs details."/>
                                    <TableView fx:id="tableSupplements" prefHeight="320.0" styleClass="data-table">
                                        <columns>
                                            <TableColumn fx:id="colSupplementId" prefWidth="70.0" text="ID"/>
                                            <TableColumn fx:id="colSupplementName" prefWidth="220.0" text="Nom"/>
                                            <TableColumn fx:id="colSupplementCategory" prefWidth="160.0" text="Categorie"/>
                                            <TableColumn fx:id="colSupplementBrand" prefWidth="180.0" text="Marque"/>
                                            <TableColumn fx:id="colSupplementPrice" prefWidth="110.0" text="Prix"/>
                                            <TableColumn fx:id="colSupplementStock" prefWidth="100.0" text="Stock"/>
                                            <TableColumn fx:id="colSupplementImage" prefWidth="210.0" text="Image"/>
                                        </columns>
                                    </TableView>
                                    <HBox spacing="16.0">
                                        <VBox spacing="12.0" styleClass="section-block" HBox.hgrow="ALWAYS">
                                            <Label styleClass="section-block-title" text="Details du supplement"/>
                                            <GridPane hgap="12.0" vgap="12.0" styleClass="details-grid">
                                                <columnConstraints>
                                                    <ColumnConstraints percentWidth="42.0"/>
                                                    <ColumnConstraints percentWidth="58.0"/>
                                                </columnConstraints>
                                                <Label styleClass="detail-label" text="Nom" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                                <Label fx:id="lblDetailName" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                                <Label styleClass="detail-label" text="Categorie" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                                <Label fx:id="lblDetailCategory" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                                <Label styleClass="detail-label" text="Marque" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                                <Label fx:id="lblDetailBrand" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                                <Label styleClass="detail-label" text="Prix" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                                <Label fx:id="lblDetailPrice" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                                <Label styleClass="detail-label" text="Stock" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                                <Label fx:id="lblDetailStock" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                                                <Label styleClass="detail-label" text="Calories" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                                                <Label fx:id="lblDetailCalories" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                                                <Label styleClass="detail-label" text="Image" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                                                <Label fx:id="lblDetailImage" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                                                <Label styleClass="detail-label" text="Cree le" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                                                <Label fx:id="lblDetailCreatedAt" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                                                <Label styleClass="detail-label" text="Mis a jour le" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                                                <Label fx:id="lblDetailUpdatedAt" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                                                <Label styleClass="detail-label" text="Commandes liees" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                                                <Label fx:id="lblDetailOrderUsage" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                                            </GridPane>
                                            <VBox spacing="8.0">
                                                <Label styleClass="detail-label" text="Description"/>
                                                <TextArea fx:id="taSupplementDetailDescription" editable="false" focusTraversable="false" prefHeight="120.0" styleClass="text-area-input"/>
                                            </VBox>
                                        </VBox>
                                        <VBox prefWidth="300.0" spacing="12.0" styleClass="section-block">
                                            <Label styleClass="section-block-title" text="Image du supplement"/>
                                            <StackPane styleClass="image-shell">
                                                <ImageView fx:id="imgSupplementDetail" fitHeight="180.0" fitWidth="240.0" managed="false" pickOnBounds="true" preserveRatio="true" visible="false"/>
                                                <Label fx:id="lblDetailImageHint" styleClass="image-placeholder" text="Aucune image"/>
                                            </StackPane>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </StackPane>
                        </VBox>
                    </VBox>
                    <VBox fx:id="viewRegimes" fillWidth="true" managed="false" spacing="22.0" styleClass="content-root" visible="false">
                        <padding>
                            <Insets bottom="30.0" left="30.0" right="30.0" top="26.0"/>
                        </padding>
                        <VBox spacing="8.0" styleClass="hero-banner">
                            <Label styleClass="hero-title" text="Gestion des regimes"/>
                            <Label styleClass="hero-subtitle" text="Le module regimes reste disponible pour gerer les objectifs et descriptions nutritionnelles."/>
                        </VBox>
                        <VBox fx:id="regimeWorkspace" spacing="18.0">
                            <VBox spacing="18.0" styleClass="panel-card">
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <Label styleClass="section-title" text="Formulaire regime"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblRegimeSelectionHint" styleClass="hint-label" text="Selectionne un regime pour modifier ou supprimer."/>
                                </HBox>
                                <TextField fx:id="tfRegimeId" editable="false" managed="false" visible="false"/>
                                <GridPane hgap="16.0" vgap="16.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                    </columnConstraints>
                                    <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label styleClass="field-label" text="Nom"/>
                                        <TextField fx:id="tfRegimeNom" promptText="Keto" styleClass="text-input"/>
                                    </VBox>
                                    <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label styleClass="field-label" text="Objectif calorique"/>
                                        <TextField fx:id="tfRegimeObjectifCalorique" promptText="2200" styleClass="text-input"/>
                                    </VBox>
                                    <VBox spacing="8.0" styleClass="field-card field-card-wide" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                        <Label styleClass="field-label" text="Description"/>
                                        <TextArea fx:id="taRegimeDescription" prefHeight="120.0" promptText="Description du regime" styleClass="text-area-input"/>
                                    </VBox>
                                    <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                        <Label styleClass="field-label" text="Etat"/>
                                        <CheckBox fx:id="chkRegimeActif" selected="true" styleClass="check-input" text="Regime actif"/>
                                    </VBox>
                                </GridPane>
                                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                    <Button onAction="#viderFormulaireRegime" styleClass="secondary-button" text="Reinitialiser"/>
                                    <Button onAction="#creerRegime" styleClass="primary-button" text="Creer"/>
                                    <Button onAction="#mettreAJourRegime" styleClass="primary-button" text="Modifier"/>
                                    <Button onAction="#supprimerRegime" styleClass="danger-button" text="Supprimer"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="16.0" styleClass="panel-card">
                                <Label styleClass="section-title" text="Liste des regimes"/>
                                <TableView fx:id="tableRegimes" prefHeight="420.0" styleClass="data-table">
                                    <columns>
                                        <TableColumn fx:id="colRegimeId" prefWidth="70.0" text="ID"/>
                                        <TableColumn fx:id="colRegimeNom" prefWidth="180.0" text="Nom"/>
                                        <TableColumn fx:id="colRegimeDescription" prefWidth="420.0" text="Description"/>
                                        <TableColumn fx:id="colRegimeObjectifCalorique" prefWidth="160.0" text="Objectif"/>
                                        <TableColumn fx:id="colRegimeActif" prefWidth="110.0" text="Actif"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </VBox>
                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
