<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Séance — {{ session.label ?? session.sessionDate|date('d/m/Y') }}</title>
  <style>
    body { font-family: Helvetica, Arial, sans-serif; color: #0f172a; margin: 0; padding: 0; background: #f8fafc; }
    .page { max-width: 700px; margin: 0 auto; padding: 32px 24px; }
    .header { background: linear-gradient(135deg, #0b3a3d, #1a6b5a); border-radius: 14px; padding: 24px; color: #fff; margin-bottom: 24px; }
    .header h1 { margin: 0 0 4px; font-size: 22px; font-weight: 900; }
    .header p  { margin: 0; opacity: .85; font-size: 13px; }
    .meta-grid { display: table; width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    .meta-cell { display: table-cell; background: #fff; border: 1px solid #dce9ee; border-radius: 10px; padding: 12px 16px; width: 25%; }
    .meta-label { font-size: 11px; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; }
    .meta-value { font-size: 16px; font-weight: 900; color: #0b3a3d; margin-top: 4px; }
    .section-title { font-size: 14px; font-weight: 800; color: #0b3a3d; margin: 20px 0 10px; border-bottom: 2px solid #e8f5f0; padding-bottom: 6px; }
    .exercise-block { background: #fff; border: 1px solid #dce9ee; border-radius: 12px; padding: 14px 16px; margin-bottom: 12px; }
    .exercise-name { font-size: 15px; font-weight: 800; color: #0b3a3d; margin-bottom: 8px; }
    .exercise-muscle { font-size: 11px; color: #1a6b5a; font-weight: 700; background: #e8f5f0; border-radius: 999px; padding: 2px 9px; display: inline-block; margin-bottom: 8px; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    th { background: #f1f5f9; padding: 7px 10px; text-align: left; font-weight: 700; color: #475467; }
    td { padding: 7px 10px; border-bottom: 1px solid #f1f5f9; color: #0f172a; }
    .warmup { color: #94a3b8; font-style: italic; }
    .max-badge { background: #0b3a3d; color: #fff; border-radius: 6px; padding: 2px 7px; font-size: 10px; font-weight: 700; }
    .footer { text-align: center; margin-top: 28px; font-size: 11px; color: #94a3b8; }
    .summary-row { display: flex; gap: 12px; margin-bottom: 20px; }
    .summary-card { flex: 1; background: #fff; border: 1px solid #dce9ee; border-radius: 10px; padding: 10px 14px; text-align: center; }
    .summary-card .val { font-size: 20px; font-weight: 900; color: #0b3a3d; }
    .summary-card .lbl { font-size: 10px; color: #64748b; font-weight: 600; margin-top: 2px; }
  </style>
</head>
<body>
<div class="page">

  <div class="header">
    <h1>{{ session.label ?? 'Séance du ' ~ session.sessionDate|date('d/m/Y') }}</h1>
    <p>Fitopia — Rapport de séance d'entraînement</p>
  </div>

  {# Meta #}
  <table style="width:100%;border-collapse:separate;border-spacing:8px;margin-bottom:16px;">
    <tr>
      <td style="background:#fff;border:1px solid #dce9ee;border-radius:10px;padding:10px 14px;">
        <div style="font-size:10px;color:#64748b;font-weight:700;text-transform:uppercase;">Date</div>
        <div style="font-size:15px;font-weight:900;color:#0b3a3d;">{{ session.sessionDate|date('d/m/Y') }}</div>
      </td>
      <td style="background:#fff;border:1px solid #dce9ee;border-radius:10px;padding:10px 14px;">
        <div style="font-size:10px;color:#64748b;font-weight:700;text-transform:uppercase;">Semaine</div>
        <div style="font-size:15px;font-weight:900;color:#0b3a3d;">S{{ session.weekNumber }} {{ session.year }}</div>
      </td>
      <td style="background:#fff;border:1px solid #dce9ee;border-radius:10px;padding:10px 14px;">
        <div style="font-size:10px;color:#64748b;font-weight:700;text-transform:uppercase;">Durée</div>
        <div style="font-size:15px;font-weight:900;color:#0b3a3d;">{{ session.durationMin ?? '—' }} min</div>
      </td>
      <td style="background:#fff;border:1px solid #dce9ee;border-radius:10px;padding:10px 14px;">
        <div style="font-size:10px;color:#64748b;font-weight:700;text-transform:uppercase;">Exercices</div>
        <div style="font-size:15px;font-weight:900;color:#0b3a3d;">{{ session.performanceLogs|length }}</div>
      </td>
    </tr>
  </table>

  {# Exercices #}
  <div class="section-title">Détail des exercices</div>

  {% for log in session.performanceLogs %}
  <div class="exercise-block">
    <div class="exercise-name">{{ log.exerciseOrder }}. {{ log.exercise.name }}</div>
    <span class="exercise-muscle">{{ log.exercise.muscleGroup }}</span>
    {% if log.restSeconds %}
      <span style="font-size:11px;color:#64748b;margin-left:8px;">⏱ Repos : {{ log.restSeconds }}s</span>
    {% endif %}

    {% set maxWeight = log.maxWeight %}
    {% set totalVol  = log.totalVolume %}

    <table>
      <thead>
        <tr>
          <th>Série</th>
          <th>Poids (kg)</th>
          <th>Reps</th>
          <th>Volume</th>
          <th>Type</th>
        </tr>
      </thead>
      <tbody>
        {% for set in log.sets %}
        <tr {% if set.isWarmup %}class="warmup"{% endif %}>
          <td>{{ set.setNumber }}</td>
          <td>
            {{ set.weightKg ?? '—' }}
            {% if set.weightKg == maxWeight and not set.isWarmup %}
              <span class="max-badge">MAX</span>
            {% endif %}
          </td>
          <td>{{ set.repetitions ?? '—' }}</td>
          <td>
            {% if set.weightKg and set.repetitions %}
              {{ (set.weightKg * set.repetitions)|number_format(1) }} kg
            {% else %}—{% endif %}
          </td>
          <td>{{ set.isWarmup ? 'Échauffement' : 'Travail' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div style="margin-top:8px;font-size:11px;color:#475467;display:flex;gap:16px;">
      <span>🏆 Poids max : <strong>{{ maxWeight ?? '—' }} kg</strong></span>
      <span>📊 Volume total : <strong>{{ totalVol|number_format(1) }} kg×reps</strong></span>
      <span>🔢 Séries : <strong>{{ log.sets|length }}</strong></span>
    </div>
  </div>
  {% endfor %}

  {% if session.notes %}
  <div class="section-title">Notes</div>
  <div style="background:#fff;border:1px solid #dce9ee;border-radius:12px;padding:12px 16px;font-size:13px;color:#475467;">
    {{ session.notes }}
  </div>
  {% endif %}

  <div class="footer">
    Généré par Fitopia · {{ 'now'|date('d/m/Y H:i') }} · {{ session.user.email }}
  </div>

</div>
</body>
</html>
