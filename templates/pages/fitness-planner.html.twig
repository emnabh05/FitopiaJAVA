{% extends 'base.html.twig' %}

{% block title %}Fitness Planner | Fitopia{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root {
      --fp-bg: linear-gradient(145deg, #f3f8f7 0%, #eef4f7 100%);
      --fp-card: #ffffff;
      --fp-text: #0f2730;
      --fp-muted: #5f7180;
      --fp-primary: #0f6b63;
      --fp-primary-dark: #0a4d48;
      --fp-border: #dbe5eb;
      --fp-soft: #f0f6f7;
      --fp-shadow: 0 14px 42px rgba(10, 36, 54, 0.1);
      --fp-radius: 18px;
    }

    .fitness-page {
      background: var(--fp-bg);
      min-height: calc(100vh - 160px);
      padding: 2.4rem 0 3rem;
    }

    .fitness-shell {
      width: min(1200px, 92vw);
      margin: 0 auto;
      display: grid;
      gap: 1.3rem;
    }

    .fitness-hero {
      border-radius: calc(var(--fp-radius) + 6px);
      background: linear-gradient(130deg, #0b5750 0%, #1b7f73 65%, #44a89f 100%);
      color: #fff;
      box-shadow: var(--fp-shadow);
      padding: 2rem 1.7rem;
      position: relative;
      overflow: hidden;
    }

    .fitness-hero::after {
      content: "";
      position: absolute;
      width: 280px;
      height: 280px;
      border-radius: 50%;
      right: -95px;
      top: -120px;
      background: rgba(255, 255, 255, 0.14);
    }

    .fitness-hero h1 {
      color: #fff;
      font-size: clamp(1.8rem, 2.8vw, 2.55rem);
      margin: 0 0 .5rem;
      font-weight: 800;
      letter-spacing: .01em;
    }

    .fitness-hero p {
      color: rgba(255, 255, 255, .9);
      max-width: 700px;
      margin: 0;
      font-size: 1.03rem;
    }

    .fitness-stats {
      margin-top: 1.2rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: .8rem;
    }

    .fitness-stat {
      border: 1px solid rgba(255, 255, 255, .35);
      background: rgba(255, 255, 255, .1);
      border-radius: 14px;
      padding: .75rem .95rem;
    }

    .fitness-stat .v {
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1.2;
    }

    .fitness-stat .l {
      font-size: .81rem;
      letter-spacing: .02em;
      opacity: .9;
    }

    .fitness-nav {
      display: flex;
      flex-wrap: wrap;
      gap: .55rem;
      align-items: center;
    }

    .fitness-tab {
      border: 1px solid var(--fp-border);
      background: #fff;
      border-radius: 999px;
      padding: .5rem .95rem;
      font-weight: 600;
      color: var(--fp-text);
      cursor: pointer;
      transition: all .2s ease;
    }

    .fitness-tab:hover { transform: translateY(-1px); }
    .fitness-tab.is-active {
      background: var(--fp-primary);
      color: #fff;
      border-color: var(--fp-primary);
    }

    .fitness-card {
      background: var(--fp-card);
      border-radius: var(--fp-radius);
      border: 1px solid var(--fp-border);
      box-shadow: 0 10px 28px rgba(10, 36, 54, 0.06);
      padding: 1.2rem;
    }

    .fitness-toolbar {
      display: grid;
      gap: .8rem;
      grid-template-columns: 1fr auto auto;
      align-items: center;
    }

    .fitness-toolbar input,
    .fitness-toolbar select,
    .fitness-form input,
    .fitness-form select,
    .fitness-form textarea {
      border: 1px solid var(--fp-border);
      border-radius: 12px;
      min-height: 42px;
      padding: .52rem .72rem;
      width: 100%;
      color: var(--fp-text);
      background: #fff;
    }

    .fitness-form textarea { min-height: 94px; resize: vertical; }

    .fitness-btn {
      border: none;
      border-radius: 12px;
      font-weight: 700;
      min-height: 42px;
      padding: .55rem 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .45rem;
      transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
      cursor: pointer;
    }

    .fitness-btn:hover { transform: translateY(-1px); }
    .fitness-btn-primary { background: var(--fp-primary); color: #fff; }
    .fitness-btn-primary:hover { background: var(--fp-primary-dark); color: #fff; box-shadow: 0 10px 20px rgba(15, 107, 99, .26); }
    .fitness-btn-soft { background: var(--fp-soft); color: var(--fp-text); border: 1px solid var(--fp-border); }
    .fitness-btn-danger { background: #b42318; color: #fff; }
    .fitness-btn-danger:hover { background: #8c1c14; color: #fff; box-shadow: 0 10px 20px rgba(180, 35, 24, .22); }

    .fitness-grid {
      display: grid;
      gap: .95rem;
      grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    }

    .program-card {
      border: 1px solid var(--fp-border);
      border-radius: 16px;
      padding: .9rem;
      background: #fff;
      box-shadow: 0 8px 20px rgba(9, 31, 47, .06);
      transition: transform .2s ease, box-shadow .2s ease;
      display: grid;
      gap: .65rem;
    }

    .program-card:hover { transform: translateY(-2px); box-shadow: 0 14px 26px rgba(9, 31, 47, .1); }
    .program-thumb {
      width: 100%;
      aspect-ratio: 16 / 9;
      background-size: cover;
      background-position: center;
      border-radius: 12px;
      background-color: #dfebee;
    }

    .program-title { margin: 0; font-size: 1.14rem; font-weight: 700; color: var(--fp-text); }
    .program-meta { color: var(--fp-muted); font-size: .9rem; display: flex; flex-wrap: wrap; gap: .45rem .75rem; }
    .program-tags { display: flex; gap: .45rem; flex-wrap: wrap; }

    .program-tag {
      font-size: .75rem;
      border: 1px solid #d1e3e7;
      background: #f7fbfc;
      color: #255663;
      border-radius: 999px;
      padding: .2rem .55rem;
      font-weight: 600;
    }

    .program-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
    .program-actions form { margin: 0; }

    .fp-user-plans {
      margin-top: .9rem;
      display: grid;
      gap: .95rem;
      grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    }

    .fp-user-plan-list {
      margin: .2rem 0 0;
      padding-left: 1rem;
      color: var(--fp-muted);
      font-size: .88rem;
      display: grid;
      gap: .2rem;
    }

    .fitness-form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: .7rem;
    }

    .fitness-form-grid .full { grid-column: 1 / -1; }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .7rem;
      margin-bottom: .7rem;
      flex-wrap: wrap;
    }

    .section-head h2 {
      margin: 0;
      font-size: 1.34rem;
      color: var(--fp-text);
      font-weight: 750;
    }

    .section-head p {
      margin: 0;
      color: var(--fp-muted);
    }

    .exercise-list {
      display: grid;
      gap: .7rem;
      margin-top: .9rem;
    }

    .exercise-row {
      border: 1px solid var(--fp-border);
      border-radius: 14px;
      padding: .75rem;
      display: grid;
      gap: .35rem;
      background: #fff;
      transition: background-color .18s ease;
    }

    .exercise-row:hover { background: #f8fcfd; }
    .exercise-row .top { display: flex; align-items: center; justify-content: space-between; gap: .7rem; flex-wrap: wrap; }
    .exercise-row .name { font-weight: 700; color: var(--fp-text); }
    .exercise-row .meta { color: var(--fp-muted); font-size: .9rem; display: flex; gap: .7rem; flex-wrap: wrap; }
    .section { display: none; }
    .section.is-active { display: block; animation: fpFade .25s ease both; }

    @keyframes fpFade {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .explore-card {
      padding: 1rem;
    }

    .explore-shell {
      position: relative;
      margin-top: .8rem;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid #1a3a48;
      background: #081821;
      height: min(78vh, 760px);
    }

    .explore-feed {
      height: 100%;
      overflow-y: auto;
      scroll-snap-type: y mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .explore-slide {
      min-height: 100%;
      position: relative;
      scroll-snap-align: start;
      color: #fff;
      display: grid;
      align-items: end;
    }

    .explore-media {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 35% 20%, #2a7489 0%, #0a2331 70%);
    }

    .explore-media img,
    .explore-media video,
    .explore-media iframe {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .explore-media-fallback {
      position: absolute;
      inset: 0;
      display: grid;
      align-content: center;
      justify-items: center;
      gap: .7rem;
      padding: 1rem;
      text-align: center;
      background:
        radial-gradient(circle at 30% 22%, rgba(68, 168, 159, .35) 0%, rgba(8, 24, 33, .94) 68%),
        linear-gradient(120deg, rgba(8, 24, 33, .98), rgba(14, 38, 51, .98));
      color: #fff;
    }

    .explore-media-fallback-label {
      margin: 0;
      font-size: .95rem;
      font-weight: 700;
      max-width: 42ch;
    }

    .explore-media-fallback-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: .45rem;
    }

    .explore-fallback-btn {
      border: 1px solid rgba(255, 255, 255, .45);
      background: rgba(255, 255, 255, .08);
      color: #fff;
      border-radius: 999px;
      min-height: 36px;
      padding: .35rem .78rem;
      font-size: .8rem;
      font-weight: 700;
      cursor: pointer;
    }

    .explore-fallback-btn:hover {
      background: rgba(255, 255, 255, .16);
    }

    .explore-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(5, 12, 17, .86) 15%, rgba(5, 12, 17, .38) 58%, rgba(5, 12, 17, .2) 100%);
      pointer-events: none;
    }

    .explore-content {
      position: relative;
      z-index: 1;
      padding: 1rem 1rem 1.2rem;
      display: grid;
      gap: .8rem;
    }

    .explore-top h3 {
      margin: 0 0 .35rem;
      font-size: clamp(1.4rem, 2.4vw, 2rem);
      font-weight: 800;
      letter-spacing: .02em;
    }

    .explore-badges {
      display: flex;
      flex-wrap: wrap;
      gap: .4rem;
      margin-bottom: .35rem;
    }

    .explore-badge {
      background: rgba(255, 255, 255, .15);
      border: 1px solid rgba(255, 255, 255, .35);
      border-radius: 999px;
      padding: .2rem .55rem;
      font-size: .75rem;
      font-weight: 700;
      backdrop-filter: blur(4px);
    }

    .explore-meta {
      font-size: .85rem;
      color: rgba(255, 255, 255, .86);
      font-weight: 600;
    }

    .explore-tip {
      margin: 0;
      font-size: .95rem;
      color: rgba(255, 255, 255, .92);
      max-width: 62ch;
    }

    .explore-actions {
      display: flex;
      flex-wrap: wrap;
      gap: .45rem;
    }

    .explore-btn {
      border: 1px solid rgba(255, 255, 255, .34);
      background: rgba(7, 20, 29, .45);
      color: #fff;
      border-radius: 999px;
      min-height: 38px;
      padding: .4rem .8rem;
      font-size: .82rem;
      font-weight: 700;
      cursor: pointer;
    }

    .explore-btn.is-active {
      background: #ff2f63;
      border-color: #ff2f63;
    }

    .explore-ai-bar {
      margin-top: .65rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: .5rem;
      align-items: center;
    }

    .explore-ai-input {
      border: 1px solid var(--fp-border);
      border-radius: 999px;
      min-height: 40px;
      padding: .45rem .8rem;
      width: 100%;
    }

    .explore-progress {
      position: absolute;
      right: .55rem;
      top: .7rem;
      z-index: 4;
      width: 34px;
      display: grid;
      justify-items: center;
      gap: .4rem;
    }

    .explore-progress-count {
      font-size: .74rem;
      font-weight: 800;
      color: rgba(255, 255, 255, .92);
      text-shadow: 0 2px 8px rgba(0, 0, 0, .55);
    }

    .explore-progress-track {
      width: 4px;
      height: 88px;
      border-radius: 999px;
      background: rgba(255, 255, 255, .36);
      overflow: hidden;
    }

    .explore-progress-fill {
      width: 100%;
      height: 0;
      background: #44f1cb;
      transition: height .2s ease;
    }

    .alert-inline {
      border-radius: 12px;
      border: 1px solid #f3ccc8;
      background: #fff6f5;
      color: #942f25;
      padding: .8rem .95rem;
    }

    .program-category-list {
      display: grid;
      gap: 1rem;
    }

    .program-hero-card {
      position: relative;
      border-radius: 18px;
      min-height: 140px;
      overflow: hidden;
      background-color: #0a3a38;
      background-size: cover;
      background-position: center;
      box-shadow: 0 10px 24px rgba(6, 28, 34, .22);
    }

    .program-hero-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(8, 25, 32, .8) 0%, rgba(8, 25, 32, .2) 60%, rgba(8, 25, 32, 0) 100%);
    }

    .program-hero-title {
      position: relative;
      z-index: 1;
      color: #fff;
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: .02em;
      text-transform: none;
      padding: 1.1rem 1.2rem;
      margin: 0;
    }

    .program-hero-card.is-clickable { cursor: pointer; }

    .program-level-grid {
      display: grid;
      gap: .9rem;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    }

    .program-level-card {
      border: 1px solid var(--fp-border);
      border-radius: 16px;
      padding: .9rem;
      background: #fff;
      box-shadow: 0 8px 18px rgba(10, 36, 54, .06);
    }

    .program-level-title {
      font-weight: 800;
      margin: 0 0 .7rem;
      color: var(--fp-text);
      font-size: 1.02rem;
    }

    .trend-grid {
      display: grid;
      gap: .9rem;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    }

    .trends-toolbar {
      margin: .35rem 0 .75rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: .55rem;
      align-items: center;
    }

    .trends-toolbar input {
      min-width: 220px;
    }

    .trends-status {
      margin: 0 0 .8rem;
      color: var(--fp-muted);
      font-size: .88rem;
    }

    .trend-card {
      border: 1px solid var(--fp-border);
      border-radius: 16px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 8px 18px rgba(10, 36, 54, .06);
      display: grid;
      gap: .6rem;
    }

    .trend-thumb {
      width: 100%;
      height: 150px;
      background-size: cover;
      background-position: center;
      background-color: #dfeaec;
    }

    .trend-body {
      padding: .75rem .9rem 1rem;
      display: grid;
      gap: .45rem;
    }

    .trend-title {
      margin: 0;
      font-weight: 800;
      font-size: 1rem;
      color: var(--fp-text);
    }

    .trend-category {
      font-size: .8rem;
      color: var(--fp-muted);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .program-exercise-list {
      display: grid;
      gap: .6rem;
    }

    .program-exercise-name {
      font-weight: 700;
      color: var(--fp-text);
      font-size: .94rem;
    }

    .fp-modal {
      position: fixed;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(6, 18, 24, .6);
      z-index: 1200;
      padding: .7rem;
      overflow-y: auto;
    }

    .fp-modal.is-open { display: flex; }

    .fp-modal-card {
      width: min(430px, 96vw);
      background: #f3f5f7;
      border-radius: 18px;
      padding: .65rem .65rem .8rem;
      box-shadow: 0 20px 60px rgba(6, 18, 24, .25);
      border: 1px solid #e0e6ea;
      display: grid;
      gap: .65rem;
      max-height: calc(100vh - 1.4rem);
      overflow: auto;
    }

    .fp-modal-header {
      background: #fff;
      border-radius: 14px;
      padding: .7rem .85rem;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: .6rem;
      box-shadow: 0 6px 16px rgba(8, 20, 30, .08);
    }

    .fp-modal-back {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      background: transparent;
      border: none;
      font-weight: 700;
      color: #1b5c68;
      cursor: pointer;
    }

    .fp-modal-title {
      margin: 0;
      font-size: 1.06rem;
      color: var(--fp-text);
      font-weight: 800;
      text-align: center;
    }

    .fp-modal-subtitle {
      margin: 0;
      font-size: .86rem;
      color: var(--fp-muted);
      text-align: center;
    }

    .fp-location-list {
      display: grid;
      gap: .8rem;
    }

    .fp-location-card {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      min-height: 120px;
      background-color: #0a3a38;
      background-size: cover;
      background-position: center;
      border: 1px solid #dbe5eb;
      cursor: pointer;
    }

    .fp-location-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(8, 25, 32, .82) 0%, rgba(8, 25, 32, .2) 65%, rgba(8, 25, 32, 0) 100%);
    }

    .fp-location-label {
      position: relative;
      z-index: 1;
      color: #fff;
      font-weight: 800;
      font-size: 1.08rem;
      padding: 1rem 1.1rem;
      margin: 0;
    }

    .fp-level-card {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      min-height: 120px;
      background-color: #0a3a38;
      background-size: cover;
      background-position: center;
      border: 1px solid #dbe5eb;
      cursor: pointer;
    }

    .fp-level-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(8, 25, 32, .82) 0%, rgba(8, 25, 32, .2) 65%, rgba(8, 25, 32, 0) 100%);
    }

    .fp-level-label {
      position: relative;
      z-index: 1;
      color: #fff;
      font-weight: 800;
      font-size: 1.08rem;
      padding: 1rem 1.1rem;
      margin: 0;
    }

    .fp-exercise-list {
      display: grid;
      gap: .7rem;
    }

    .fp-exercise-shell {
      display: grid;
      gap: .9rem;
      grid-template-columns: 1fr;
      align-items: start;
    }

    .fp-session-panel {
      border: 1px solid var(--fp-border);
      border-radius: 16px;
      padding: .8rem;
      background: #fff;
      box-shadow: 0 8px 18px rgba(10, 36, 54, .06);
      display: grid;
      gap: .6rem;
      position: static;
    }

    .fp-session-title {
      margin: 0;
      font-weight: 800;
      font-size: 1rem;
      color: var(--fp-text);
    }

    .fp-session-count {
      color: var(--fp-muted);
      font-size: .9rem;
    }

    .fp-session-list {
      display: grid;
      gap: .4rem;
      max-height: 170px;
      overflow: auto;
      padding-right: .2rem;
    }

    .fp-session-item {
      font-size: .88rem;
      font-weight: 700;
      color: var(--fp-text);
      border: 1px solid #e2ecef;
      border-radius: 10px;
      padding: .45rem .55rem;
      background: #f8fbfc;
    }

    .fp-session-actions {
      display: grid;
      gap: .5rem;
    }

    .fp-session-meta {
      color: var(--fp-muted);
      font-size: .85rem;
    }

    .fp-exercise-action {
      margin-left: auto;
    }

    .fp-exercise-row-action {
      display: flex;
      align-items: center;
      gap: .6rem;
    }

    .fp-session-progress {
      font-weight: 800;
      color: var(--fp-text);
      font-size: .95rem;
    }

    .fp-session-rest {
      color: var(--fp-muted);
      font-size: .9rem;
    }

    .fp-modal .fp-exercise-shell {
      grid-template-columns: 1fr;
      gap: .6rem;
    }

    .fp-modal .fp-session-panel {
      position: static;
      order: 2;
    }

    .fp-modal .fp-exercise-list {
      order: 1;
    }

    @media (min-width: 980px) {
      .fp-exercise-shell { grid-template-columns: minmax(0, 1fr) 260px; }
      .fp-session-panel { position: sticky; top: 1rem; }
    }

    .fp-exercise-item {
      display: grid;
      grid-template-columns: 58px 1fr;
      gap: .55rem;
      align-items: center;
      padding: .5rem;
      border-radius: 14px;
      border: 1px solid #e2ecef;
      background: #fff;
      position: relative;
    }

    .fp-exercise-item.no-thumb {
      grid-template-columns: 1fr;
    }

    .fp-exercise-thumb {
      width: 58px;
      height: 58px;
      border-radius: 10px;
      background-size: cover;
      background-position: center;
      background-color: #dfeaec;
    }

    .fp-exercise-name {
      font-weight: 800;
      color: var(--fp-text);
      font-size: .9rem;
    }


    .fp-exercise-item.has-video {
      cursor: pointer;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .fp-exercise-item.has-video:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(9, 31, 47, .08);
    }

    .fp-video-modal-card {
      width: min(720px, 94vw);
      max-height: 86vh;
      overflow: auto;
    }

    .fp-modal .fitness-btn {
      min-height: 38px;
      padding: .45rem .8rem;
    }

    @media (max-height: 820px) {
      .fp-modal {
        align-items: flex-start;
      }
      .fp-modal-card {
        margin: .2rem 0;
      }
      .fp-modal-header {
        padding: .55rem .7rem;
      }
    }

    .fp-video-player {
      width: 100%;
      max-height: 60vh;
      height: auto;
      border-radius: 14px;
      background: #0b1c22;
      pointer-events: auto;
      object-fit: contain;
    }

    .fp-video-player::-webkit-media-controls-picture-in-picture-button {
      display: none;
    }

    iframe.fp-video-player {
      min-height: 260px;
      height: min(60vh, 460px);
      border: 0;
    }

    .fp-video-meta {
      display: grid;
      gap: .35rem;
      padding: .2rem .3rem 0;
    }

    .fp-video-title {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--fp-text);
    }

    .fp-video-subtitle {
      margin: 0;
      font-size: .88rem;
      color: var(--fp-muted);
    }

    .coach-shell {
      padding: 1rem;
    }

    .coach-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr);
      gap: 1rem;
      align-items: start;
    }

    .coach-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: .8rem;
    }

    .coach-item {
      border: 1px solid var(--fp-border);
      border-radius: 16px;
      background: #fff;
      overflow: hidden;
      display: grid;
      grid-template-rows: 150px 1fr;
      box-shadow: 0 6px 14px rgba(10, 36, 54, .06);
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    .coach-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 18px rgba(10, 36, 54, .1);
    }

    .coach-item.is-active {
      border-color: #2f8aa5;
      box-shadow: 0 12px 22px rgba(7, 49, 72, .16);
    }

    .coach-item-photo {
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-color: #dce9ee;
    }

    .coach-item-body {
      padding: .72rem .8rem .8rem;
      display: grid;
      gap: .42rem;
      align-content: start;
    }

    .coach-item-name {
      margin: 0;
      font-size: 1rem;
      font-weight: 800;
      color: var(--fp-text);
      line-height: 1.2;
    }

    .coach-item-speciality {
      margin: 0;
      color: #0f6b63;
      font-size: .86rem;
      font-weight: 700;
    }

    .coach-item-meta {
      display: flex;
      flex-wrap: wrap;
      gap: .45rem;
      color: var(--fp-muted);
      font-size: .82rem;
      font-weight: 650;
    }

    .coach-item-availability {
      margin: 0;
      color: var(--fp-muted);
      font-size: .8rem;
    }

    .coach-item .fitness-btn {
      margin-top: .15rem;
      width: 100%;
      justify-content: center;
    }

    .coach-profile {
      border: 1px solid var(--fp-border);
      border-radius: 16px;
      background: #fff;
      padding: .85rem;
      display: grid;
      gap: .65rem;
      box-shadow: 0 6px 14px rgba(10, 36, 54, .06);
    }

    .coach-profile-media {
      min-height: 200px;
      border-radius: 14px;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-color: #dce9ee;
    }

    .coach-profile-name {
      margin: 0;
      font-size: 1.2rem;
      font-weight: 850;
      color: var(--fp-text);
    }

    .coach-profile-role {
      margin: 0;
      color: #0f6b63;
      font-size: .9rem;
      font-weight: 700;
    }

    .coach-profile-meta {
      display: flex;
      flex-wrap: wrap;
      gap: .55rem;
      color: var(--fp-muted);
      font-size: .83rem;
      font-weight: 650;
    }

    .coach-profile-bio,
    .coach-profile-availability {
      margin: 0;
      color: var(--fp-muted);
      font-size: .88rem;
      line-height: 1.5;
    }

    .coach-list-block {
      border-top: 1px dashed #d8e5ea;
      padding-top: .45rem;
      display: grid;
      gap: .35rem;
    }

    .coach-list-title {
      color: var(--fp-text);
      font-size: .84rem;
      font-weight: 780;
    }

    .coach-list {
      margin: 0;
      padding-left: 1rem;
      color: var(--fp-muted);
      font-size: .84rem;
      display: grid;
      gap: .25rem;
    }

    .coach-message-label {
      color: var(--fp-text);
      font-size: .84rem;
      font-weight: 780;
    }

    #fp-coach-message-input {
      border: 1px solid var(--fp-border);
      border-radius: 12px;
      min-height: 90px;
      padding: .65rem .72rem;
      resize: vertical;
      font-size: .9rem;
      color: var(--fp-text);
    }

    .coach-actions {
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
    }

    .coach-actions .fitness-btn {
      flex: 1 1 170px;
      justify-content: center;
    }

    .coach-message-hint {
      margin: 0;
      color: var(--fp-muted);
      font-size: .82rem;
      line-height: 1.45;
    }

    .coach-booking-panel {
      border: 1px dashed #c9d8df;
      border-radius: 12px;
      padding: .68rem .72rem;
      background: #f8fbfc;
      display: grid;
      gap: .55rem;
    }

    .coach-booking-panel[hidden] {
      display: none !important;
    }

    .coach-date-grid {
      display: flex;
      flex-wrap: wrap;
      gap: .42rem;
    }

    .coach-date-btn {
      border: 1px solid var(--fp-border);
      background: #fff;
      color: var(--fp-text);
      border-radius: 999px;
      padding: .35rem .72rem;
      font-size: .8rem;
      font-weight: 700;
      cursor: pointer;
    }

    .coach-date-btn.is-active {
      background: #0f6b63;
      border-color: #0f6b63;
      color: #fff;
    }

    #fp-coach-slot-select {
      border: 1px solid var(--fp-border);
      border-radius: 10px;
      min-height: 40px;
      padding: .45rem .65rem;
      background: #fff;
      color: var(--fp-text);
      font-size: .9rem;
    }

    .hiit-card {
      border: 1px solid var(--fp-border);
      border-radius: 16px;
      padding: .95rem 1rem;
      background: #fff;
      box-shadow: 0 8px 18px rgba(10, 36, 54, .06);
      display: grid;
      gap: .8rem;
    }

    .hiit-title {
      margin: 0;
      font-size: 1.02rem;
      font-weight: 800;
      color: var(--fp-text);
    }

    .hiit-meta {
      color: var(--fp-muted);
      font-size: .9rem;
      display: flex;
      gap: .75rem;
      flex-wrap: wrap;
    }

    .hiit-meta strong { color: var(--fp-text); }

    .hiit-timer {
      display: grid;
      gap: .6rem;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      align-items: center;
    }

    .hiit-phase {
      border: 1px solid #e2ecef;
      border-radius: 12px;
      padding: .6rem .75rem;
      background: #f8fbfc;
    }

    .hiit-phase .label { font-weight: 700; color: var(--fp-text); }
    .hiit-phase .value { font-size: 1.05rem; font-weight: 800; }
    .hiit-phase .value.is-work { color: #b42318; }
    .hiit-phase .value.is-rest { color: #0f6b63; }
    .hiit-phase .value.is-done { color: #1f2937; }
    .hiit-phase .value.is-stretch { color: #1d4ed8; }

    .hiit-audio-grid {
      display: grid;
      gap: .65rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      align-items: end;
    }

    .hiit-field {
      display: grid;
      gap: .35rem;
    }

    .hiit-field > span {
      font-size: .84rem;
      color: var(--fp-muted);
      font-weight: 650;
    }

    .hiit-field select {
      border: 1px solid var(--fp-border);
      border-radius: 12px;
      min-height: 42px;
      padding: .52rem .72rem;
      width: 100%;
      color: var(--fp-text);
      background: #fff;
    }

    .hiit-field input[type="range"] {
      width: 100%;
      accent-color: var(--fp-primary);
    }

    .hiit-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
    .hiit-actions .fitness-btn { flex: 1 1 170px; }

    .hiit-coach-line {
      border: 1px dashed #c9d8df;
      border-radius: 12px;
      padding: .55rem .7rem;
      background: #f8fbfc;
      color: var(--fp-text);
      font-size: .88rem;
      font-weight: 650;
    }

    .hiit-hidden-audio {
      width: 0;
      height: 0;
      opacity: 0;
      pointer-events: none;
      position: absolute;
    }

    @media (max-width: 860px) {
      .fitness-toolbar { grid-template-columns: 1fr; }
      .trends-toolbar { grid-template-columns: 1fr; }
      .coach-layout { grid-template-columns: 1fr; }
    }

  </style>
{% endblock %}

{% block body %}
<section class="fitness-page">
  <div class="fitness-shell">
    <div class="fitness-hero">
      <h1>Fitness Planner Command Center</h1>
      <p>Integrated from your external fitness module into one premium page: discover plans, manage training programs, and maintain your exercise library without leaving this screen.</p>
      <div class="fitness-stats">
        <div class="fitness-stat">
          <div class="v">{{ stats.programs }}</div>
          <div class="l">Programs Available</div>
        </div>
        <div class="fitness-stat">
          <div class="v">{{ stats.exercises }}</div>
          <div class="l">Exercises Library</div>
        </div>
        <div class="fitness-stat">
          <div class="v">{{ stats.avgDuration }} min</div>
          <div class="l">Avg Session Duration</div>
        </div>
      </div>
    </div>

    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">{{ message }}</div>
      {% endfor %}
    {% endfor %}

    {% set externalImageMap = {
      'Poitrine': asset('images/fitness/poitrine-1.jpg'),
      'Dos': asset('images/fitness/dos.jpg'),
      'Jambes': asset('images/fitness/jambes.jpg'),
      'Fessier': asset('images/fitness/fessier.jpg'),
      'Epaules': asset('images/fitness/epaules.jpg'),
      'Biceps': asset('images/fitness/biceps.jpg'),
      'Triceps': asset('images/fitness/triceps.jpg'),
      'Avant-bras': asset('images/fitness/avant-bras.jpg'),
      'Abdos': asset('images/fitness/abdos.jpg'),
      'Entrainement du corps entier': asset('images/fitness/corps-entier.jpg')
    } %}
    {% set exerciseImageMap = {} %}
    {% for ex in exercises %}
      {% set exerciseImageMap = exerciseImageMap|merge({ (ex.name): ex.imageUrl }) %}
    {% endfor %}

    {% if not tablesReady %}
      <div class="alert-inline">Fitness planner tables are missing. Run migration `Version20260211130000` then reload this page.</div>
    {% endif %}

    <div class="fitness-nav">
      <a class="fitness-tab {{ activeView == 'plans' ? 'is-active' : '' }}" href="{{ path('fitness_planner', {view: 'plans'}) }}" data-view="plans"><i class="fa fa-th-large"></i> Plans</a>
      <a class="fitness-tab {{ activeView == 'manage' ? 'is-active' : '' }}" href="{{ path('fitness_planner', {view: 'manage'}) }}" data-view="manage"><i class="fa fa-cogs"></i> Programs</a>
      <a class="fitness-tab {{ activeView == 'exercises' ? 'is-active' : '' }}" href="{{ path('fitness_planner', {view: 'exercises'}) }}" data-view="exercises"><i class="fa fa-list-ul"></i> Exercises</a>
      <a class="fitness-tab {{ activeView == 'explore' ? 'is-active' : '' }}" href="{{ path('fitness_planner', {view: 'explore'}) }}" data-view="explore"><i class="fa fa-compass"></i> Explore</a>
      <a class="fitness-tab {{ activeView == 'coach' ? 'is-active' : '' }}" href="{{ path('fitness_planner', {view: 'coach'}) }}" data-view="coach"><i class="fa fa-user-circle-o"></i> Coach</a>
    </div>

    <div class="section {{ activeView == 'plans' ? 'is-active' : '' }}" data-section="plans">
      <div class="fitness-card">
        <div class="section-head">
          <div>
            <h2>Explore Training Plans</h2>
            <p>Tes séances confirmées apparaissent ici.</p>
          </div>
        </div>
        <div id="fp-user-plans-list" class="fp-user-plans"></div>
      </div>
    </div>

    <div class="section {{ activeView == 'manage' ? 'is-active' : '' }}" data-section="manage">
      {% set programCategories = [
        'Poitrine',
        'Dos',
        'Jambes',
        'Fessier',
        'Epaules',
        'Biceps',
        'Triceps',
        'Avant-bras',
        'Abdos',
        'Entrainement du corps entier'
      ] %}
      {% set poitrineLevels = {
        'Débutant': [
          'Developpe couche avec barre',
          'Developpe couche incline avec barre',
          'Arm chest flyes plies a la poulie'
        ],
        'Avance': [
          'Developpe assis poitrine prise marteau',
          'Developpe incline a la machine',
          'Dips pectoraux'
        ],
        'Expert': [
          'Developpe couche allonge avec elastique',
          'Developpe couche a la poulie vis a vis',
          'Developpe poitrine prise marteau a un bras assis'
        ]
      } %}
      {% set programImageMap = {} %}
      {% for plan in programs %}
        {% set programImageMap = programImageMap|merge({ (plan.title): plan.imageUrl }) %}
      {% endfor %}

      <div class="fitness-card mt-3">
        <div class="section-head">
          <div>
            <h2>Liste des programmes</h2>
            <p>Accès rapide par groupe musculaire, avec focus Poitrine.</p>
          </div>
        </div>
        <div class="program-category-list">
          {% for category in programCategories %}
            {% set catImage = externalImageMap[category]|default('') %}
            <div class="program-hero-card is-clickable" data-program="{{ category }}" style="{{ catImage ? 'background-image:url(' ~ catImage ~ ');' : '' }}">
              <h3 class="program-hero-title">{{ category }}</h3>
            </div>
          {% endfor %}
        </div>

        {# Poitrine levels table removed per request #}
      </div>
    </div>

    <div class="section {{ activeView == 'exercises' ? 'is-active' : '' }}" data-section="exercises">
      <div class="fitness-card">
        <div class="section-head">
          <div>
            <h2>{{ exerciseInEdit ? 'Update Exercise' : 'Create Exercise' }}</h2>
            <p>Build and maintain your full exercise library.</p>
          </div>
          {% if exerciseInEdit %}
            <a href="{{ path('fitness_planner', {view: 'exercises'}) }}" class="fitness-btn fitness-btn-soft"><i class="fa fa-times"></i> Cancel Edit</a>
          {% endif %}
        </div>

        <form method="post" action="{{ path('fitness_planner') }}" class="fitness-form" novalidate="novalidate">
          <input type="hidden" name="_token" value="{{ csrf_token('fitness_planner') }}">
          <input type="hidden" name="action" value="{{ exerciseInEdit ? 'update_exercise' : 'create_exercise' }}">
          <input type="hidden" name="redirect_view" value="exercises">
          {% if exerciseInEdit %}
            <input type="hidden" name="id" value="{{ exerciseInEdit.id }}">
          {% endif %}
          <div class="fitness-form-grid">
            <input type="text" name="name" required placeholder="Exercise name" value="{{ exerciseInEdit ? exerciseInEdit.name : '' }}">
            <select name="muscle_group" required>
              <option value="">Muscle group</option>
              <option value="Poitrine" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Poitrine' ? 'selected' : '' }}>Poitrine</option>
              <option value="Dos" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Dos' ? 'selected' : '' }}>Dos</option>
              <option value="Jambes" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Jambes' ? 'selected' : '' }}>Jambes</option>
              <option value="Fessier" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Fessier' ? 'selected' : '' }}>Fessier</option>
              <option value="Epaules" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Epaules' ? 'selected' : '' }}>Epaules</option>
              <option value="Biceps" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Biceps' ? 'selected' : '' }}>Biceps</option>
              <option value="Triceps" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Triceps' ? 'selected' : '' }}>Triceps</option>
              <option value="Avant-bras" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Avant-bras' ? 'selected' : '' }}>Avant-bras</option>
              <option value="Abdos" {{ exerciseInEdit and exerciseInEdit.muscleGroup == 'Abdos' ? 'selected' : '' }}>Abdos</option>
            </select>
            <select name="difficulty" required>
              <option value="">Difficulty...</option>
              {% for level in ['Beginner', 'Intermediate', 'Advanced'] %}
                <option value="{{ level }}" {{ exerciseInEdit and exerciseInEdit.difficulty == level ? 'selected' : '' }}>{{ level }}</option>
              {% endfor %}
            </select>
            <input type="number" min="1" name="sets" placeholder="Sets" value="{{ exerciseInEdit and exerciseInEdit.sets ? exerciseInEdit.sets : '' }}">
            <input type="number" min="1" name="repetitions" placeholder="Repetitions" value="{{ exerciseInEdit and exerciseInEdit.repetitions ? exerciseInEdit.repetitions : '' }}">
            <input type="number" min="1" name="duration" placeholder="Duration (min)" value="{{ exerciseInEdit and exerciseInEdit.duration ? exerciseInEdit.duration : '' }}">
            <input type="url" name="image_url" placeholder="Image URL" value="{{ exerciseInEdit ? exerciseInEdit.imageUrl : '' }}">
            <input type="url" name="video_url" placeholder="Video URL" value="{{ exerciseInEdit ? exerciseInEdit.videoUrl : '' }}">
            <textarea class="full" name="description" placeholder="Description">{{ exerciseInEdit ? exerciseInEdit.description : '' }}</textarea>
          </div>
          <div class="program-actions mt-3">
            <button class="fitness-btn fitness-btn-primary" type="submit"><i class="fa fa-save"></i> {{ exerciseInEdit ? 'Save Exercise' : 'Create Exercise' }}</button>
          </div>
        </form>

        <div class="exercise-list">
          {% for ex in exercises %}
            <article class="exercise-row">
              <div class="top">
                <div class="name">{{ ex.name }}</div>
                <div class="program-actions">
                  <a class="fitness-btn fitness-btn-soft" href="{{ path('fitness_planner', {view: 'exercises', exercise_edit: ex.id}) }}"><i class="fa fa-pencil"></i> Edit</a>
                  <form method="post" action="{{ path('fitness_planner') }}" onsubmit="return confirm('Delete this exercise?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('fitness_planner') }}">
                    <input type="hidden" name="action" value="delete_exercise">
                    <input type="hidden" name="id" value="{{ ex.id }}">
                    <input type="hidden" name="redirect_view" value="exercises">
                    <button class="fitness-btn fitness-btn-danger" type="submit"><i class="fa fa-trash"></i> Delete</button>
                  </form>
                </div>
              </div>
              <div class="meta">
                <span><i class="fa fa-map-signs"></i> {{ ex.muscleGroup }}</span>
                <span><i class="fa fa-signal"></i> {{ ex.difficulty }}</span>
                {% if ex.sets %}<span>{{ ex.sets }} sets</span>{% endif %}
                {% if ex.repetitions %}<span>{{ ex.repetitions }} reps</span>{% endif %}
                {% if ex.duration %}<span>{{ ex.duration }} min</span>{% endif %}
              </div>
            </article>
          {% else %}
            <article class="exercise-row">
              <div class="name">No exercises yet</div>
              <div class="meta">Create your first exercise above.</div>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>


    <div class="section {{ activeView == 'explore' ? 'is-active' : '' }}" data-section="explore">
      <div class="fitness-card explore-card">
        <div class="section-head">
          <div>
            <h2>Explore</h2>
            <p>Swipe/scroll vertical: haut = exercice suivant, bas = précédent.</p>
          </div>
        </div>
        <div class="explore-ai-bar">
          <input id="fp-explore-ai-query" class="explore-ai-input" type="text" placeholder="Ex: perte de poids, cardio, abdos, debutant...">
          <button id="fp-explore-ai-generate" type="button" class="fitness-btn fitness-btn-primary"><i class="fa fa-magic"></i> IA Import videos</button>
        </div>

        <div class="explore-shell">
          <aside class="explore-progress" aria-hidden="true">
            <div class="explore-progress-count" id="fp-explore-count">1/1</div>
            <div class="explore-progress-track">
              <div class="explore-progress-fill" id="fp-explore-fill"></div>
            </div>
          </aside>

          <div class="explore-feed" id="fp-explore-feed">
            <article class="explore-slide"
              data-name="Feed IA Fitopia"
              data-video=""
              data-image=""
              data-description="Clique sur IA Import videos pour charger un flux sport automatiquement."
              data-muscle="Corps entier"
              data-difficulty="Beginner"
              data-duration="3">
              <div class="explore-media"></div>
              <div class="explore-overlay"></div>
              <div class="explore-content">
                <div class="explore-top">
                  <h3>Feed IA Fitopia</h3>
                  <div class="explore-badges">
                    <span class="explore-badge">Corps entier</span>
                    <span class="explore-badge">Beginner</span>
                    <span class="explore-badge">Sans materiel</span>
                  </div>
                  <div class="explore-meta">~3 min a maitriser</div>
                </div>
                <p class="explore-tip">Clique sur IA Import videos pour charger un flux sport automatiquement.</p>
                <div class="explore-actions">
                  <button type="button" class="explore-btn" data-action="favorite">&#10084; Favori</button>
                  <button type="button" class="explore-btn" data-action="add">+ Ajouter au plan</button>
                  <button type="button" class="explore-btn" data-action="try">30s Essayer</button>
                  <button type="button" class="explore-btn" data-action="details">i Details</button>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </div>

    <div class="section {{ activeView == 'coach' ? 'is-active' : '' }}" data-section="coach">
      <div class="fitness-card coach-shell">
        <div class="section-head">
          <div>
            <h2>Coachs Privés</h2>
            <p>Réservez une séance avec l'un de nos 6 coachs certifiés.</p>
