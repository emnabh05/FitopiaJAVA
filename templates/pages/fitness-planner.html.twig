{% block javascripts %}
  {{ parent() }}
  {% set exerciseImageMapJs = {} %}
  {% for ex in exercises %}
    {% set exerciseImageMapJs = exerciseImageMapJs|merge({ (ex.name): ex.imageUrl }) %}
  {% endfor %}
  {% set trendsDataJs = [] %}
  {% for t in trends %}
    {% set trendsDataJs = trendsDataJs|merge([{
      id: t.id,
      title: t.title,
      category: t.category,
      description: t.description,
      imageUrl: t.imageUrl
    }]) %}
  {% endfor %}
  {% set externalImageMapJs = {
    'Poitrine': asset('images/fitness/poitrine-1.jpg'),
    'Dos': asset('images/fitness/dos.jpg'),
    'Jambes': asset('images/fitness/jambes.jpg'),
    'Fessier': asset('images/fitness/fessier.jpg'),
    'Epaules': asset('images/fitness/epaules.jpg'),
    'Biceps': asset('images/fitness/biceps.jpg'),
    'Triceps': asset('images/fitness/triceps.jpg'),
    'Avant-bras': asset('images/fitness/avant-bras.jpg'),
    'Abdos': asset('images/fitness/abdos.jpg'),
    'Entrainement du corps entier': asset('images/fitness/corps-entier.jpg')
  } %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const tabs = Array.from(document.querySelectorAll('.fitness-tab'));
      const sections = Array.from(document.querySelectorAll('.section'));
      const setView = (view) => {
        tabs.forEach((tab) => tab.classList.toggle('is-active', tab.dataset.view === view));
        sections.forEach((section) => section.classList.toggle('is-active', section.dataset.section === view));
      };
      const syncViewInUrl = (view) => {
        const url = new URL(window.location.href);
        url.searchParams.set('view', view);
        window.history.replaceState({}, '', url.toString());
      };
      tabs.forEach((tab) => tab.addEventListener('click', (event) => {
        event.preventDefault();
        const view = tab.dataset.view || 'plans';
        setView(view);
        syncViewInUrl(view);
        if (view === 'explore') {
          window.setTimeout(() => {
            if (typeof updateExploreProgress === 'function') {
              updateExploreProgress();
            }
          }, 30);
        }
      }));

      const modal = document.getElementById('fp-program-modal');
      const modalTitle = document.getElementById('fp-modal-title');
      const modalSubtitle = document.getElementById('fp-modal-subtitle');
      const modalClose = document.getElementById('fp-modal-close');
      const cards = Array.from(document.querySelectorAll('.program-hero-card'));
      const levelModal = document.getElementById('fp-level-modal');
      const levelTitle = document.getElementById('fp-level-title');
      const levelSubtitle = document.getElementById('fp-level-subtitle');
      const levelClose = document.getElementById('fp-level-close');
      const levelCards = Array.from(document.querySelectorAll('.fp-level-card'));
      const gymCard = document.getElementById('fp-modal-gym');
      const homeCard = document.getElementById('fp-modal-home');
      const exerciseModal = document.getElementById('fp-exercise-modal');
      const exerciseTitle = document.getElementById('fp-exercise-title');
      const exerciseSubtitle = document.getElementById('fp-exercise-subtitle');
      const exerciseClose = document.getElementById('fp-exercise-close');
      const exerciseList = document.getElementById('fp-exercise-list');
      const videoModal = document.getElementById('fp-video-modal');
      const videoClose = document.getElementById('fp-video-close');
      const videoTitle = document.getElementById('fp-video-title');
      const videoSubtitle = document.getElementById('fp-video-subtitle');
      const videoName = document.getElementById('fp-video-name');
      const videoDesc = document.getElementById('fp-video-desc');
      const videoPlayer = document.getElementById('fp-video-player');
      const videoIframe = document.getElementById('fp-video-iframe');
      const sessionCount = document.getElementById('fp-session-count');
      const sessionTime = document.getElementById('fp-session-time');
      const sessionList = document.getElementById('fp-session-list');
      const sessionStart = document.getElementById('fp-session-start');
      const sessionClear = document.getElementById('fp-session-clear');
      const sessionProgress = document.getElementById('session-progress');
      const sessionRest = document.getElementById('session-rest');
      const sessionNext = document.getElementById('session-next');
      const userPlansList = document.getElementById('fp-user-plans-list');
      const planCreateUrl = '{{ path('fitness_planner_plan_create') }}';
      const planDeleteUrlTemplate = '{{ path('fitness_planner_plan_delete', {id: '__ID__'}) }}';
      const coachSmsSendUrl = '{{ path('fitness_planner_coach_send_sms') }}';
      const plannerCsrfToken = '{{ csrf_token('fitness_planner') }}';
      const plansPersistAvailable = {{ plansPersistAvailable ? 'true' : 'false' }};
      const initialSavedPlans = {{ savedPlans|json_encode|raw }};
      const initialTrends = {{ trendsDataJs|json_encode|raw }};
      const trendsGrid = document.getElementById('fp-trends-grid');
      const trendsQueryInput = document.getElementById('fp-trends-query');
      const trendsRefreshBtn = document.getElementById('fp-trends-refresh');
      const trendsStatus = document.getElementById('fp-trends-status');
      let selectedProgram = '';
      let selectedPlace = '';
      let sessionExercises = [];
      let sessionIndex = 0;
      let sessionRestTimer = null;
      let confirmedPlans = Array.isArray(initialSavedPlans) ? initialSavedPlans : [];
      const allTrends = Array.isArray(initialTrends) ? initialTrends : [];
      let trendsFetchDebounce = null;

      const clearVideoPlayer = () => {
        if (!videoPlayer) return;
        videoPlayer.pause();
        videoPlayer.removeAttribute('src');
        videoPlayer.load();
        videoPlayer.hidden = true;
      };

      const clearVideoIframe = () => {
        if (!videoIframe) return;
        videoIframe.removeAttribute('src');
        videoIframe.hidden = true;
      };

      const closeVideoModal = () => {
        clearVideoPlayer();
        clearVideoIframe();
        if (!videoModal) return;
        videoModal.classList.remove('is-open');
        videoModal.setAttribute('aria-hidden', 'true');
        stopSessionRestTimer();
        forceStopHiitAndMusic();
      };

      const openVideoModalWithSource = (source, metadata = {}) => {
        if (!videoModal || !source || !source.src) return false;
        clearVideoPlayer();
        clearVideoIframe();

        if (source.type === 'video' && videoPlayer) {
          videoPlayer.hidden = false;
          videoPlayer.disablePictureInPicture = true;
          videoPlayer.setAttribute('disablepictureinpicture', 'disablepictureinpicture');
          videoPlayer.src = source.src;
          videoPlayer.setAttribute('controls', 'controls');
          videoPlayer.controls = true;
          videoPlayer.playsInline = true;
          videoPlayer.load();
        } else if (source.type === 'youtube' && videoIframe) {
          videoIframe.hidden = false;
          videoIframe.src = source.src;
        } else {
          return false;
        }

        if (videoTitle) videoTitle.textContent = metadata.title || 'Video';
        if (videoSubtitle) videoSubtitle.textContent = metadata.subtitle || 'Exercice';
        if (videoName) videoName.textContent = metadata.name || '';
        if (videoDesc) {
          videoDesc.textContent = source.type === 'youtube'
            ? 'Video YouTube en incrustation.'
            : 'Clique sur lecture pour demarrer.';
        }

        const modalCard = videoModal.querySelector('.fp-modal-card');
        if (modalCard) {
          modalCard.scrollTop = 0;
        }

        videoModal.classList.add('is-open');
        videoModal.setAttribute('aria-hidden', 'false');
        return true;
      };

      const openModal = (programName) => {
        if (modalTitle) modalTitle.textContent = `Ou s'entrainer`;
        if (modalSubtitle) modalSubtitle.textContent = programName;
        selectedProgram = programName || '';
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
      };

      const closeModal = () => {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
      };

      const openLevelModal = (placeLabel) => {
        selectedPlace = placeLabel || '';
        if (levelTitle) levelTitle.textContent = 'Niveau de difficulté';
        if (levelSubtitle) {
          levelSubtitle.textContent = selectedProgram ? `${selectedProgram} - ${placeLabel}` : placeLabel;
        }
        levelModal.classList.add('is-open');
        levelModal.setAttribute('aria-hidden', 'false');
      };

      const closeLevelModal = () => {
        levelModal.classList.remove('is-open');
        levelModal.setAttribute('aria-hidden', 'true');
      };

      const openExerciseModal = (levelLabel) => {
        if (exerciseTitle) {
          exerciseTitle.textContent = selectedProgram || 'Programme';
        }
        if (exerciseSubtitle) {
          exerciseSubtitle.textContent = `${selectedPlace} - ${levelLabel}`;
        }

        const exerciseImageMap = {{ exerciseImageMapJs|json_encode|raw }};
        const programImageMap = {{ externalImageMapJs|json_encode|raw }};
        const overrideExerciseImages = {
          'Developpe couche avec barre': '{{ asset("images/fitness/exercises/developpe-couche-avec-barre.webp") }}',
          'Developpe couche incline avec barre': '{{ asset("images/fitness/exercises/developpe-incline-machine.gif") }}',
          'Arm chest flyes plies a la poulie': '{{ asset("images/fitness/exercises/arm-chest-flyes-poulie.jpg") }}',
          'Developpe assis poitrine prise marteau': '{{ asset("images/fitness/exercises/developpe-assis-prise-marteau.gif") }}',
          'Developpe incline a la machine': '{{ asset("images/fitness/exercises/developpe-incline-machine.gif") }}',
          'Dips pectoraux': '{{ asset("images/fitness/exercises/dips-pectoraux.png") }}',
          'Developpe couche allonge avec elastique': '{{ asset("images/fitness/exercises/developpe-couche-allonge-elastique.webp") }}',
          'Developpe couche a la poulie vis a vis': '{{ asset("images/fitness/exercises/developpe-couche-poulie-vis-a-vis.webp") }}',
          'Developpe poitrine prise marteau a un bras assis': '{{ asset("images/fitness/exercises/developpe-prise-marteau-un-bras-assis.gif") }}'
        };
        const exerciseVideoMap = {
          'Developpe couche avec barre': '{{ asset("videos/fitness/developpe-couche-avec-barre.mp4") }}',
          'Developpe couche incline avec barre': '{{ asset("videos/fitness/developpe-couche-incline-avec-barre.mp4") }}',
          'Arm chest flyes plies a la poulie': '{{ asset("videos/fitness/arm-chest-flyes-poulie.mp4") }}',
          'Developpe assis poitrine prise marteau': '{{ asset("videos/fitness/developpe-assis-prise-marteau.mp4") }}',
          'Developpe incline a la machine': '{{ asset("videos/fitness/developpe-incline-machine.mp4") }}',
          'Dips pectoraux': '{{ asset("videos/fitness/dips-pectoraux.mp4") }}',
          'Developpe couche allonge avec elastique': '{{ asset("videos/fitness/developpe-couche-allonge-elastique.mp4") }}',
          'Developpe couche a la poulie vis a vis': '{{ asset("videos/fitness/developpe-couche-poulie-vis-a-vis.mp4") }}',
          'Developpe poitrine prise marteau a un bras assis': '{{ asset("videos/fitness/developpe-prise-marteau-un-bras-assis.mp4") }}'
        };
        const programExercises = {
          'Poitrine': {
            'Débutant': [
              'Developpe couche avec barre',
              'Developpe couche incline avec barre',
              'Arm chest flyes plies a la poulie'
            ],
            'Avance': [
              'Developpe assis poitrine prise marteau',
              'Developpe incline a la machine',
              'Dips pectoraux'
            ],
            'Expert': [
              'Developpe couche allonge avec elastique',
              'Developpe couche a la poulie vis a vis',
              'Developpe poitrine prise marteau a un bras assis'
            ]
          }
        };

        const list = (programExercises[selectedProgram] && programExercises[selectedProgram][levelLabel]) || [];
        if (exerciseList) {
          exerciseList.innerHTML = '';
          if (list.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'program-meta';
            empty.textContent = 'Aucun exercice disponible pour ce choix.';
            exerciseList.appendChild(empty);
          } else {
            list.forEach((name) => {
              const image = (overrideExerciseImages && overrideExerciseImages[name])
                || (exerciseImageMap && exerciseImageMap[name])
                || (programImageMap && programImageMap[selectedProgram])
                || '';
              const video = (exerciseVideoMap && exerciseVideoMap[name]) || '';
              const item = document.createElement('div');
              item.className = 'fp-exercise-item';
              const hasThumb = !!image;
              if (!hasThumb) {
                item.classList.add('no-thumb');
              }
              if (video) {
                item.classList.add('has-video');
                item.dataset.video = video;
                item.dataset.exercise = name;
              }
              if (hasThumb) {
                const thumb = document.createElement('div');
                thumb.className = 'fp-exercise-thumb';
                thumb.style.backgroundImage = `url('${image}')`;
                item.appendChild(thumb);
              }
              const label = document.createElement('div');
              label.className = 'fp-exercise-name';
              label.textContent = name;
              const actionWrap = document.createElement('div');
              actionWrap.className = 'fp-exercise-row-action';
              actionWrap.appendChild(label);
              const addBtn = document.createElement('button');
              addBtn.type = 'button';
              addBtn.className = 'fitness-btn fitness-btn-soft fp-exercise-action';
              addBtn.textContent = '+ Ajouter à ma séance';
              addBtn.addEventListener('click', (evt) => {
                evt.stopPropagation();
                if (!sessionExercises.find((e) => e.name === name)) {
                  sessionExercises.push({ name, video });
                  renderSessionPanel();
                }
              });
              actionWrap.appendChild(addBtn);
              item.appendChild(actionWrap);
              item.addEventListener('click', () => {
                resetHiit();
                startHiit();
                if (!video) return;
                const source = normalizeVideoSource(video);
                const opened = openVideoModalWithSource(source, {
                  title: 'Video de l’exercice',
                  subtitle: `${selectedProgram} - ${selectedPlace}`,
                  name
                });
                if (!opened) {
                  alert('Impossible d\'ouvrir cette video en incrustation.');
                }
              });
              exerciseList.appendChild(item);
            });
          }
        }

        exerciseModal.classList.add('is-open');
        exerciseModal.setAttribute('aria-hidden', 'false');
      };

      const closeExerciseModal = () => {
        exerciseModal.classList.remove('is-open');
        exerciseModal.setAttribute('aria-hidden', 'true');
      };

      cards.forEach((card) => {
        card.addEventListener('click', () => openModal(card.dataset.program || 'Programme'));
      });

      if (modalClose) modalClose.addEventListener('click', closeModal);
      if (levelClose) levelClose.addEventListener('click', closeLevelModal);
      if (exerciseClose) exerciseClose.addEventListener('click', closeExerciseModal);
      if (videoClose) {
        videoClose.addEventListener('click', () => {
          closeVideoModal();
        });
      }

      if (gymCard) {
        gymCard.addEventListener('click', () => openLevelModal('À la salle de sport'));
      }
      if (homeCard) {
        homeCard.addEventListener('click', () => openLevelModal('Chez soi'));
      }

      levelCards.forEach((card) => {
        card.addEventListener('click', () => openExerciseModal(card.dataset.level || 'Niveau'));
      });

      modal.addEventListener('click', (event) => {
        if (event.target === modal) {
          closeModal();
        }
      });

      levelModal.addEventListener('click', (event) => {
        if (event.target === levelModal) {
          closeLevelModal();
        }
      });

      exerciseModal.addEventListener('click', (event) => {
        if (event.target === exerciseModal) {
          closeExerciseModal();
        }
      });

      if (videoModal) {
        videoModal.addEventListener('click', (event) => {
          if (event.target === videoModal) {
            closeVideoModal();
          }
        });
      }

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeModal();
          closeLevelModal();
          closeExerciseModal();
          if (videoModal && videoModal.classList.contains('is-open')) {
            closeVideoModal();
          }
        }
      });

      const hiitStart = document.getElementById('hiit-start');
      const hiitPause = document.getElementById('hiit-pause');
      const hiitReset = document.getElementById('hiit-reset');
      const hiitMusicToggle = document.getElementById('hiit-music-toggle');
      const hiitNextTrack = document.getElementById('hiit-next-track');
      const hiitMute = document.getElementById('hiit-mute');
      const hiitCoachToggle = document.getElementById('hiit-coach-toggle');
      const hiitCoachLine = document.getElementById('hiit-coach-line');
      const hiitPhaseLabel = document.getElementById('hiit-phase-label');
      const hiitRoundLabel = document.getElementById('hiit-round-label');
      const hiitRoundMeta = document.getElementById('hiit-round-meta');
      const hiitTimeRemaining = document.getElementById('hiit-time-remaining');
      const hiitTrackLabel = document.getElementById('hiit-track-label');
      const hiitPlaylist = document.getElementById('hiit-playlist');
      const hiitVolume = document.getElementById('hiit-volume');
      const hiitVolumeLabel = document.getElementById('hiit-volume-label');
      const hiitMusicAudio = document.getElementById('hiit-music-audio');
      const hiitBeepAudio = document.getElementById('hiit-beep-audio');
      const hiitWorkSeconds = 30;
      const hiitRestSeconds = 15;
      const hiitRounds = 8;
      const hiitWorkVolume = 0.8;
      const hiitRestVolume = 0.3;
      const hiitStretchVolume = 0.2;

      const hiitPlaylists = [
        { id: 'hiit', label: 'HIIT Boost', src: '{{ asset("audio/hiit.mp3") }}' },
        { id: 'strength', label: 'Strength Power', src: '{{ asset("audio/strength.mp3") }}' },
        { id: 'chill', label: 'Chill Stretch', src: '{{ asset("audio/chill.m4a") }}' },
        { id: 'cardio', label: 'Cardio Run', src: '{{ asset("audio/cardio.mp3") }}' }
      ];

      let hiitPhase = 'work';
      let hiitRemaining = hiitWorkSeconds;
      let hiitRound = 1;
      let hiitIsDone = false;
      let hiitTimerId = null;
      let hiitMasterVolume = 1;
      let hiitMuted = false;
      let hiitPlaylistIndex = 0;
      let hiitBeepCtx = null;
      let hiitCoachEnabled = true;
      let hiitCoachVoice = null;
      const hiitCoachCueRegistry = new Set();
      const hiitSpeechSupported = typeof window.speechSynthesis !== 'undefined' && typeof window.SpeechSynthesisUtterance !== 'undefined';

      const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
      const formatClock = (seconds) => {
        const safe = Math.max(0, Number(seconds) || 0);
        const mins = Math.floor(safe / 60);
        const secs = safe % 60;
        return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
      };

      const updateMusicToggleLabel = () => {
        if (!hiitMusicToggle || !hiitMusicAudio) return;
        hiitMusicToggle.textContent = hiitMusicAudio.paused ? 'Music Play' : 'Music Pause';
      };

      const updateMuteLabel = () => {
        if (!hiitMute) return;
        hiitMute.textContent = hiitMuted ? 'Unmute' : 'Mute';
      };

      const updateCoachToggleLabel = () => {
        if (!hiitCoachToggle) return;
        hiitCoachToggle.textContent = hiitCoachEnabled ? 'Coach IA On' : 'Coach IA Off';
      };

      const setCoachLine = (message) => {
        if (!hiitCoachLine) return;
        hiitCoachLine.textContent = `Coach IA: ${message}`;
      };

      const getPlaylistIndexById = (id) => hiitPlaylists.findIndex((entry) => entry.id === id);

      const pickCoachVoice = () => {
        if (!hiitSpeechSupported) return;
        const voices = window.speechSynthesis.getVoices();
        if (!Array.isArray(voices) || voices.length === 0) return;
        hiitCoachVoice = voices.find((voice) => String(voice.lang || '').toLowerCase().startsWith('fr'))
          || voices.find((voice) => String(voice.lang || '').toLowerCase().startsWith('en'))
          || voices[0]
          || null;
      };

      const stopCoachSpeech = () => {
        if (!hiitSpeechSupported) return;
        window.speechSynthesis.cancel();
      };

      const speakCoach = (message, options = {}) => {
        const text = String(message || '').trim();
        if (!text) return;

        setCoachLine(text);
        if (!hiitCoachEnabled || hiitMuted || !hiitSpeechSupported) return;

        const shouldInterrupt = options.interrupt !== false;
        if (shouldInterrupt) {
          window.speechSynthesis.cancel();
        }

        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'fr-FR';
        utterance.rate = hiitPhase === 'rest' || hiitPhase === 'stretch' ? 0.98 : 1.05;
        utterance.pitch = 1;
        utterance.volume = clamp(hiitMasterVolume * 1.35, 0.45, 1);
        if (hiitCoachVoice) {
          utterance.voice = hiitCoachVoice;
        }
        window.speechSynthesis.speak(utterance);
      };

      const speakCoachOnce = (key, message, options = {}) => {
        if (hiitCoachCueRegistry.has(key)) return;
        hiitCoachCueRegistry.add(key);
        speakCoach(message, options);
      };

      const resetCoachCues = () => {
        hiitCoachCueRegistry.clear();
      };

      const getHiitPhaseMultiplier = () => {
        if (hiitPhase === 'rest') return hiitRestVolume;
        if (hiitPhase === 'stretch') return hiitStretchVolume;
        if (hiitPhase === 'work' && hiitRound >= hiitRounds) {
          return Math.min(1, hiitWorkVolume + 0.12);
        }
        return hiitWorkVolume;
      };

      const applyHiitVolumes = () => {
        if (hiitMusicAudio) {
          // Auto-duck music volume in REST and restore it in WORK.
          const computedMusicVolume = hiitMuted ? 0 : clamp(hiitMasterVolume * getHiitPhaseMultiplier(), 0, 1);
          hiitMusicAudio.volume = computedMusicVolume;
          hiitMusicAudio.muted = hiitMuted;
        }
        if (hiitBeepAudio) {
          hiitBeepAudio.volume = hiitMuted ? 0 : clamp(hiitMasterVolume, 0, 1);
          hiitBeepAudio.muted = hiitMuted;
        }
        if (hiitVolumeLabel) {
          hiitVolumeLabel.textContent = `${Math.round(hiitMasterVolume * 100)}%`;
        }
      };

      const renderHiit = () => {
        // Keep volume in sync with current phase at every render/tick.
        applyHiitVolumes();

        if (hiitPhaseLabel) {
          const phaseText = hiitPhase === 'stretch'
            ? 'STRETCH'
            : (hiitIsDone ? 'DONE' : (hiitPhase === 'work' ? 'WORK' : 'REST'));
          hiitPhaseLabel.textContent = phaseText;
          hiitPhaseLabel.classList.remove('is-work', 'is-rest', 'is-done', 'is-stretch');
          if (phaseText === 'WORK') hiitPhaseLabel.classList.add('is-work');
          if (phaseText === 'REST') hiitPhaseLabel.classList.add('is-rest');
          if (phaseText === 'DONE') hiitPhaseLabel.classList.add('is-done');
          if (phaseText === 'STRETCH') hiitPhaseLabel.classList.add('is-stretch');
        }
        if (hiitTimeRemaining) {
          hiitTimeRemaining.textContent = formatClock(hiitRemaining);
        }
        const roundText = `${Math.min(hiitRound, hiitRounds)}/${hiitRounds}`;
        if (hiitRoundLabel) hiitRoundLabel.textContent = roundText;
        if (hiitRoundMeta) hiitRoundMeta.textContent = roundText;
        if (hiitTrackLabel && hiitPlaylists[hiitPlaylistIndex]) {
          hiitTrackLabel.textContent = hiitPlaylists[hiitPlaylistIndex].label;
        }
      };

      const playHiitMusic = () => {
        if (!hiitMusicAudio) return;
        applyHiitVolumes();
        hiitMusicAudio.play().catch(() => {
          // Ignore autoplay errors if browser blocks playback.
        });
      };

      const pauseHiitMusic = () => {
        if (!hiitMusicAudio) return;
        hiitMusicAudio.pause();
      };

      const stopHiitMusic = () => {
        if (!hiitMusicAudio) return;
        hiitMusicAudio.pause();
        hiitMusicAudio.currentTime = 0;
      };

      const stopHiitTimer = () => {
        if (!hiitTimerId) return;
        clearInterval(hiitTimerId);
        hiitTimerId = null;
      };

      const playHiitBeep = () => {
        if (hiitMuted || hiitMasterVolume <= 0) return;

        const playHiitFallbackBeep = () => {
          const AudioContextCtor = window.AudioContext || window.webkitAudioContext;
          if (!AudioContextCtor) return;

          if (!hiitBeepCtx) {
            hiitBeepCtx = new AudioContextCtor();
          }

          if (hiitBeepCtx.state === 'suspended') {
            hiitBeepCtx.resume().catch(() => {});
          }

          const now = hiitBeepCtx.currentTime;
          const oscillator = hiitBeepCtx.createOscillator();
          const gainNode = hiitBeepCtx.createGain();
          const maxBeepVolume = Math.max(0.001, clamp(hiitMasterVolume * 0.35, 0, 1));

          oscillator.type = 'sine';
          oscillator.frequency.setValueAtTime(880, now);
          gainNode.gain.setValueAtTime(0.0001, now);
          gainNode.gain.exponentialRampToValueAtTime(maxBeepVolume, now + 0.01);
          gainNode.gain.exponentialRampToValueAtTime(0.0001, now + 0.14);

          oscillator.connect(gainNode);
          gainNode.connect(hiitBeepCtx.destination);
          oscillator.start(now);
          oscillator.stop(now + 0.15);
        };

        if (!hiitBeepAudio) {
          playHiitFallbackBeep();
          return;
        }

        hiitBeepAudio.currentTime = 0;
        const playPromise = hiitBeepAudio.play();
        if (playPromise && typeof playPromise.catch === 'function') {
          playPromise.catch(() => {
            playHiitFallbackBeep();
          });
        }
      };

      const setHiitPlaylistByIndex = (nextIndex, keepPlayback) => {
        if (!hiitMusicAudio || hiitPlaylists.length === 0) return;
        const boundedIndex = ((nextIndex % hiitPlaylists.length) + hiitPlaylists.length) % hiitPlaylists.length;
        const shouldResume = Boolean(keepPlayback && !hiitMusicAudio.paused);
        hiitPlaylistIndex = boundedIndex;
        hiitMusicAudio.pause();
        hiitMusicAudio.src = hiitPlaylists[hiitPlaylistIndex].src;
        hiitMusicAudio.currentTime = 0;
        hiitMusicAudio.load();
        applyHiitVolumes();
        renderHiit();
        if (hiitPlaylist) {
          hiitPlaylist.value = hiitPlaylists[hiitPlaylistIndex].id;
        }
        if (shouldResume) {
          hiitMusicAudio.play().catch(() => {
            // Ignore autoplay errors after changing playlist.
          });
        }
        updateMusicToggleLabel();
      };

      const completeHiitSession = () => {
        stopHiitTimer();
        hiitIsDone = true;
        hiitPhase = 'stretch';
        hiitRemaining = 0;

        const chillIndex = getPlaylistIndexById('chill');
        if (chillIndex >= 0 && chillIndex !== hiitPlaylistIndex) {
          setHiitPlaylistByIndex(chillIndex, true);
        } else {
          applyHiitVolumes();
          playHiitMusic();
        }

        speakCoachOnce('session-complete', 'Session terminee. Stretching calme, respire.');
        renderHiit();
        updateMusicToggleLabel();
      };

      const switchHiitPhase = () => {
        playHiitBeep();

        if (hiitPhase === 'work') {
          if (hiitRound >= hiitRounds) {
            completeHiitSession();
            return;
          }
          hiitPhase = 'rest';
          hiitRemaining = hiitRestSeconds;
          speakCoachOnce(`rest-${hiitRound}-start`, `Repose-toi maintenant ${hiitRestSeconds} secondes.`);
        } else {
          hiitPhase = 'work';
          hiitRound += 1;
          hiitRemaining = hiitWorkSeconds;
          if (hiitRound >= hiitRounds) {
            const cardioIndex = getPlaylistIndexById('cardio');
            if (cardioIndex >= 0 && cardioIndex !== hiitPlaylistIndex) {
              setHiitPlaylistByIndex(cardioIndex, true);
            }
            speakCoachOnce(`work-${hiitRound}-start-final`, 'Dernier effort !');
          } else {
            speakCoachOnce(`work-${hiitRound}-start`, 'Go !');
          }
        }

        applyHiitVolumes();
        renderHiit();
      };

      const emitHiitCoachCues = () => {
        if (hiitIsDone) return;

        if (hiitPhase === 'work') {
          const halfThreshold = Math.max(12, Math.floor(hiitWorkSeconds / 2));
          if (hiitRemaining === halfThreshold) {
            speakCoachOnce(`work-${hiitRound}-rhythm`, 'Tres bon rythme.');
          }
          if (hiitRemaining === 10) {
            speakCoachOnce(`work-${hiitRound}-10`, 'Encore 10 secondes.');
          }
          if (hiitRemaining === 6) {
            speakCoachOnce(`work-${hiitRound}-breath`, 'Respire.');
          }
          return;
        }

        if (hiitPhase === 'rest' && hiitRemaining === 3) {
          speakCoachOnce(`rest-${hiitRound}-3`, 'On repart dans 3 secondes.');
        }
      };

      const tickHiit = () => {
        if (hiitIsDone) return;
        if (hiitRemaining > 1) {
          hiitRemaining -= 1;
          renderHiit();
          emitHiitCoachCues();
          return;
        }
        switchHiitPhase();
      };

      const startHiit = () => {
        if (hiitTimerId) return;
        if (hiitIsDone) {
          hiitIsDone = false;
          hiitPhase = 'work';
          hiitRound = 1;
          hiitRemaining = hiitWorkSeconds;
        }

        // Prime WebAudio during user gesture so fallback beep can play later.
        if (!hiitBeepCtx) {
          const AudioContextCtor = window.AudioContext || window.webkitAudioContext;
          if (AudioContextCtor) {
            hiitBeepCtx = new AudioContextCtor();
          }
        }
        if (hiitBeepCtx && hiitBeepCtx.state === 'suspended') {
          hiitBeepCtx.resume().catch(() => {});
        }
        if (hiitSpeechSupported && window.speechSynthesis.paused) {
          window.speechSynthesis.resume();
        }

        applyHiitVolumes();
        renderHiit();
        playHiitMusic();
        hiitTimerId = setInterval(tickHiit, 1000);

        if (hiitPhase === 'work' && hiitRound >= hiitRounds) {
          const cardioIndex = getPlaylistIndexById('cardio');
          if (cardioIndex >= 0 && cardioIndex !== hiitPlaylistIndex) {
            setHiitPlaylistByIndex(cardioIndex, true);
          }
          speakCoachOnce(`work-${hiitRound}-start-final`, 'Dernier effort !');
          return;
        }

        if (hiitPhase === 'rest') {
          if (hiitRemaining >= hiitRestSeconds) {
            speakCoachOnce(`rest-${hiitRound}-start`, `Repose-toi maintenant ${Math.max(1, hiitRemaining)} secondes.`);
          } else {
            speakCoach('On repart.');
          }
          return;
        }

        if (hiitRemaining >= hiitWorkSeconds) {
          speakCoachOnce(`work-${hiitRound}-start`, 'Go !');
        } else {
          speakCoach('On repart.');
        }
      };

      const pauseHiit = () => {
        stopHiitTimer();
        pauseHiitMusic();
        stopCoachSpeech();
        setCoachLine('pause.');
        updateMusicToggleLabel();
      };

      const resetHiit = () => {
        stopHiitTimer();
        stopHiitMusic();
        stopCoachSpeech();
        resetCoachCues();
        hiitPhase = 'work';
        hiitRound = 1;
        hiitRemaining = hiitWorkSeconds;
        hiitIsDone = false;
        hiitMasterVolume = 1;
        hiitMuted = false;
        if (hiitVolume) hiitVolume.value = '1';
        setCoachLine('pret.');
        updateMuteLabel();
        applyHiitVolumes();
        renderHiit();
        updateMusicToggleLabel();
      };

      const forceStopHiitAndMusic = () => {
        resetHiit();
      };

      if (hiitStart) hiitStart.addEventListener('click', startHiit);
      if (hiitPause) hiitPause.addEventListener('click', pauseHiit);
      if (hiitReset) hiitReset.addEventListener('click', resetHiit);

      if (hiitMusicToggle) {
        hiitMusicToggle.addEventListener('click', () => {
          if (!hiitMusicAudio) return;
          if (hiitMusicAudio.paused) {
            playHiitMusic();
          } else {
            pauseHiitMusic();
          }
          updateMusicToggleLabel();
        });
      }

      if (hiitNextTrack) {
        hiitNextTrack.addEventListener('click', () => {
          setHiitPlaylistByIndex(hiitPlaylistIndex + 1, true);
        });
      }

      if (hiitPlaylist) {
        hiitPlaylist.addEventListener('change', () => {
          const nextIndex = hiitPlaylists.findIndex((entry) => entry.id === hiitPlaylist.value);
          if (nextIndex < 0) return;
          setHiitPlaylistByIndex(nextIndex, true);
        });
      }

      if (hiitVolume) {
        hiitVolume.addEventListener('input', () => {
          hiitMasterVolume = clamp(parseFloat(hiitVolume.value || '1'), 0, 1);
          applyHiitVolumes();
        });
      }

      if (hiitMute) {
        hiitMute.addEventListener('click', () => {
          hiitMuted = !hiitMuted;
          updateMuteLabel();
          applyHiitVolumes();
          if (hiitMuted) {
            stopCoachSpeech();
          }
        });
      }

      if (hiitCoachToggle) {
        hiitCoachToggle.addEventListener('click', () => {
          hiitCoachEnabled = !hiitCoachEnabled;
          updateCoachToggleLabel();
          if (!hiitCoachEnabled) {
            stopCoachSpeech();
            setCoachLine('desactive.');
            return;
          }
          setCoachLine('active.');
          speakCoach('Coach IA active.');
        });
      }

      if (hiitMusicAudio) {
        hiitMusicAudio.addEventListener('play', updateMusicToggleLabel);
        hiitMusicAudio.addEventListener('pause', updateMusicToggleLabel);
        hiitMusicAudio.addEventListener('play', applyHiitVolumes);
        hiitMusicAudio.addEventListener('timeupdate', applyHiitVolumes);
        hiitMusicAudio.addEventListener('loadedmetadata', applyHiitVolumes);
      }

      if (hiitSpeechSupported) {
        pickCoachVoice();
        if (typeof window.speechSynthesis.addEventListener === 'function') {
          window.speechSynthesis.addEventListener('voiceschanged', pickCoachVoice);
        } else {
          window.speechSynthesis.onvoiceschanged = pickCoachVoice;
        }
      } else {
        setCoachLine('mode texte (voix indisponible).');
      }

      updateCoachToggleLabel();
      updateMuteLabel();
      setHiitPlaylistByIndex(0, false);
      resetHiit();

      const renderSessionPanel = () => {
        if (!sessionCount || !sessionTime || !sessionList) return;
        sessionCount.textContent = `${sessionExercises.length} exercices`;
        const estimatedSeconds = sessionExercises.length * 90;
        const mins = Math.max(0, Math.ceil(estimatedSeconds / 60));
        sessionTime.textContent = `Temps estimé : ${mins} min`;
        sessionList.innerHTML = '';
        sessionExercises.forEach((ex) => {
          const row = document.createElement('div');
          row.className = 'fp-session-item';
          row.textContent = ex.name;
          sessionList.appendChild(row);
        });
      };

      const setTrendsStatus = (message) => {
        if (trendsStatus) {
          trendsStatus.textContent = message;
        }
      };

      const createTrendCard = (trend) => {
        const card = document.createElement('article');
        card.className = 'trend-card';

        const thumb = document.createElement('div');
        thumb.className = 'trend-thumb';
        if (trend.imageUrl) {
          thumb.style.backgroundImage = `url("${trend.imageUrl}")`;
        }
        card.appendChild(thumb);

        const body = document.createElement('div');
        body.className = 'trend-body';

        const category = document.createElement('div');
        category.className = 'trend-category';
        category.textContent = trend.category || 'Tendance';
        body.appendChild(category);

        const title = document.createElement('h3');
        title.className = 'trend-title';
        title.textContent = trend.title || 'Sans titre';
        body.appendChild(title);

        if (trend.description) {
          const description = document.createElement('div');
          description.className = 'program-meta';
          description.textContent = trend.description;
          body.appendChild(description);
        }

        card.appendChild(body);
        return card;
      };

      const renderTrends = (items, query) => {
        if (!trendsGrid) return;
        trendsGrid.innerHTML = '';

        if (!Array.isArray(items) || items.length === 0) {
          const empty = document.createElement('div');
          empty.className = 'program-card';

          const title = document.createElement('div');
          title.className = 'program-title';
          title.textContent = 'Aucune tendance disponible';

          const meta = document.createElement('div');
          meta.className = 'program-meta';
          meta.textContent = query
            ? `Aucune tendance en cours pour "${query}".`
            : 'Ajoute-les depuis l’admin.';

          empty.appendChild(title);
          empty.appendChild(meta);
          trendsGrid.appendChild(empty);
          return;
        }

        items.forEach((trend) => {
          trendsGrid.appendChild(createTrendCard(trend));
        });
      };

      const refreshTrends = () => {
        if (!trendsGrid) return;
        const query = String(trendsQueryInput?.value || '').trim().toLowerCase();
        const items = !query
          ? allTrends
          : allTrends.filter((trend) => {
              const title = String(trend.title || '').toLowerCase();
              const category = String(trend.category || '').toLowerCase();
              const description = String(trend.description || '').toLowerCase();
              return title.includes(query) || category.includes(query) || description.includes(query);
            });
        renderTrends(items, query);
        const count = items.length;
        const label = count > 1 ? 'tendances' : 'tendance';
        const suffix = query ? ` pour "${query}"` : '';
        setTrendsStatus(`${count} ${label} en cours${suffix}.`);
      };

      if (trendsQueryInput) {
        trendsQueryInput.addEventListener('input', () => {
          if (trendsFetchDebounce) {
            clearTimeout(trendsFetchDebounce);
          }
          trendsFetchDebounce = window.setTimeout(() => {
            refreshTrends();
          }, 250);
        });
        trendsQueryInput.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter') return;
          event.preventDefault();
          if (trendsFetchDebounce) {
            clearTimeout(trendsFetchDebounce);
            trendsFetchDebounce = null;
          }
          refreshTrends();
        });
      }

      if (trendsRefreshBtn) {
        trendsRefreshBtn.addEventListener('click', () => {
          refreshTrends();
        });
      }

      if (trendsGrid) {
        refreshTrends();
      }


      const exploreFeed = document.getElementById('fp-explore-feed');
      const exploreCount = document.getElementById('fp-explore-count');
      const exploreFill = document.getElementById('fp-explore-fill');
      const exploreAiQuery = document.getElementById('fp-explore-ai-query');
      const exploreAiGenerate = document.getElementById('fp-explore-ai-generate');
      const exploreFavorites = new Set();
      let exploreTryInterval = null;
      let exploreTryButton = null;

      const aiVideoLibrary = [
        { name: 'Poitrine Builder', muscle: 'Poitrine', difficulty: 'Beginner', duration: 6, tip: 'Controle la descente et stabilise les epaules.', video: 'https://www.youtube.com/watch?v=IODxDxX7oi4', tags: ['poitrine', 'chest', 'pompes'] },
        { name: 'Dos Strong Flow', muscle: 'Dos', difficulty: 'Intermediate', duration: 7, tip: 'Garde la colonne neutre pendant le tirage.', video: 'https://www.youtube.com/watch?v=roCP6wCXPqo', tags: ['dos', 'back', 'posture'] },
        { name: 'Jambes Power', muscle: 'Jambes', difficulty: 'Intermediate', duration: 8, tip: 'Pousse avec les talons sur les squats.', video: 'https://www.youtube.com/watch?v=aclHkVaku9U', tags: ['jambes', 'legs', 'squat'] },
        { name: 'Fessier Focus', muscle: 'Fessier', difficulty: 'Beginner', duration: 7, tip: 'Contracte les fessiers en haut du mouvement.', video: 'https://www.youtube.com/watch?v=Xyd_fa5zoEU', tags: ['fessier', 'glutes', 'hip thrust'] },
        { name: 'Epaules Sculpt', muscle: 'Epaules', difficulty: 'Intermediate', duration: 6, tip: 'Ne monte pas les epaules vers les oreilles.', video: 'https://www.youtube.com/watch?v=qEwKCR5JCog', tags: ['epaules', 'shoulders', 'deltoides'] },
        { name: 'Biceps Pump', muscle: 'Biceps', difficulty: 'Beginner', duration: 5, tip: 'Garde les coudes fixes pres du corps.', video: 'https://www.youtube.com/watch?v=ykJmrZ5v0Oo', tags: ['biceps', 'bras', 'curl'] },
        { name: 'Triceps Burn', muscle: 'Triceps', difficulty: 'Beginner', duration: 5, tip: 'Amplitude complete et mouvement controle.', video: 'https://www.youtube.com/watch?v=nRiJVZDpdL0', tags: ['triceps', 'bras', 'dips'] },
        { name: 'Avant-bras Grip', muscle: 'Avant-bras', difficulty: 'Intermediate', duration: 5, tip: 'Travaille en prise lente pour le grip.', video: 'https://www.youtube.com/watch?v=Ej4WzltO1DA', tags: ['avant-bras', 'forearm', 'grip'] },
        { name: 'Abdos Core 10', muscle: 'Abdos', difficulty: 'Beginner', duration: 6, tip: 'Garde le bas du dos colle au sol.', video: 'https://www.youtube.com/watch?v=AnYl6Nk9GOA', tags: ['abdos', 'core', 'ventre', 'gainage'] },
        { name: 'Corps Entier HIIT', muscle: 'Corps entier', difficulty: 'Intermediate', duration: 10, tip: 'Reste dynamique, respire en rythme.', video: 'https://www.youtube.com/watch?v=ml6cT4AZdqI', tags: ['corps entier', 'full body', 'hiit'] }
      ];
      const aiFeedState = new Map();
      const aiVideoValidationCache = new Map();
      const aiTagAliases = {
        abdos: ['abdos', 'core', 'ventre', 'ventre plat', 'gainage', 'plank', 'lower abs', 'stomach'],
        ventre: ['abdos', 'core', 'ventre', 'ventre plat', 'gainage'],
        gainage: ['gainage', 'plank', 'core', 'abdos'],
        cardio: ['cardio', 'hiit', 'endurance', 'corde'],
        jambes: ['jambes', 'squat', 'fessier', 'legs'],
        dos: ['dos', 'posture', 'back', 'mobilite'],
        poitrine: ['poitrine', 'pompes', 'chest', 'bras'],
        souplesse: ['souplesse', 'mobilite', 'yoga', 'stretch']
      };

      const shuffleArray = (items) => {
        const list = [...items];
        for (let i = list.length - 1; i > 0; i -= 1) {
          const j = Math.floor(Math.random() * (i + 1));
          [list[i], list[j]] = [list[j], list[i]];
        }
        return list;
      };

      const buildRemainingQueue = (pool, lastBatchNames = []) => {
        const lastSet = new Set(lastBatchNames);
        const fresh = shuffleArray(pool.filter((entry) => !lastSet.has(entry.name)));
        const fallback = shuffleArray(pool.filter((entry) => lastSet.has(entry.name)));
        return [...fresh, ...fallback];
      };

      const getExploreSlides = () => (exploreFeed ? Array.from(exploreFeed.querySelectorAll('.explore-slide')) : []);

      const extractYoutubeId = (rawUrl) => {
        if (!rawUrl) return '';
        const value = String(rawUrl).trim();
        const shortMatch = value.match(/youtu\.be\/([A-Za-z0-9_-]{6,})/i);
        if (shortMatch) return shortMatch[1];
        const watchMatch = value.match(/[?&]v=([A-Za-z0-9_-]{6,})/i);
        if (watchMatch) return watchMatch[1];
        const shortsMatch = value.match(/youtube\.com\/shorts\/([A-Za-z0-9_-]{6,})/i);
        if (shortsMatch) return shortsMatch[1];
        const embedMatch = value.match(/youtube\.com\/embed\/([A-Za-z0-9_-]{6,})/i);
        if (embedMatch) return embedMatch[1];
        return '';
      };

      const buildYoutubeWatchUrl = (youtubeId) => (youtubeId ? `https://www.youtube.com/watch?v=${youtubeId}` : '');

      const normalizeVideoSource = (rawUrl) => {
        const value = String(rawUrl || '').trim();
        if (!value) return { type: 'none', src: '', openUrl: '', youtubeId: '' };
        const youtubeId = extractYoutubeId(value);
        if (youtubeId) {
          const src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&mute=1&controls=1&loop=1&playlist=${youtubeId}&playsinline=1&modestbranding=1&rel=0`;
          return { type: 'youtube', src, openUrl: buildYoutubeWatchUrl(youtubeId), youtubeId };
        }
        if (/\.(mp4|webm|ogg)(\?|#|$)/i.test(value)) {
          return { type: 'video', src: value, openUrl: value, youtubeId: '' };
        }
        return { type: 'external', src: value, openUrl: value, youtubeId: '' };
      };

      const openExploreSource = (rawUrl) => {
        const source = normalizeVideoSource(rawUrl);
        const target = source.openUrl || source.src;
        if (!target) return false;
        const popup = window.open(target, '_blank', 'noopener');
        return !!popup;
      };

      const isYoutubeVideoAvailable = async (rawUrl) => {
        const source = normalizeVideoSource(rawUrl);
        if (source.type !== 'youtube') return source.type === 'video';
        if (aiVideoValidationCache.has(source.src)) {
          return aiVideoValidationCache.get(source.src);
        }
        try {
          const watchUrl = source.openUrl || rawUrl;
          const endpoint = `https://www.youtube.com/oembed?url=${encodeURIComponent(watchUrl)}&format=json`;
          const response = await fetch(endpoint, { method: 'GET' });
          const ok = response.ok;
          aiVideoValidationCache.set(source.src, ok);
          return ok;
        } catch (error) {
          aiVideoValidationCache.set(source.src, false);
          return false;
        }
      };

      const renderExploreMediaFallback = (media, source, message) => {
        media.innerHTML = '';
        const fallback = document.createElement('div');
        fallback.className = 'explore-media-fallback';

        const label = document.createElement('p');
        label.className = 'explore-media-fallback-label';
        label.textContent = message || 'Lecture indisponible pour le moment.';
        fallback.appendChild(label);

        const actions = document.createElement('div');
        actions.className = 'explore-media-fallback-actions';

        if (source.openUrl) {
          const openBtn = document.createElement('button');
          openBtn.type = 'button';
          openBtn.className = 'explore-fallback-btn';
          openBtn.dataset.action = 'open-source';
          openBtn.textContent = 'Ouvrir la video';
          actions.appendChild(openBtn);
        }

        if (source.type === 'youtube' || source.type === 'video') {
          const retryBtn = document.createElement('button');
          retryBtn.type = 'button';
          retryBtn.className = 'explore-fallback-btn';
          retryBtn.dataset.action = 'retry-media';
          retryBtn.textContent = 'Reessayer';
          actions.appendChild(retryBtn);
        }

        if (actions.childNodes.length) {
          fallback.appendChild(actions);
        }

        media.appendChild(fallback);
      };

      const renderExploreMedia = (slide) => {
        const media = slide.querySelector('.explore-media');
        if (!media) return;

        const videoUrl = slide.dataset.video || '';
        const imageUrl = slide.dataset.image || '';
        const source = normalizeVideoSource(videoUrl);

        if (source.type === 'youtube') {
          media.innerHTML = '';
          const iframe = document.createElement('iframe');
          iframe.src = source.src;
          iframe.title = 'Explore video';
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('allow', 'autoplay; encrypted-media');
          iframe.setAttribute('allowfullscreen', 'allowfullscreen');
          iframe.setAttribute('loading', 'lazy');
          iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
          media.appendChild(iframe);

          let loaded = false;
          const timer = window.setTimeout(() => {
            if (loaded) return;
            renderExploreMediaFallback(media, source, 'Video YouTube lente ou bloquee. Ouvre-la directement.');
          }, 7000);

          iframe.addEventListener('load', () => {
            loaded = true;
            clearTimeout(timer);
          }, { once: true });
          return;
        }

        if (source.type === 'video') {
          media.innerHTML = '';
          const video = document.createElement('video');
          video.src = source.src;
          video.autoplay = true;
          video.muted = true;
          video.loop = true;
          video.playsInline = true;
          video.controls = true;
          video.preload = 'metadata';
          video.addEventListener('error', () => {
            renderExploreMediaFallback(media, source, 'Lecture video impossible. Ouvre la source ou reessaye.');
          }, { once: true });
          video.addEventListener('stalled', () => {
            renderExploreMediaFallback(media, source, 'Video en attente trop longue. Ouvre la source ou reessaye.');
          }, { once: true });
          media.appendChild(video);
          return;
        }

        if (source.type === 'external') {
          renderExploreMediaFallback(media, source, 'Source externe detectee. Ouvre la video directement.');
          return;
        }

        if (imageUrl) {
          media.innerHTML = `<img src="${imageUrl}" alt="${slide.dataset.name || 'Exercise'}">`;
          return;
        }

        media.innerHTML = '';
      };

      const createExploreSlide = (item) => {
        const article = document.createElement('article');
        article.className = 'explore-slide';
        article.dataset.name = item.name || 'Exercise';
        article.dataset.video = item.video || '';
        article.dataset.image = item.image || '';
        article.dataset.description = item.tip || 'Garde le dos droit et controle le mouvement.';
        article.dataset.muscle = item.muscle || 'Corps entier';
        article.dataset.difficulty = item.difficulty || 'Beginner';
        article.dataset.duration = String(item.duration || 3);
        article.innerHTML = `
          <div class="explore-media"></div>
          <div class="explore-overlay"></div>
          <div class="explore-content">
            <div class="explore-top">
              <h3>${item.name || 'Exercise'}</h3>
              <div class="explore-badges">
                <span class="explore-badge">${item.muscle || 'Corps entier'}</span>
                <span class="explore-badge">${item.difficulty || 'Beginner'}</span>
                <span class="explore-badge">Sans materiel</span>
              </div>
              <div class="explore-meta">~${item.duration || 3} min a maitriser</div>
            </div>
            <p class="explore-tip">${item.tip || 'Garde le dos droit et controle le mouvement.'}</p>
            <div class="explore-actions">
              <button type="button" class="explore-btn" data-action="favorite">&#10084; Favori</button>
              <button type="button" class="explore-btn" data-action="add">+ Ajouter au plan</button>
              <button type="button" class="explore-btn" data-action="try">30s Essayer</button>
              <button type="button" class="explore-btn" data-action="details">i Details</button>
            </div>
          </div>
        `;
        renderExploreMedia(article);
        return article;
      };

      const stopExploreTryTimer = () => {
        if (exploreTryInterval) {
          clearInterval(exploreTryInterval);
          exploreTryInterval = null;
        }
        if (exploreTryButton) {
          exploreTryButton.textContent = '30s Essayer';
          exploreTryButton.disabled = false;
          exploreTryButton = null;
        }
      };

      const updateExploreProgress = () => {
        const exploreSlides = getExploreSlides();
        if (!exploreFeed || exploreSlides.length === 0) return;
        const rawIndex = Math.round(exploreFeed.scrollTop / Math.max(1, exploreFeed.clientHeight));
        const index = Math.min(Math.max(rawIndex, 0), exploreSlides.length - 1);
        if (exploreCount) {
          exploreCount.textContent = `${index + 1}/${exploreSlides.length}`;
        }
        if (exploreFill) {
          const ratio = (index + 1) / exploreSlides.length;
          exploreFill.style.height = `${Math.max(6, Math.round(ratio * 100))}%`;
        }
      };

      const openExploreDetails = (slide) => {
        const name = slide.dataset.name || 'Exercice';
        const muscle = slide.dataset.muscle || 'Corps entier';
        const difficulty = slide.dataset.difficulty || 'Beginner';
        const duration = slide.dataset.duration || '3';
        const description = slide.dataset.description || '';
        const video = slide.dataset.video || '';
        const source = normalizeVideoSource(video);

        if (source.type === 'video' || source.type === 'youtube') {
          resetHiit();
          startHiit();
          const opened = openVideoModalWithSource(source, {
            title: 'Explore - Details exercice',
            subtitle: `${muscle} - ${difficulty} - ~${duration} min`,
            name
          });
          if (!opened) {
            alert('Impossible d\'ouvrir cette video en incrustation.');
          }
          return;
        }

        if (source.type === 'external') {
          if (!openExploreSource(video)) {
            alert('Impossible d\'ouvrir cette source video.');
          }
          return;
        }

        alert(`${name}\n${muscle} - ${difficulty}\n~${duration} min\n\n${description}`);
      };

      if (exploreFeed) {
        getExploreSlides().forEach((slide) => renderExploreMedia(slide));
        exploreFeed.addEventListener('scroll', updateExploreProgress, { passive: true });
        updateExploreProgress();
      }

      window.addEventListener('resize', updateExploreProgress);

      if (exploreAiGenerate && exploreFeed) {
        exploreAiGenerate.addEventListener('click', async () => {
          const query = String(exploreAiQuery?.value || '').toLowerCase().trim();
          const baseTokens = query.split(/\s+/).filter(Boolean);
          const expandedTokens = new Set(baseTokens);
          baseTokens.forEach((token) => {
            (aiTagAliases[token] || []).forEach((alias) => expandedTokens.add(alias));
          });
          const tokens = Array.from(expandedTokens);
          const ranked = aiVideoLibrary
            .map((entry) => {
              let score = 0;
              tokens.forEach((token) => {
                if (entry.name.toLowerCase().includes(token)) score += 3;
                if (entry.muscle.toLowerCase().includes(token)) score += 4;
                if (entry.difficulty.toLowerCase().includes(token)) score += 2;
                if (entry.tags.some((tag) => tag.includes(token))) score += 5;
              });
              return { entry, score };
            })
            .sort((a, b) => b.score - a.score);

          const rawPool = (tokens.length ? ranked.filter((item) => item.score > 0) : ranked).map((item) => item.entry);
          const pool = rawPool.filter((entry) => {
            const srcType = normalizeVideoSource(entry.video).type;
            return srcType === 'youtube' || srcType === 'video';
          });
          if (pool.length === 0) {
            alert('Aucune video trouvee pour cette demande IA.');
            return;
          }

          const queryKey = tokens.length ? tokens.join('|') : '__all__';
          const poolSignature = pool.map((entry) => entry.name).join('|');
          let state = aiFeedState.get(queryKey);

          if (!state || state.poolSignature !== poolSignature) {
            state = {
              pool,
              poolSignature,
              remaining: buildRemainingQueue(pool, []),
              lastBatchNames: []
            };
            aiFeedState.set(queryKey, state);
          }

          const pickCount = Math.min(5, pool.length);
          const selected = [];
          let guard = 0;
          while (selected.length < pickCount && guard < pool.length * 5) {
            guard += 1;
            if (!state.remaining.length) {
              state.remaining = buildRemainingQueue(state.pool, state.lastBatchNames || []);
            }
            const next = state.remaining.shift();
            if (!next || selected.find((entry) => entry.name === next.name)) {
              continue;
            }
            const available = await isYoutubeVideoAvailable(next.video);
            if (!available) {
              continue;
            }
            selected.push(next);
          }

          if (selected.length === 0) {
            alert('Aucune video YouTube disponible pour cette demande.');
            return;
          }

          state.lastBatchNames = selected.map((entry) => entry.name);

          exploreFeed.innerHTML = '';
          selected.forEach((entry) => {
            exploreFeed.appendChild(createExploreSlide(entry));
          });
          exploreFeed.scrollTop = 0;
          updateExploreProgress();
        });
      }

      if (exploreFeed) {
        exploreFeed.addEventListener('click', (event) => {
          const actionBtn = event.target.closest('[data-action]');
          if (!actionBtn) return;
          const slide = actionBtn.closest('.explore-slide');
          if (!slide) return;

          const action = actionBtn.dataset.action;
          const exerciseName = slide.dataset.name || '';
          const exerciseVideo = slide.dataset.video || '';
          const source = normalizeVideoSource(exerciseVideo);

          if (action === 'retry-media') {
            renderExploreMedia(slide);
            return;
          }

          if (action === 'open-source') {
            if (!openExploreSource(exerciseVideo)) {
              alert('Source video indisponible.');
            }
            return;
          }

          if (action === 'favorite') {
            if (exploreFavorites.has(exerciseName)) {
              exploreFavorites.delete(exerciseName);
              actionBtn.classList.remove('is-active');
              actionBtn.setAttribute('aria-pressed', 'false');
              actionBtn.innerHTML = '&#10084; Favori';
            } else {
              exploreFavorites.add(exerciseName);
              actionBtn.classList.add('is-active');
              actionBtn.setAttribute('aria-pressed', 'true');
              actionBtn.innerHTML = '&#10084; Favori';
            }
            return;
          }

          if (action === 'add') {
            if (!sessionExercises.find((entry) => entry.name === exerciseName)) {
              sessionExercises.push({ name: exerciseName, video: source.type === 'video' ? source.src : '' });
              renderSessionPanel();
            }
            actionBtn.textContent = 'Ajoute au plan';
            return;
          }

          if (action === 'try') {
            stopExploreTryTimer();
            let remaining = 30;
            exploreTryButton = actionBtn;
            exploreTryButton.disabled = true;
            exploreTryButton.textContent = `${remaining}s`;
            exploreTryInterval = setInterval(() => {
              remaining -= 1;
              if (!exploreTryButton) return;
              if (remaining <= 0) {
                stopExploreTryTimer();
                return;
              }
              exploreTryButton.textContent = `${remaining}s`;
            }, 1000);
            return;
          }

          if (action === 'details') {
            openExploreDetails(slide);
          }
        });
      }

      const estimateMinutes = (exerciseCount) => Math.max(0, Math.ceil((exerciseCount * 90) / 60));

      const createPlanOnServer = async (payload) => {
        const body = new URLSearchParams();
        body.set('_token', plannerCsrfToken);
        body.set('title', payload.title || '');
        body.set('place', payload.place || '');
        body.set('program_label', payload.programLabel || '');
        body.set('estimated_minutes', String(payload.estimatedMinutes || 0));
        body.set('exercises', JSON.stringify(payload.exercises || []));

        const response = await fetch(planCreateUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: body.toString()
        });

        const data = await response.json().catch(() => ({ ok: false }));
        if (!response.ok || !data.ok) {
          throw new Error((data && data.error) || 'create_failed');
        }

        return data.plan;
      };

      const deletePlanOnServer = async (planId) => {
        const body = new URLSearchParams();
        body.set('_token', plannerCsrfToken);

        const response = await fetch(planDeleteUrlTemplate.replace('__ID__', String(planId)), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: body.toString()
        });

        const data = await response.json().catch(() => ({ ok: false }));
        if (!response.ok || !data.ok) {
          throw new Error((data && data.error) || 'delete_failed');
        }
      };

      const startConfirmedPlan = (planId) => {
        const plan = confirmedPlans.find((entry) => entry.id === planId);
        if (!plan || !Array.isArray(plan.exercises) || plan.exercises.length === 0) return;
        selectedProgram = plan.program || '';
        selectedPlace = plan.place || '';
        sessionExercises = plan.exercises.map((exercise) => ({
          name: exercise.name || '',
          video: exercise.video || ''
        }));
        renderSessionPanel();
        openSessionExercise(0);
      };

      const deleteConfirmedPlan = async (planId) => {
        if (!plansPersistAvailable) {
          alert('Connecte-toi pour supprimer une séance enregistrée.');
          return;
        }

        try {
          await deletePlanOnServer(planId);
          confirmedPlans = confirmedPlans.filter((entry) => String(entry.id) !== String(planId));
          renderConfirmedPlans();
        } catch (error) {
          alert('Suppression impossible pour le moment.');
        }
      };

      const renderConfirmedPlans = () => {
        if (!userPlansList) return;
        userPlansList.innerHTML = '';

        if (!confirmedPlans.length) {
          const empty = document.createElement('article');
          empty.className = 'program-card';
          empty.innerHTML = `
            <h3 class="program-title">Mes seances confirmees</h3>
            <div class="program-meta">Confirme une seance depuis le panneau "Ma seance" pour la retrouver ici.</div>
          `;
          userPlansList.appendChild(empty);
          return;
        }

        confirmedPlans.forEach((plan) => {
          const card = document.createElement('article');
          card.className = 'program-card';

          const title = document.createElement('h3');
          title.className = 'program-title';
          title.textContent = plan.title || 'Seance personnalisee';
          card.appendChild(title);

          const meta = document.createElement('div');
          meta.className = 'program-meta';
          const locationText = [plan.program || 'Programme libre', plan.place || 'Lieu libre'].join(' - ');
          meta.textContent = `${locationText} - ${estimateMinutes((plan.exercises || []).length)} min`;
          card.appendChild(meta);

          const list = document.createElement('ul');
          list.className = 'fp-user-plan-list';
          (plan.exercises || []).forEach((exercise) => {
            const item = document.createElement('li');
            item.textContent = exercise.name || 'Exercice';
            list.appendChild(item);
          });
          card.appendChild(list);

          const actions = document.createElement('div');
          actions.className = 'program-actions';

          const startBtn = document.createElement('button');
          startBtn.type = 'button';
          startBtn.className = 'fitness-btn fitness-btn-primary';
          startBtn.textContent = 'Commencer';
          startBtn.addEventListener('click', () => startConfirmedPlan(plan.id));

          const deleteBtn = document.createElement('button');
          deleteBtn.type = 'button';
          deleteBtn.className = 'fitness-btn fitness-btn-danger';
          deleteBtn.textContent = 'Supprimer';
          deleteBtn.addEventListener('click', () => {
            deleteConfirmedPlan(plan.id);
          });

          actions.appendChild(startBtn);
          actions.appendChild(deleteBtn);
          card.appendChild(actions);

          userPlansList.appendChild(card);
        });
      };

      const confirmCurrentSession = async () => {
        if (sessionExercises.length === 0) {
          alert('Ajoute des exercices a ta seance.');
          return;
        }

        if (!plansPersistAvailable) {
          alert('Connecte-toi pour confirmer et sauvegarder ta séance.');
          return;
        }

        const payload = {
          title: `Ma seance (${sessionExercises.length} exercices)`,
          programLabel: selectedProgram || '',
          place: selectedPlace || '',
          estimatedMinutes: estimateMinutes(sessionExercises.length),
          exercises: sessionExercises.map((exercise) => ({
            name: exercise.name,
            video: exercise.video || ''
          }))
        };

        try {
          const savedPlan = await createPlanOnServer(payload);
          confirmedPlans.unshift(savedPlan);
          renderConfirmedPlans();
          setView('plans');
          syncViewInUrl('plans');
          closeExerciseModal();
          closeLevelModal();
          closeModal();
        } catch (error) {
          if (String(error.message || '').includes('unauthorized')) {
            alert('Tu dois être connecté pour confirmer une séance.');
            return;
          }
          alert('Confirmation impossible pour le moment.');
        }
      };

      const stopSessionRestTimer = () => {
        if (sessionRestTimer) {
          clearInterval(sessionRestTimer);
          sessionRestTimer = null;
        }
      };

      const startSessionRestTimer = () => {
        if (!sessionRest) return;
        stopSessionRestTimer();
        let remaining = 60;
        sessionRest.textContent = `Timer repos : ${remaining}s`;
        sessionRestTimer = setInterval(() => {
          remaining -= 1;
          sessionRest.textContent = `Timer repos : ${remaining}s`;
          if (remaining <= 0) {
            stopSessionRestTimer();
          }
        }, 1000);
      };

      const openSessionExercise = (index) => {
        if (!sessionExercises.length) return;
        sessionIndex = Math.min(Math.max(index, 0), sessionExercises.length - 1);
        const current = sessionExercises[sessionIndex];
        const source = normalizeVideoSource(current.video || '');
        if (sessionProgress) {
          sessionProgress.textContent = `Progression (${sessionIndex + 1}/${sessionExercises.length})`;
        }

        if (source.type === 'external') {
          if (!openExploreSource(current.video)) {
            alert('Source video indisponible.');
          }
          return;
        }

        if (source.type !== 'video' && source.type !== 'youtube') {
          alert('Aucune video disponible pour cet exercice.');
          return;
        }

        const opened = openVideoModalWithSource(source, {
          title: 'Video de l’exercice',
          subtitle: `${selectedProgram} - ${selectedPlace}`,
          name: current.name
        });
        if (!opened) {
          alert('Impossible d\'ouvrir cette video en incrustation.');
          return;
        }
        startSessionRestTimer();
      };

      if (sessionStart) {
        sessionStart.addEventListener('click', () => {
          confirmCurrentSession();
        });
      }

      if (sessionNext) {
        sessionNext.addEventListener('click', () => {
          if (sessionExercises.length === 0) return;
          const nextIndex = Math.min(sessionIndex + 1, sessionExercises.length - 1);
          openSessionExercise(nextIndex);
        });
      }

      if (sessionClear) {
        sessionClear.addEventListener('click', () => {
          sessionExercises = [];
          renderSessionPanel();
        });
      }

      renderConfirmedPlans();
      renderSessionPanel();

    });
  </script>
{% endblock %}






















