{% extends 'base.html.twig' %}

{% block title %}Coachs Privés | Fitopia{% endblock %}

{% block stylesheets %}
<style>
  /* ── Hero ── */
  .coaches-hero {
    background: linear-gradient(135deg, #0b3a3d 0%, #1a6b5a 100%);
    padding: 90px 0 60px;
    text-align: center;
    color: #fff;
  }
  .coaches-hero h1 { font-size: 2.6rem; font-weight: 800; margin-bottom: .5rem; }
  .coaches-hero p  { font-size: 1.1rem; opacity: .85; max-width: 560px; margin: 0 auto; }

  /* ── Grid ── */
  .coaches-section { padding: 70px 0 80px; background: #f8fafc; }

  .coach-card {
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(11,58,61,.08);
    transition: transform .25s, box-shadow .25s;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .coach-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(11,58,61,.15);
  }

  .coach-img-wrap {
    position: relative;
    height: 260px;
    overflow: hidden;
  }
  .coach-img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .4s;
  }
  .coach-card:hover .coach-img-wrap img { transform: scale(1.05); }

  .coach-badge {
    position: absolute;
    top: 14px; right: 14px;
    background: #0b3a3d;
    color: #fff;
    font-size: .72rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    letter-spacing: .5px;
  }

  .coach-body { padding: 22px 22px 18px; flex: 1; display: flex; flex-direction: column; }
  .coach-name { font-size: 1.15rem; font-weight: 800; color: #0b3a3d; margin-bottom: 2px; }
  .coach-specialty { font-size: .85rem; color: #1a6b5a; font-weight: 600; margin-bottom: 10px; }
  .coach-bio { font-size: .88rem; color: #475467; line-height: 1.55; margin-bottom: 14px; flex: 1; }

  .coach-meta { display: flex; gap: 18px; margin-bottom: 14px; font-size: .82rem; color: #64748b; }
  .coach-meta span { display: flex; align-items: center; gap: 5px; }

  .coach-slots { margin-bottom: 16px; }
  .coach-slots-title { font-size: .78rem; font-weight: 700; color: #0b3a3d; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 6px; }
  .slot-pill {
    display: inline-block;
    background: #e8f5f0;
    color: #1a6b5a;
    font-size: .75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    margin: 2px 3px 2px 0;
  }

  .coach-stars { color: #f59e0b; font-size: .85rem; margin-bottom: 14px; }
  .coach-stars span { color: #64748b; font-size: .8rem; margin-left: 4px; }

  .btn-book {
    display: block;
    width: 100%;
    background: linear-gradient(135deg, #0b3a3d, #1a6b5a);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 11px;
    font-weight: 700;
    font-size: .92rem;
    text-align: center;
    text-decoration: none;
    transition: opacity .2s;
  }
  .btn-book:hover { opacity: .88; color: #fff; text-decoration: none; }

  /* ── Section title ── */
  .section-heading { text-align: center; margin-bottom: 50px; }
  .section-heading h2 { font-size: 2rem; font-weight: 800; color: #0b3a3d; }
  .section-heading p  { color: #64748b; max-width: 520px; margin: 8px auto 0; }
  .section-heading .divider {
    width: 60px; height: 4px;
    background: linear-gradient(90deg, #0b3a3d, #1a6b5a);
    border-radius: 2px;
    margin: 12px auto 0;
  }
</style>
{% endblock %}

{% block body %}

<div class="coaches-hero">
  <div class="container">
    <h1>Nos Coachs Privés</h1>
    <p>Des experts passionnés pour vous accompagner vers vos objectifs fitness.</p>
  </div>
</div>

<section class="coaches-section">
  <div class="container">
    <div class="section-heading">
      <h2>Choisissez votre coach</h2>
      <p>Réservez une séance personnalisée avec l'un de nos 6 coachs certifiés.</p>
      <div class="divider"></div>
    </div>

    <div class="row">
      {% for coach in coaches %}
      <div class="col-md-6 col-lg-4 mb-4 d-flex">
        <div class="coach-card w-100">

          <div class="coach-img-wrap">
            <img src="{{ asset(coach.image) }}" alt="{{ coach.name }}">
            <span class="coach-badge">{{ coach.specialty }}</span>
          </div>

          <div class="coach-body">
            <div class="coach-name">{{ coach.name }}</div>
            <div class="coach-specialty">{{ coach.specialty }}</div>

            <div class="coach-stars">
              {% for i in 1..5 %}
                {% if i <= coach.rating|round(0, 'floor') %}★{% else %}☆{% endif %}
              {% endfor %}
              <span>{{ coach.rating }}/5 · {{ coach.clients }} clients</span>
            </div>

            <div class="coach-bio">{{ coach.bio }}</div>

            <div class="coach-meta">
              <span><i class="fa fa-phone"></i> {{ coach.phone }}</span>
              <span><i class="fa fa-instagram"></i> {{ coach.instagram }}</span>
            </div>

            <div class="coach-slots">
              <div class="coach-slots-title">Créneaux disponibles</div>
              {% for slot in coach.slots %}
                <span class="slot-pill">{{ slot }}</span>
              {% endfor %}
            </div>

            <a href="{{ path('coach_book', {id: coach.id}) }}" class="btn-book">
              Réserver une séance
            </a>
          </div>

        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% endblock %}
