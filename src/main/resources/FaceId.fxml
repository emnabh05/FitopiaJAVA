<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="980.0" style="-fx-background-color: linear-gradient(to bottom, #fefefe, #f5f7f7);" xmlns="http://javafx.com/javafx/22.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Pidev3A49.test.FaceIdController">
    <children>
        <VBox spacing="18.0" AnchorPane.bottomAnchor="34.0" AnchorPane.leftAnchor="34.0" AnchorPane.rightAnchor="34.0" AnchorPane.topAnchor="34.0">
            <children>
                <Label style="-fx-text-fill: #17363b; -fx-font-size: 28px; -fx-font-weight: bold;" text="Face ID" />
                <Label style="-fx-text-fill: #617178; -fx-font-size: 13px;" text="La camera s'ouvre, capture votre visage et enregistre l'image avant d'ouvrir la page suivante." wrapText="true" />
                <ImageView fx:id="cameraPreview" fitHeight="520.0" fitWidth="900.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-color: #dde6e8; -fx-border-color: #cfdadd; -fx-border-radius: 12; -fx-background-radius: 12;" />
                <HBox spacing="12.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleCapture" style="-fx-background-color: #0d4f53; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" text="Capture Face" />
                        <Button mnemonicParsing="false" onAction="#handleRetry" style="-fx-background-color: white; -fx-text-fill: #20343a; -fx-border-color: #cad7dc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold;" text="Retry Camera" />
                        <Button mnemonicParsing="false" onAction="#handleCancel" style="-fx-background-color: white; -fx-text-fill: #9a2f2f; -fx-border-color: #f0c7c7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold;" text="Cancel" />
                    </children>
                </HBox>
                <Label fx:id="statusLabel" style="-fx-text-fill: #62737a; -fx-font-size: 12px;" text="Initialisation camera..." wrapText="true" />
            </children>
        </VBox>
    </children>
</AnchorPane>
