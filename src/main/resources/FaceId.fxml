<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="980.0" style="-fx-background-color: linear-gradient(to bottom, #fefefe, #f5f7f7);" xmlns="http://javafx.com/javafx/22.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Pidev3A49.test.FaceIdController">
    <children>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" pannable="true" style="-fx-background-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox spacing="18.0" style="-fx-padding: 34;">
                    <children>
                        <Label style="-fx-text-fill: #17363b; -fx-font-size: 28px; -fx-font-weight: bold;" text="Face ID" />
                        <Label style="-fx-text-fill: #617178; -fx-font-size: 13px;" text="Pour connexion directe: capture seulement. Pour enregistrer votre visage sur un compte: email/username + mot de passe, puis Enregistrer." wrapText="true" />
                        <HBox spacing="12.0">
                            <children>
                                <ComboBox fx:id="cameraSelector" prefWidth="420.0" promptText="Choisir une camera" />
                                <Button mnemonicParsing="false" onAction="#handleSelectCamera" style="-fx-background-color: white; -fx-text-fill: #20343a; -fx-border-color: #cad7dc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold;" text="Activer camera" />
                            </children>
                        </HBox>
                        <Label fx:id="cameraDetailsLabel" style="-fx-text-fill: #617178; -fx-font-size: 12px;" text="Recherche des webcams..." wrapText="true" />
                        <TextField fx:id="identifierField" promptText="Email ou username pour l'enregistrement" />
                        <PasswordField fx:id="passwordField" promptText="Mot de passe pour l'enregistrement" />
                        <StackPane prefHeight="480.0" prefWidth="900.0" style="-fx-background-color: #dde6e8; -fx-border-color: #cfdadd; -fx-border-radius: 12; -fx-background-radius: 12;">
                            <children>
                                <ImageView fx:id="cameraPreview" fitHeight="460.0" fitWidth="880.0" pickOnBounds="true" preserveRatio="true" />
                                <Label fx:id="previewPlaceholderLabel" mouseTransparent="true" style="-fx-text-fill: #6c7d84; -fx-font-size: 15px; -fx-font-weight: bold;" text="Preview camera" />
                            </children>
                        </StackPane>
                        <Label fx:id="statusLabel" style="-fx-text-fill: #62737a; -fx-font-size: 12px;" text="Initialisation camera..." wrapText="true" />
                        <HBox spacing="12.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleCapture" style="-fx-background-color: #0d4f53; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" text="Connexion directe" />
                                <Button fx:id="registerFaceButton" mnemonicParsing="false" onAction="#handleRegisterFace" style="-fx-background-color: white; -fx-text-fill: #20343a; -fx-border-color: #cad7dc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold;" text="Enregistrer mon visage" />
                                <Button mnemonicParsing="false" onAction="#handleLoadImage" style="-fx-background-color: white; -fx-text-fill: #20343a; -fx-border-color: #cad7dc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold;" text="Choisir une photo" />
                                <Button mnemonicParsing="false" onAction="#handleRetry" style="-fx-background-color: white; -fx-text-fill: #20343a; -fx-border-color: #cad7dc; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold;" text="Retry Camera" />
                                <Button mnemonicParsing="false" onAction="#handleCancel" style="-fx-background-color: white; -fx-text-fill: #9a2f2f; -fx-border-color: #f0c7c7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold;" text="Retour" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
