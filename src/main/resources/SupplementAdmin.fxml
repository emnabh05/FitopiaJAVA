                                                                <Label fx:id="imageNameLabel"
                                                                       text="Aucun fichier choisi"
                                                                       style="-fx-text-fill: #475467; -fx-font-size: 14px;"/>
                                                            </children>
                                                        </HBox>
                                                        <Label text="Allowed formats: JPG, PNG, WEBP. Max size: 2MB"
                                                               style="-fx-text-fill: #7B8794; -fx-font-size: 13px;"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>

                                        <Label fx:id="formStatusLabel"
                                               wrapText="true"
                                               style="-fx-text-fill: #255D71; -fx-font-size: 14px; -fx-font-weight: 700;"/>

                                        <HBox alignment="CENTER_RIGHT"
                                              spacing="12.0">
                                            <children>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Button text="Reset"
                                                        onAction="#resetAddForm"
                                                        prefWidth="110.0"
                                                        prefHeight="46.0"
                                                        style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #D4E2EA; -fx-border-radius: 14; -fx-text-fill: #496170; -fx-font-size: 15px; -fx-font-weight: 800;"/>
                                                <Button text="Modifier"
                                                        onAction="#handleUpdateSupplement"
                                                        prefWidth="130.0"
                                                        prefHeight="46.0"
                                                        style="-fx-background-color: #E8F3FF; -fx-background-radius: 14; -fx-text-fill: #0B4A56; -fx-font-size: 15px; -fx-font-weight: 800;"/>
                                                <Button text="Supprimer"
                                                        onAction="#handleDeleteSupplement"
                                                        prefWidth="130.0"
                                                        prefHeight="46.0"
                                                        style="-fx-background-color: #FFE8E8; -fx-background-radius: 14; -fx-text-fill: #9D1C1C; -fx-font-size: 15px; -fx-font-weight: 800;"/>
                                                <Button text="Creer le supplement"
                                                        onAction="#handleCreateSupplement"
                                                        prefWidth="190.0"
                                                        prefHeight="46.0"
                                                        style="-fx-background-color: linear-gradient(to right, #0B4A56, #13866A); -fx-background-radius: 14; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 800;"/>
                                            </children>
                                        </HBox>

                                        <VBox fx:id="syncedSupplementsSection"
                                              spacing="16.0"
                                              style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-border-color: #E6EAEE; -fx-border-radius: 18;">
                                            <padding>
                                                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                                            </padding>
                                            <children>
                                                <Label text="Supplements synchronises"
                                                       style="-fx-text-fill: #153F46; -fx-font-size: 18px; -fx-font-weight: 800;"/>
                                                <Label fx:id="supplementCountLabel"
                                                       style="-fx-text-fill: #6B7280; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                                <FlowPane fx:id="adminSupplementGrid"
                                                          prefWrapLength="980.0"
                                                          hgap="16.0"
                                                          vgap="16.0"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
