<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0"
      styleClass="event-stats-root"
      xmlns="http://javafx.com/javafx/22.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Pidev3A49.controllers.EventStatsController">
    <padding>
        <Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/>
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="event-stats-topbar">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="ANALYSE DES EVENEMENTS" styleClass="event-stats-kicker"/>
                        <Label text="Classement des evenements les plus rentables" styleClass="event-stats-title"/>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualiser" onAction="#refreshStats" styleClass="event-stats-primary-button"/>
            </children>
        </HBox>

        <Label fx:id="statusLabel" text="Chargement..." styleClass="event-stats-status"/>

        <TableView fx:id="statsTable" styleClass="event-stats-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="titreColumn" prefWidth="320.0" text="Titre evenement"/>
                <TableColumn fx:id="nbReservationsColumn" prefWidth="180.0" text="Reservations valides"/>
                <TableColumn fx:id="revenuTotalColumn" prefWidth="180.0" text="Revenu total"/>
                <TableColumn fx:id="tauxRemplissageColumn" prefWidth="180.0" text="Taux remplissage"/>
            </columns>
        </TableView>
    </children>
</VBox>
