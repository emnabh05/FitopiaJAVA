                                                            </content>
                                                        </ScrollPane>
                                                    </children>
                                                </VBox>

                                                <VBox fx:id="deleteEventsSection" managed="false" spacing="14.0" styleClass="panel-card" visible="false">
                                                    <children>
                                                        <VBox spacing="3.0">
                                                            <children>
                                                                <Label text="Delete Events" styleClass="panel-title panel-title-icon"/>
                                                                <Label text="Liste simplifiee et moderne des evenements avec suppression rapide."
                                                                       styleClass="panel-subtitle"/>
                                                            </children>
                                                        </VBox>

                                                        <ScrollPane fitToWidth="true" prefHeight="540.0" styleClass="inner-scroll">
                                                            <content>
                                                                <VBox fx:id="deleteEventsContainer" spacing="10.0" styleClass="list-container">
                                                                    <padding>
                                                                        <Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/>
                                                                    </padding>
                                                                </VBox>
                                                            </content>
                                                        </ScrollPane>
                                                    </children>
                                                </VBox>

                                                <VBox fx:id="dashboardSection" spacing="14.0" styleClass="panel-card" visible="true">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <VBox spacing="3.0">
                                                                    <children>
                                                                        <Label text="Events Dashboard &amp; List" styleClass="panel-title panel-title-icon"/>
                                                                        <Label text="Vue dashboard complete avec recherche, filtre, tri et tableau de suivi des evenements."
                                                                               styleClass="panel-subtitle"/>
                                                                    </children>
                                                                </VBox>
                                                                <Region HBox.hgrow="ALWAYS"/>
                                                                <Label text="Sort: ID DESC" styleClass="toolbar-chip"/>
                                                            </children>
                                                        </HBox>

                                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar-row dashboard-toolbar-row">
                                                            <children>
                                                                <TextField fx:id="searchField"
                                                                           promptText="Search events by title, type, location or description..."
                                                                           styleClass="search-field"
                                                                           HBox.hgrow="ALWAYS"/>

                                                                <Button mnemonicParsing="false"
                                                                        onAction="#applyEventFilter"
                                                                        styleClass="toolbar-button toolbar-button-strong"
                                                                        text="Filter"/>

                                                                <Button mnemonicParsing="false"
                                                                        onAction="#resetEventFilter"
                                                                        styleClass="toolbar-button"
                                                                        text="Reset"/>

                                                                <Button mnemonicParsing="false"
                                                                        onAction="#refreshEvents"
                                                                        styleClass="toolbar-button"
                                                                        text="Refresh"/>

                                                                <Button mnemonicParsing="false"
                                                                        onAction="#exportPdfPlaceholder"
                                                                        styleClass="toolbar-button toolbar-button-export"
                                                                        text="Export PDF"/>
                                                            </children>
                                                        </HBox>

                                                        <TableView fx:id="eventTable" prefHeight="500.0" styleClass="event-table" VBox.vgrow="ALWAYS">
                                                            <columns>
                                                                <TableColumn fx:id="idColumn" prefWidth="65.0" text="ID"/>
                                                                <TableColumn fx:id="titreColumn" prefWidth="150.0" text="Title"/>
                                                                <TableColumn fx:id="typeEventColumn" prefWidth="120.0" text="Type"/>
                                                                <TableColumn fx:id="dateColumn" prefWidth="105.0" text="Date"/>
                                                                <TableColumn fx:id="lieuColumn" prefWidth="130.0" text="Location"/>
                                                                <TableColumn fx:id="resActivesColumn" prefWidth="95.0" text="Res. actives"/>
                                                                <TableColumn fx:id="capaciteColumn" prefWidth="90.0" text="Capacity"/>
                                                                <TableColumn fx:id="restantesColumn" prefWidth="90.0" text="Restantes"/>
                                                                <TableColumn fx:id="waitlistColumn" prefWidth="90.0" text="Waitlist"/>
                                                                <TableColumn fx:id="premiumColumn" prefWidth="80.0" text="Premium"/>
                                                                <TableColumn fx:id="etatColumn" prefWidth="90.0" text="Etat"/>
                                                                <TableColumn fx:id="prixColumn" prefWidth="85.0" text="Price"/>
                                                                <TableColumn fx:id="descriptionColumn" prefWidth="180.0" text="Description"/>
                                                                <TableColumn fx:id="imageEventColumn" prefWidth="140.0" text="Image"/>
                                                                <TableColumn fx:id="createdAtColumn" prefWidth="150.0" text="Created At"/>
                                                            </columns>
                                                        </TableView>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>

                                <VBox fx:id="participantsSection" managed="false" spacing="14.0" styleClass="panel-card participation-panel" visible="false">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="panel-header-row">
                                            <children>
                                                <VBox spacing="3.0">
                                                    <children>
                                                        <Label text="Liste des Participants" styleClass="panel-title panel-title-icon"/>
                                                        <Label text="Section de consultation des participations liees aux evenements avec recherche et tri simples."
                                                               styleClass="panel-subtitle"/>
                                                    </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label text="Sort: ID DESC" styleClass="toolbar-chip"/>
                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar-row">
                                            <children>
                                                <TextField fx:id="participantSearchField"
                                                           promptText="Search by name, email or event..."
                                                           styleClass="search-field"
                                                           HBox.hgrow="ALWAYS"/>

                                                <Button mnemonicParsing="false"
                                                        onAction="#applyParticipantFilter"
                                                        styleClass="toolbar-button"
                                                        text="Filter"/>

                                                <Button mnemonicParsing="false"
                                                        onAction="#resetParticipantFilter"
                                                        styleClass="toolbar-button"
                                                        text="Reset"/>

                                                <Button mnemonicParsing="false"
                                                        onAction="#refreshParticipations"
                                                        styleClass="toolbar-button"
                                                        text="Refresh"/>

                                                <Button mnemonicParsing="false"
                                                        onAction="#exportParticipantsPdf"
                                                        styleClass="toolbar-button toolbar-button-export"
                                                        text="Export PDF"/>
                                            </children>
                                        </HBox>

                                        <TableView fx:id="participationTable" prefHeight="540.0" styleClass="event-table" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="participationIdColumn" prefWidth="110.0" text="ID Participation"/>
                                                <TableColumn fx:id="nomParticipantColumn" prefWidth="180.0" text="Nom"/>
                                                <TableColumn fx:id="emailParticipantColumn" prefWidth="220.0" text="Email"/>
                                                <TableColumn fx:id="dateInscriptionColumn" prefWidth="180.0" text="Date d'inscription"/>
                                                <TableColumn fx:id="evenementParticipationColumn" prefWidth="220.0" text="Evenement"/>
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
