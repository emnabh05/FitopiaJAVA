<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="920.0" prefWidth="1600.0" stylesheets="@styles/admin-theme.css" styleClass="landing-root"
           xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.Pidev3A49.controllers.NavigationController">
    <children>
        <VBox alignment="CENTER" maxWidth="520.0" spacing="28.0" styleClass="landing-card">
            <padding>
                <Insets bottom="42.0" left="42.0" right="42.0" top="42.0"/>
            </padding>
            <Label styleClass="landing-title" text="Choix de la vue"/>
            <Label styleClass="landing-subtitle" text="Selectionnez l'espace a ouvrir dans l'application." wrapText="true"/>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#ouvrirFront" styleClass="landing-button landing-button-front" text="Front"/>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#ouvrirBack" styleClass="landing-button landing-button-back" text="Back"/>
        </VBox>
    </children>
</StackPane>
