<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0"
      styleClass="waitlist-admin-root"
      xmlns="http://javafx.com/javafx/22.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Pidev3A49.controllers.WaitlistAdminController">
    <padding>
        <Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="waitlist-admin-topbar">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="WAITLIST ADMIN" styleClass="waitlist-admin-kicker"/>
                        <Label text="Gestion FIFO des listes d'attente" styleClass="waitlist-admin-title"/>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Promouvoir le premier" onAction="#promoteFirst" styleClass="waitlist-admin-primary-button"/>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="waitlist-admin-toolbar">
            <children>
                <ComboBox fx:id="eventComboBox" prefWidth="360.0" styleClass="waitlist-admin-combo"/>
                <Button text="Actualiser" onAction="#refreshWaitlist" styleClass="waitlist-admin-secondary-button"/>
                <Button text="Retirer selection" onAction="#removeSelected" styleClass="waitlist-admin-danger-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" text="Selectionne un evenement." styleClass="waitlist-admin-status"/>
            </children>
        </HBox>

        <TableView fx:id="waitlistTable" styleClass="waitlist-admin-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="positionColumn" prefWidth="90.0" text="Position"/>
                <TableColumn fx:id="nameColumn" prefWidth="220.0" text="Nom"/>
                <TableColumn fx:id="emailColumn" prefWidth="260.0" text="Email"/>
                <TableColumn fx:id="statusColumn" prefWidth="140.0" text="Statut"/>
                <TableColumn fx:id="createdAtColumn" prefWidth="180.0" text="Inscription"/>
            </columns>
        </TableView>
    </children>
</VBox>
