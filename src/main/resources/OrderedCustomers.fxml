                    </Button>
                    <Button focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="back-nav-button back-menu-link back-menu-featured sidebar-nav-button-active" text="Commandes supplements" wrapText="true" style="-fx-background-color: #387163; -fx-background-radius: 14; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 15px; -fx-padding: 18 16; -fx-alignment: center-left; -fx-graphic-text-gap: 12;" textFill="WHITE">
                        <graphic>
                            <Label styleClass="back-nav-icon" text="&#128179;" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-min-width: 20; -fx-alignment: center;" />
                        </graphic>
                    </Button>
                </VBox>
                <Region VBox.vgrow="ALWAYS" />
                <VBox spacing="12.0" styleClass="back-sidebar-footer">
                    <Button maxWidth="180.0" mnemonicParsing="false" onAction="#openChangeSessions" styleClass="back-logout-button" text="Change sessions" style="-fx-background-color: white; -fx-background-radius: 14; -fx-text-fill: #0F4C45; -fx-font-weight: 900; -fx-font-size: 15px; -fx-padding: 14 20; -fx-alignment: center-left; -fx-graphic-text-gap: 10;" textFill="#0f4c45">
                        <graphic>
                            <Label styleClass="back-logout-icon" text="&#8618;" style="-fx-text-fill: #0F4C45; -fx-font-weight: 900; -fx-font-size: 16px;" />
                        </graphic>
                    </Button>
                </VBox>
