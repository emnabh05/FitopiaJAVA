                        <Label styleClass="back-user-avatar-text" text="A" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 16px;" />
                    </StackPane>
                    <Label styleClass="back-user-mail" text="ahmed@gmail.com" style="-fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 15px;" />
                </HBox>
                <VBox spacing="10.0">
                    <Button focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="back-nav-button back-sidebar-section-button" text="Tables" style="-fx-background-color: #31655B; -fx-background-radius: 14; -fx-font-weight: 800; -fx-padding: 16 18; -fx-text-fill: white; -fx-font-size: 16px; -fx-alignment: center-left; -fx-graphic-text-gap: 12;" textFill="WHITE">
                        <graphic>
                            <Label styleClass="back-nav-icon" text="&#9638;" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 16px; -fx-min-width: 20; -fx-alignment: center;" />
                        </graphic>
                    </Button>
                </VBox>
                <VBox spacing="6.0">
                    <Button focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="back-nav-button back-menu-link" text="Gestion utilisateur" wrapText="true" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 15px; -fx-padding: 12 16; -fx-alignment: center-left; -fx-graphic-text-gap: 12;" textFill="WHITE">
                        <graphic>
                            <Label styleClass="back-nav-icon" text="&#128101;" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-min-width: 20; -fx-alignment: center;" />
                        </graphic>
                    </Button>
                    <Button focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="back-nav-button back-menu-link" text="Gestion forum et blog" wrapText="true" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 15px; -fx-padding: 12 16; -fx-alignment: center-left; -fx-graphic-text-gap: 12;" textFill="WHITE">
                        <graphic>
                            <Label styleClass="back-nav-icon" text="&#128172;" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-min-width: 20; -fx-alignment: center;" />
                        </graphic>
                    </Button>
                    <Button focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="back-nav-button back-menu-link" text="Gestion des stock" wrapText="true" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 15px; -fx-padding: 12 16; -fx-alignment: center-left; -fx-graphic-text-gap: 12;" textFill="WHITE">
                        <graphic>
                            <Label styleClass="back-nav-icon" text="&#128230;" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-min-width: 20; -fx-alignment: center;" />
                        </graphic>
                    </Button>
                    <Button focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="back-nav-button back-menu-link" text="Gestion des evenements" wrapText="true" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 15px; -fx-padding: 12 16; -fx-alignment: center-left; -fx-graphic-text-gap: 12;" textFill="WHITE">
                        <graphic>
                            <Label styleClass="back-nav-icon" text="&#128197;" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-min-width: 20; -fx-alignment: center;" />
                        </graphic>
                    </Button>
                    <Button focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openBackEnd" styleClass="back-nav-button back-menu-link" text="Gestion alimentation" wrapText="true" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 15px; -fx-padding: 12 16; -fx-alignment: center-left; -fx-graphic-text-gap: 12;" textFill="WHITE">
                        <graphic>
                            <Label styleClass="back-nav-icon" text="&#127807;" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 16px; -fx-min-width: 20; -fx-alignment: center;" />
                        </graphic>
                    </Button>
                    <Button focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openSupplementBackEnd" styleClass="back-nav-button back-menu-link" text="Gestion supplements" wrapText="true" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 15px; -fx-padding: 12 16; -fx-alignment: center-left; -fx-graphic-text-gap: 12;" textFill="WHITE">
                        <graphic>
                            <Label styleClass="back-nav-icon" text="&#128722;" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-min-width: 20; -fx-alignment: center;" />
