<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Pidev3A49.controllers.OrderedCustomersController"
            prefWidth="1500.0"
            prefHeight="950.0"
            style="-fx-background-color: #F4F7F6;">

    <left>
        <VBox prefWidth="310.0"
              spacing="24.0"
              style="-fx-background-color: linear-gradient(to bottom, #063C43, #0B6B5C);">
            <padding>
                <Insets top="28.0" right="20.0" bottom="28.0" left="20.0"/>
            </padding>

            <children>
                <HBox spacing="14.0" alignment="CENTER_LEFT">
                    <children>
                        <StackPane prefWidth="52.0" prefHeight="52.0"
                                   style="-fx-background-color: white; -fx-background-radius: 14;">
                            <children>
                                <Label text="S"
                                       style="-fx-text-fill: #0B4D57; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                            </children>
                        </StackPane>
                        <Label text="Fitopia Admin"
                               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 700;"/>
                    </children>
                </HBox>

                <HBox spacing="14.0"
                      alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 18;">
                    <padding>
                        <Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/>
                    </padding>
                    <children>
                        <StackPane prefWidth="46.0" prefHeight="46.0"
                                   style="-fx-background-color: #D9E7E4; -fx-background-radius: 23;">
                            <children>
                                <Label text="A"
                                       style="-fx-text-fill: #0A4A53; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                            </children>
                        </StackPane>
                        <Label text="ahmed@gmail.com"
                               style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700;"/>
                    </children>
                </HBox>

                <Button text="Tables"
                        onAction="#openBackEnd"
                        prefHeight="54.0"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: rgba(255,255,255,0.10); -fx-background-radius: 16; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700;"/>

                <Button text="Orderd"
                        prefHeight="60.0"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: rgba(255,255,255,0.16); -fx-background-radius: 16; -fx-border-color: rgba(255,255,255,0.28); -fx-border-radius: 16; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20;"/>

                <Button text="Front End"
                        onAction="#openFrontEnd"
                        prefHeight="54.0"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: white; -fx-background-radius: 16; -fx-text-fill: #0A4450; -fx-font-size: 16px; -fx-font-weight: 700;"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Return"
                        onAction="#goBackOrExit"
                        prefHeight="54.0"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: rgba(255,255,255,0.10); -fx-background-radius: 16; -fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 16; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700;"/>

                <Button text="Logout"
                        prefWidth="130.0"
                        prefHeight="54.0"
                        style="-fx-background-color: white; -fx-background-radius: 16; -fx-text-fill: #0A4450; -fx-font-size: 16px; -fx-font-weight: 700;"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="24.0">
            <padding>
                <Insets top="30.0" right="36.0" bottom="30.0" left="36.0"/>
            </padding>

            <children>
                <AnchorPane prefHeight="155.0"
                            style="-fx-background-color: linear-gradient(to right, #07505B, #118465); -fx-background-radius: 26;">
                    <children>
                        <VBox spacing="12.0"
                              AnchorPane.leftAnchor="34.0"
                              AnchorPane.topAnchor="36.0">
                            <children>
                                <Label text="Orders Management"
                                       style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: 800;"/>
                                <Label text="Change order status directly from the table: DELIVERED, ON_THE_WAY, CANCELED, ON_PROGRESS."
                                       wrapText="true"
                                       style="-fx-text-fill: rgba(255,255,255,0.92); -fx-font-size: 16px;"/>
                            </children>
                        </VBox>
                        <StackPane prefWidth="150.0" prefHeight="150.0"
                                   AnchorPane.rightAnchor="0.0"
                                   AnchorPane.topAnchor="0.0"
                                   style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 0 26 0 120;"/>
                    </children>
                </AnchorPane>

                <VBox spacing="14.0"
                      style="-fx-background-color: white; -fx-background-radius: 24;">
                    <padding>
                        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                    </padding>
                    <children>
                        <Label text="Orderd Table"
                               style="-fx-text-fill: #111827; -fx-font-size: 22px; -fx-font-weight: 800;"/>
                        <Label fx:id="statusLabel"
                               style="-fx-text-fill: #6B7280; -fx-font-size: 14px; -fx-font-weight: 700;"/>

                        <TableView fx:id="orderedCustomersTable"
                                   prefHeight="620.0"
                                   style="-fx-background-radius: 16; -fx-border-color: #E5EAF0; -fx-border-radius: 16;">
                            <columns>
                                <TableColumn fx:id="orderIdColumn" text="Order ID"/>
                                <TableColumn fx:id="fullNameColumn" text="Customer"/>
                                <TableColumn fx:id="emailColumn" text="Email"/>
                                <TableColumn fx:id="phoneColumn" text="Phone"/>
                                <TableColumn fx:id="cityColumn" text="City"/>
                                <TableColumn fx:id="totalAmountColumn" text="Total"/>
                                <TableColumn fx:id="statusColumn" text="Status"/>
                                <TableColumn fx:id="createdAtColumn" text="Created At"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
