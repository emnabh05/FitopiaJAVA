                        <VBox alignment="CENTER" spacing="0.0">
                            <Label styleClass="back-sidebar-logo-mark" text="F" style="-fx-text-fill: #0F4C45; -fx-font-weight: 900; -fx-font-size: 16px;" />
                            <Label styleClass="back-sidebar-logo-caption" text="FITOPIA" style="-fx-text-fill: #7e8a8f; -fx-font-weight: 800; -fx-font-size: 6.5px;" />
                        </VBox>
                    </StackPane>
                    <Label styleClass="back-sidebar-title" text="Fitopia Admin" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 19px;" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="back-user-card" style="-fx-background-color: #31655B; -fx-background-radius: 14; -fx-padding: 14 16 14 16;">
