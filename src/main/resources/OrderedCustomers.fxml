    <center>
        <VBox spacing="24.0">
            <padding>
                <Insets top="30.0" right="36.0" bottom="30.0" left="36.0"/>
            </padding>

            <children>
                <AnchorPane prefHeight="155.0"
                            style="-fx-background-color: linear-gradient(to right, #07505B, #118465); -fx-background-radius: 26;">
                    <children>
                        <VBox spacing="12.0"
                              AnchorPane.leftAnchor="34.0"
                              AnchorPane.topAnchor="36.0">
                            <children>
                                <Label text="Orders Management"
                                       style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: 800;"/>
                                <Label text="Change order status directly from the table: DELIVERED, ON_THE_WAY, CANCELED, ON_PROGRESS."
                                       wrapText="true"
                                       style="-fx-text-fill: rgba(255,255,255,0.92); -fx-font-size: 16px;"/>
                            </children>
                        </VBox>
                        <StackPane prefWidth="150.0" prefHeight="150.0"
                                   AnchorPane.rightAnchor="0.0"
                                   AnchorPane.topAnchor="0.0"
                                   style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 0 26 0 120;"/>
                    </children>
                </AnchorPane>

                <VBox spacing="14.0"
                      style="-fx-background-color: white; -fx-background-radius: 24;">
                    <padding>
                        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                    </padding>
                    <children>
                        <Label text="Orderd Table"
                               style="-fx-text-fill: #111827; -fx-font-size: 22px; -fx-font-weight: 800;"/>
                        <Label fx:id="statusLabel"
                               style="-fx-text-fill: #6B7280; -fx-font-size: 14px; -fx-font-weight: 700;"/>

                        <TableView fx:id="orderedCustomersTable"
                                   prefHeight="620.0"
                                   style="-fx-background-radius: 16; -fx-border-color: #E5EAF0; -fx-border-radius: 16;">
                            <columns>
                                <TableColumn fx:id="orderIdColumn" text="Order ID"/>
                                <TableColumn fx:id="fullNameColumn" text="Customer"/>
                                <TableColumn fx:id="emailColumn" text="Email"/>
                                <TableColumn fx:id="phoneColumn" text="Phone"/>
                                <TableColumn fx:id="cityColumn" text="City"/>
                                <TableColumn fx:id="totalAmountColumn" text="Total"/>
                                <TableColumn fx:id="statusColumn" text="Status"/>
                                <TableColumn fx:id="createdAtColumn" text="Created At"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
