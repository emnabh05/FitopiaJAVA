<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      styleClass="waitlist-root"
      xmlns="http://javafx.com/javafx/22.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Pidev3A49.controllers.WaitlistSignupController">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>
    <children>
        <VBox spacing="8.0" styleClass="waitlist-hero">
            <children>
                <Label text="LISTE D'ATTENTE" styleClass="waitlist-kicker"/>
                <Label fx:id="eventTitleLabel" text="Evenement complet" wrapText="true" styleClass="waitlist-title"/>
                <Label fx:id="eventMetaLabel" text="Date | Lieu | Type" wrapText="true" styleClass="waitlist-subtitle"/>
            </children>
        </VBox>

        <VBox spacing="14.0" styleClass="waitlist-form-card">
            <children>
                <VBox spacing="7.0">
                    <children>
                        <Label text="Nom" styleClass="waitlist-label"/>
                        <TextField fx:id="nameField" promptText="Votre nom complet" styleClass="waitlist-field"/>
                    </children>
                </VBox>

                <VBox spacing="7.0">
                    <children>
                        <Label text="Email" styleClass="waitlist-label"/>
                        <TextField fx:id="emailField" promptText="client@fitopia.tn" styleClass="waitlist-field"/>
                    </children>
                </VBox>

                <Label fx:id="statusLabel" text="Les inscriptions sont traitees dans l'ordre d'arrivee." wrapText="true" styleClass="waitlist-status"/>

                <HBox spacing="10.0">
                    <children>
                        <Button text="Annuler" onAction="#closeView" styleClass="waitlist-secondary-button"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="confirmButton" text="Confirmer l'inscription" onAction="#confirmWaitlist" styleClass="waitlist-primary-button"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
