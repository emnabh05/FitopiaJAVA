<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f7f7f7);" xmlns="http://javafx.com/javafx/22.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Pidev3A49.test.UserController">
    <children>
        <HBox alignment="CENTER" spacing="48.0" AnchorPane.bottomAnchor="70.0" AnchorPane.leftAnchor="120.0" AnchorPane.rightAnchor="120.0" AnchorPane.topAnchor="70.0">
            <children>
                <VBox maxWidth="470.0" prefHeight="310.0" prefWidth="470.0" style="-fx-background-color: linear-gradient(to bottom right, #0c4c50, #168a67); -fx-background-radius: 14; -fx-padding: 30 30 30 30;">
                    <children>
                        <Label style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 8; -fx-padding: 10 12 10 12; -fx-text-fill: #0e6563; -fx-font-weight: bold;" text="fitopia" />
                        <Label style="-fx-padding: 22 0 0 0; -fx-text-fill: #071d22; -fx-font-size: 32px; -fx-font-weight: bold;" text="Welcome Fitopia" />
                        <Label style="-fx-padding: 14 0 0 0; -fx-text-fill: rgba(255,255,255,0.88); -fx-font-size: 14px;" text="Access your Fitopia account, track your progress, and manage your personalized journey." wrapText="true" />
                        <VBox spacing="10.0" style="-fx-padding: 22 0 0 0;">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 13px;" text="✔ Smart plans tailored to your goals" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 13px;" text="✔ Track workouts, nutrition, and progress" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 13px;" text="✔ Connect with coaches and experts" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
                <VBox maxWidth="430.0" prefHeight="540.0" prefWidth="430.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 28, 0.18, 0, 10); -fx-padding: 26 24 22 24;">
                    <children>
                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #202f35; -fx-font-size: 16px; -fx-font-weight: bold;" text="Sign in to Fitopia" />
                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: #0e4e53; -fx-background-radius: 28; -fx-text-fill: white; -fx-font-size: 21px; -fx-font-weight: bold; -fx-padding: 14 0 14 0;" text="GU">
                            <VBox.margin>
                                <javafx.geometry.Insets top="18.0" />
                            </VBox.margin>
                        </Label>
                        <HBox spacing="8.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleLoginMode" prefWidth="190.0" style="-fx-background-color: #0d3f45; -fx-text-fill: white; -fx-background-radius: 7; -fx-font-size: 12px; -fx-font-weight: bold;" text="Login + Password" />
                                <Button mnemonicParsing="false" onAction="#handleFaceIdMode" prefWidth="190.0" style="-fx-background-color: white; -fx-text-fill: #4b5960; -fx-border-color: #d7dfe3; -fx-border-radius: 7; -fx-background-radius: 7; -fx-font-size: 12px; -fx-font-weight: bold;" text="Face ID" />
                            </children>
                            <VBox.margin>
                                <javafx.geometry.Insets top="16.0" />
                            </VBox.margin>
                        </HBox>
                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-border-color: #d8dfe2; -fx-border-radius: 3; -fx-padding: 8 0 8 0; -fx-text-fill: #8a98a1; -fx-font-size: 9px; -fx-font-weight: bold;" text="LOGIN WITH QR" />
                        <Label style="-fx-text-fill: #66757c; -fx-font-size: 13px;" text="Email ou Username">
                            <VBox.margin>
                                <javafx.geometry.Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                        <TextField fx:id="emailField" />
                        <Label style="-fx-text-fill: #66757c; -fx-font-size: 13px;" text="Password">
                            <VBox.margin>
                                <javafx.geometry.Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                        <PasswordField fx:id="passwordField" />
                        <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-border-color: #d9d9d9; -fx-border-radius: 3; -fx-padding: 0 10 0 10;">
                            <children>
                                <CheckBox fx:id="robotCheckBox" mnemonicParsing="false" text="I'm not a robot" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-text-fill: #97a1a8; -fx-font-size: 10px;" text="reCAPTCHA" />
                            </children>
                            <VBox.margin>
                                <javafx.geometry.Insets top="12.0" />
                            </VBox.margin>
                        </HBox>
                        <Button mnemonicParsing="false" onAction="#handleLogin" prefWidth="74.0" style="-fx-background-color: #2f3540; -fx-text-fill: white; -fx-background-radius: 3; -fx-font-size: 9px; -fx-font-weight: bold; -fx-padding: 8 12 8 12;" text="LOGIN">
                            <VBox.margin>
                                <javafx.geometry.Insets top="14.0" />
                            </VBox.margin>
                        </Button>
                        <Label fx:id="statusLabel" style="-fx-text-fill: #6e7980; -fx-font-size: 11px;" wrapText="true">
