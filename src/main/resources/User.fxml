                                <javafx.geometry.Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                        <Separator>
                            <VBox.margin>
                                <javafx.geometry.Insets top="14.0" />
                            </VBox.margin>
                        </Separator>
                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #8b949a; -fx-font-size: 12px;" text="Don't have an account?">
                            <VBox.margin>
                                <javafx.geometry.Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#handleCreateAccount" maxWidth="1.7976931348623157E308" style="-fx-background-color: white; -fx-text-fill: #67767c; -fx-border-color: #d6dde1; -fx-border-radius: 3; -fx-background-radius: 3; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 10 12 10 12;" text="CREATE AN ACCOUNT">
