<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--suppress XMLErrors -->
<!--suppress XMLWarnings -->
<BorderPane prefHeight="980.0" prefWidth="1600.0" stylesheets="@styles/admin-theme.css" styleClass="planner-root"
            xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Pidev3A49.controllers.MainController">
    <top>
        <VBox styleClass="navbar-container">
            <!-- Main Navbar matching the image -->
            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="navbar-shell">
                <!-- Logo -->
                <VBox alignment="CENTER" spacing="2.0">
                    <Label text="&#127811;" styleClass="navbar-logo-icon" />
                    <Label text="FITOPIA" styleClass="navbar-logo-text" />
                </VBox>
                <Region prefWidth="30" />
                <!-- Links -->
                <VBox alignment="CENTER" spacing="2.0">
                    <Label text="Home" styleClass="navbar-link navbar-link-active" />
                </VBox>
                <Region prefWidth="5" />
                <VBox alignment="CENTER" spacing="2.0">
                    <Label text="About&#10;Fitopia" textAlignment="CENTER" styleClass="navbar-link" />
                </VBox>
                <Region prefWidth="30" />
                <!-- Action Buttons -->
                <Button fx:id="btnModuleRegimes" onAction="#afficherModuleRegimes" text="EXPLORE&#10;OUR&#10;DIET&amp;EATING&#10;PLANNER" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                <Button fx:id="btnModuleRepas" onAction="#afficherModuleRepas" text="EXPLORE&#10;OUR&#10;DAILY&#10;MEALS" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                <Button text="EXPLORE&#10;OUR&#10;FITNESS&#10;PLANNER" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                <Button text="EXPLORE&#10;OUR&#10;EVENTS" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                <Button text="EXPLORE&#10;FORUMS&amp;BLOGS" textAlignment="CENTER" styleClass="navbar-btn-blue" />
                
                <Region HBox.hgrow="ALWAYS" />
                <!-- Right Actions -->
                <Button onAction="#rafraichirDonnees" text="MY&#10;PROFILE" textAlignment="CENTER" styleClass="navbar-btn-green" />
                <Button text="LOGOUT" textAlignment="CENTER" styleClass="navbar-btn-red" />
            </HBox>
        </VBox>
    </top>
    
    <center>
        <StackPane>
            <ScrollPane fx:id="appScrollPane" fitToHeight="true" fitToWidth="true" style="-fx-background-color: #f3f6fb; -fx-background: #f3f6fb;">
                <content>
                    <StackPane>
                         <VBox fx:id="viewRepas" visible="false" managed="false"/>
                         
                         <VBox fx:id="viewRegimes" fillWidth="true" spacing="20.0" style="-fx-background-color: #f3f6fb; -fx-padding: 40;" visible="true" managed="true">
                             
                             <!-- Hero & Intro -->
                             <VBox spacing="8">
                                 <Label text="Diet &amp; Eating Planner" style="-fx-font-weight: 800; -fx-font-size: 38px; -fx-text-fill: #1f2937;" />
                                 <Label text="Welcome. This page is personalized for you." style="-fx-text-fill: #6b7280; -fx-font-size: 14px;" />
                                 
                                 <!-- Info banner -->
                                 <VBox style="-fx-background-color: linear-gradient(to bottom right, #f4fbf9, #eef4ff); -fx-border-color: #dbe7f4; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 15; -fx-spacing: 12;" translateY="12">
                                     <Label text="Comment utiliser cette page :" style="-fx-font-weight: 800; -fx-text-fill: #0c3f44; -fx-font-size: 14px;"/>
                                     <Label text="Cette interface vous guide pas à pas pour définir votre régime, suivre vos repas du jour et vérifier votre progression nutritionnelle." style="-fx-text-fill: #334155;"/>
                                     <HBox spacing="10">
                                         <Label text=" 1. Ajoutez/sélectionnez régime" style="-fx-background-color: white; -fx-border-color: #d7e2ef; -fx-border-radius: 999; -fx-background-radius: 999; -fx-padding: 4 12; -fx-font-size: 11px; -fx-font-weight: 600;" />
                                         <Label text=" 2. Ajoutez vos repas" style="-fx-background-color: white; -fx-border-color: #d7e2ef; -fx-border-radius: 999; -fx-background-radius: 999; -fx-padding: 4 12; -fx-font-size: 11px; -fx-font-weight: 600;" />
                                         <Label text=" 3. Suivez macros et calories" style="-fx-background-color: white; -fx-border-color: #d7e2ef; -fx-border-radius: 999; -fx-background-radius: 999; -fx-padding: 4 12; -fx-font-size: 11px; -fx-font-weight: 600;" />
                                     </HBox>
                                 </VBox>
                             </VBox>

                             <!-- 2 Column Grid -->
                             <GridPane hgap="24" vgap="24" style="-fx-padding: 24 0 0 0;">
                                 <columnConstraints>
                                     <ColumnConstraints hgrow="ALWAYS" percentWidth="55"/>
                                     <ColumnConstraints hgrow="ALWAYS" percentWidth="45"/>
                                 </columnConstraints>
                                 
                                 <!-- LEFT COL -->
                                 <VBox spacing="24" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                     <!-- Card 1: My Diet Hero -->
                                      <VBox style="-fx-background-color: linear-gradient(to bottom right, #0c3f44, #14725d); -fx-background-radius: 14; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(12,63,68,0.2), 20, 0, 0, 10);">
                                            <HBox alignment="TOP_RIGHT">
                                                 <Label fx:id="lblPlannerHealthBadge" text="Normal" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-padding: 4 12; -fx-background-radius: 20; -fx-font-size: 11px; -fx-font-weight: 700;"/>
                                            </HBox>
                                            <Label fx:id="lblPlannerRegimeTitle" text="Mon Régime Actuel" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: white;"/>
                                            <Label fx:id="lblPlannerRegimeSubtitle" text="Votre plan nutritionnel personnalisé" style="-fx-font-size: 13px; -fx-text-fill: #cbd5e1; -fx-padding: 4 0 16 0;"/>
                                            <HBox spacing="16">
                                                <VBox>
                                                    <Label text="Objectif Calories" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                                                    <Label fx:id="lblPlannerTargetCalories" text="2400 kcal" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                                                </VBox>
                                                <VBox>
                                                    <Label text="Votre BMI" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                                                    <Label fx:id="lblPlannerBmi" text="22.5" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                                                </VBox>
                                                <VBox>
                                                    <Label text="Suggestions" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                                                    <Label fx:id="lblPlannerMealsHint" text="8 idées" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                                                </VBox>
                                            </HBox>
                                            <VBox style="-fx-padding: 16 0 0 0;">
                                                 <Label text="Repas recommandés :" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-padding: 0 0 4 0;"/>
                                                 <Label fx:id="lblPlannerRecommendedMeals" text="Salade César, Poulet grillé..." wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #e2e8f0; -fx-font-style: italic;"/>
                                            </VBox>
                                      </VBox>
                                     
                                     <!-- Card 2: Today's Summary -->
                                     <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e2e8f0; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 20, 0, 0, 10);">
                                          <HBox style="-fx-padding: 14 18; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;" alignment="CENTER_LEFT">
                                               <Label text="Today's Summary" style="-fx-font-weight: 800; -fx-text-fill: #1f2937; -fx-font-size: 15px;"/>
                                          </HBox>
                                          <VBox style="-fx-padding: 18;" spacing="18">
                                                <Label text="Cette section montre votre progression du jour. Les pourcentages indiquent votre avancement par rapport à vos objectifs." wrapText="true" style="-fx-padding: 8 12; -fx-background-color: #f8fbff; -fx-border-color: #d5e2ee; -fx-border-style: dashed; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #475569;"/>
                                                <HBox spacing="30">
                                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                        <HBox alignment="CENTER_LEFT">
                                                            <Label text="Calories" style="-fx-font-size:12px; -fx-text-fill:#6b7280;"/>
                                                            <Region HBox.hgrow="ALWAYS" />
                                                            <Label fx:id="lblPlannerCaloriesProgress" text="0/0" style="-fx-font-size:10px; -fx-text-fill:#6b7280;"/>
                                                        </HBox>
                                                        <ProgressBar fx:id="pbPlannerCalories" progress="0.0" maxWidth="Infinity" style="-fx-accent: #0c3f44;"/>
                                                    </VBox>
                                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                        <HBox alignment="CENTER_LEFT">
                                                            <Label text="Proteins" style="-fx-font-size:12px; -fx-text-fill:#6b7280;"/>
                                                            <Region HBox.hgrow="ALWAYS" />
                                                            <Label fx:id="lblPlannerProteinesProgress" text="0/0" style="-fx-font-size:10px; -fx-text-fill:#6b7280;"/>
                                                        </HBox>
                                                        <ProgressBar fx:id="pbPlannerProteines" progress="0.0" maxWidth="Infinity" style="-fx-accent: #0c3f44;"/>
                                                    </VBox>
                                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                        <HBox alignment="CENTER_LEFT">
                                                            <Label text="Carbs" style="-fx-font-size:12px; -fx-text-fill:#6b7280;"/>
                                                            <Region HBox.hgrow="ALWAYS" />
                                                            <Label fx:id="lblPlannerGlucidesProgress" text="0/0" style="-fx-font-size:10px; -fx-text-fill:#6b7280;"/>
                                                        </HBox>
                                                        <ProgressBar fx:id="pbPlannerGlucides" progress="0.0" maxWidth="Infinity" style="-fx-accent: #0c3f44;"/>
                                                    </VBox>
                                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                                        <HBox alignment="CENTER_LEFT">
                                                            <Label text="Fats" style="-fx-font-size:12px; -fx-text-fill:#6b7280;"/>
                                                            <Region HBox.hgrow="ALWAYS" />
                                                            <Label fx:id="lblPlannerLipidesProgress" text="0/0" style="-fx-font-size:10px; -fx-text-fill:#6b7280;"/>
                                                        </HBox>
                                                        <ProgressBar fx:id="pbPlannerLipides" progress="0.0" maxWidth="Infinity" style="-fx-accent: #0c3f44;"/>
                                                    </VBox>
                                                </HBox>
                                          </VBox>
                                     </VBox>
                                     
                                     <!-- Card 3: Today's Meals List -->
                                     <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e2e8f0; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 20, 0, 0, 10);">
                                          <HBox style="-fx-padding: 14 18; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;" alignment="CENTER_LEFT">
                                               <Label text="Today's Meals List" style="-fx-font-weight: 800; -fx-text-fill: #1f2937; -fx-font-size: 15px;"/>
                                               <Region HBox.hgrow="ALWAYS" />
                                               <Button text="Checklist du jour" style="-fx-background-color: #f0f4f8; -fx-border-color: #cbd5e1; -fx-text-fill: #0c3f44; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                                          </HBox>
                                          <VBox style="-fx-padding: 18;" spacing="14">
                                               <Label fx:id="lblPlannerMealsSubtitle" text="Vos derniers repas enregistrés." style="-fx-font-size: 13px; -fx-text-fill: #475569;" />
                                               <VBox fx:id="plannerMealsListBox" spacing="10" />
                                               <TableView fx:id="tableRepas" managed="false" prefHeight="0.0" styleClass="data-table" visible="false">
                                    <columns>
                                        <TableColumn fx:id="colRepasId" prefWidth="60.0" text="ID"/>
                                        <TableColumn fx:id="colRepasUser" prefWidth="200.0" text="Utilisateur"/>
                                        <TableColumn fx:id="colRepasNom" prefWidth="170.0" text="Nom"/>
                                        <TableColumn fx:id="colRepasType" prefWidth="120.0" text="Type"/>
                                        <TableColumn fx:id="colRepasDate" prefWidth="140.0" text="Date"/>
                                        <TableColumn fx:id="colRepasCalories" prefWidth="90.0" text="Calories"/>
                                        <TableColumn fx:id="colRepasProteines" prefWidth="90.0" text="Proteines"/>
                                        <TableColumn fx:id="colRepasGlucides" prefWidth="90.0" text="Glucides"/>
                                        <TableColumn fx:id="colRepasLipides" prefWidth="90.0" text="Lipides"/>
                                        <TableColumn fx:id="colRepasRegimeId" prefWidth="220.0" text="Regime"/>
                                    </columns>
                                </TableView>
                                               <HBox alignment="CENTER_RIGHT" spacing="10">
                                                   <!-- Action bound to create repas form! -->
                                                   <Button text="+ Ajouter un repas" onAction="#afficherCreationRepas" style="-fx-background-color: #0c3f44; -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 8; -fx-padding: 8 16;" />
                                               </HBox>
                                          </VBox>
                                     </VBox>
                                 </VBox>

                                 <!-- RIGHT COL -->
                                 <VBox spacing="24" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                     <!-- Card 1: Badges -->
                                     <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e2e8f0; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 20, 0, 0, 10);">
                                          <HBox style="-fx-padding: 14 18; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;" alignment="CENTER_LEFT">
                                               <Label text="Badges du jour" style="-fx-font-weight: 800; -fx-text-fill: #1f2937; -fx-font-size: 15px;"/>
                                          </HBox>
                                          <VBox style="-fx-padding: 18;" spacing="10">
                                                <VBox style="-fx-background-color: #ecfdf5; -fx-border-color: #22c55e; -fx-border-style: dashed; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 8 12;">
                                                    <Label text="Semaine parfaite" style="-fx-font-weight: 700; -fx-text-fill: #111827;"/>
                                                    <Label text="Calories dans la cible aujourd'hui." style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                                                </VBox>
                                                <VBox style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-style: dashed; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 8 12; -fx-opacity: 0.85;">
                                                    <Label text="Hydratation OK" style="-fx-font-weight: 700; -fx-text-fill: #111827;"/>
                                                    <Label text="Au moins 3 repas/collations enregistrés." style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
                                                </VBox>
                                          </VBox>
                                     </VBox>
                                     
                                     <!-- Card 2: Mes Régimes -->
                                     <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e2e8f0; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.06), 20, 0, 0, 10);">
                                          <HBox style="-fx-padding: 14 18; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;" alignment="CENTER_LEFT" spacing="10">
                                               <Label text="Mes régimes" style="-fx-font-weight: 800; -fx-text-fill: #1f2937; -fx-font-size: 15px;"/>
                                               <Region HBox.hgrow="ALWAYS" />
                                               <Button text="+ Ajouter un régime" onAction="#afficherCreationRegime" style="-fx-background-color: #e8f3f0; -fx-text-fill: #0c3f44; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 6 12;" />
                                          </HBox>
                                          <VBox style="-fx-padding: 18;" spacing="18">
                                                <Label text="Gérez tous vos régimes ici. Modifiez, supprimez et explorez vos plannings nutritionnels." wrapText="true" style="-fx-padding: 8 12; -fx-background-color: #f8fbff; -fx-border-color: #d5e2ee; -fx-border-style: dashed; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #475569;"/>
                                                
                                                <Label fx:id="lblRegimeExploreCount" text="0 régimes trouvés" style="-fx-font-size: 12; -fx-text-fill: #6b7280;" />
                                                <TilePane fx:id="tileRegimeCards" hgap="12" vgap="12" prefColumns="1" />
                                                <TableView fx:id="tableRegimes" prefHeight="580.0" styleClass="data-table">
                                    <columns>
                                        <TableColumn fx:id="colRegimeId" prefWidth="60.0" text="ID"/>
                                        <TableColumn fx:id="colRegimeUser" prefWidth="210.0" text="Utilisateur"/>
                                        <TableColumn fx:id="colRegimeType" prefWidth="150.0" text="Type sante"/>
                                        <TableColumn fx:id="colRegimeCalories" prefWidth="130.0" text="Calories"/>
                                        <TableColumn fx:id="colRegimeBmi" prefWidth="90.0" text="BMI"/>
                                        <TableColumn fx:id="colRegimeTaille" prefWidth="90.0" text="Taille"/>
                                        <TableColumn fx:id="colRegimePoids" prefWidth="90.0" text="Poids"/>
                                        <TableColumn fx:id="colRegimeAge" prefWidth="80.0" text="Age"/>
                                        <TableColumn fx:id="colRegimeRepas" prefWidth="320.0" text="Repas adequats"/>
                                    </columns>
                                </TableView>
                                          </VBox>
                                     </VBox>
                                 </VBox>
                             </GridPane>
                         </VBox>
                    </StackPane>
                </content>
            </ScrollPane>
            
            <!-- OVERLAY FOR FORMS -->
            <StackPane pickOnBounds="false">
                <!-- 1. AJOUTER REGIME -->
                <VBox fx:id="paneRegimeCreate" alignment="CENTER" managed="false" visible="false" style="-fx-background-color: rgba(0,0,0,0.5);">
                    <ScrollPane fitToWidth="true" maxWidth="950" maxHeight="850" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 20;">
                        <content>
                            <VBox maxWidth="850" spacing="18.0" styleClass="panel-card planner-form-card" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 30, 0, 0, 15);">
                                <HBox alignment="CENTER_RIGHT"><Button onAction="#masquerTousLesFormulaires" text="✖ Fermer" style="-fx-background-color: #bb2d22; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 8;"/></HBox>
                                <Label styleClass="section-title" text="Ajouter un regime"/>
                                <Label styleClass="section-subtitle" text="Les champs auto s'ajustent pendant la saisie."/>
                                <GridPane hgap="16.0" vgap="16.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.0"/>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.0"/>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="34.0"/>
                                    </columnConstraints>
                                    <VBox spacing="8.0" styleClass="field-card" GridPane.columnSpan="3">
                                        <Label styleClass="field-label" text="Utilisateur"/>
                                        <ComboBox fx:id="cbRegimeUser" maxWidth="1.7976931348623157E308" styleClass="combo-input"/>
                                    </VBox>
                                    <VBox spacing="8.0" styleClass="metric-card" GridPane.rowIndex="1">
                                        <Label styleClass="field-label" text="Taille (cm)"/>
                                        <TextField fx:id="tfRegimeTaille" promptText="175" styleClass="text-input"/>
                                    </VBox>
                                    <VBox spacing="8.0" styleClass="metric-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label styleClass="field-label" text="Poids (kg)"/>
                                        <TextField fx:id="tfRegimePoids" promptText="72" styleClass="text-input"/>
                                    </VBox>
                                    <VBox spacing="8.0" styleClass="metric-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                        <Label styleClass="field-label" text="Age"/>
                                        <TextField fx:id="tfRegimeAge" promptText="29" styleClass="text-input"/>
                                    </VBox>
                                    <VBox spacing="8.0" styleClass="metric-card" GridPane.rowIndex="2">
                                        <Label styleClass="field-label" text="BMI (auto)"/>
                                        <TextField fx:id="tfRegimeBmi" styleClass="text-input"/>
                                    </VBox>
                                    <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                        <Label styleClass="field-label" text="Type sante (auto)"/>
                                        <ComboBox fx:id="cbRegimeTypeSante" maxWidth="1.7976931348623157E308" styleClass="combo-input"/>
                                    </VBox>
                                    <VBox spacing="8.0" styleClass="field-card" GridPane.columnIndex="2" GridPane.rowIndex="2">
                                        <Label styleClass="field-label" text="Calories cibles (auto)"/>
                                        <TextField fx:id="tfRegimeCaloriesCibles" styleClass="text-input"/>
                                    </VBox>
                                    <VBox spacing="8.0" styleClass="field-card" GridPane.columnSpan="3" GridPane.rowIndex="3">
                                        <Label styleClass="field-label" text="Repas adequats (auto)"/>
                                        <TextArea fx:id="taRegimeRepasAdequats" prefHeight="110.0" styleClass="text-area-input"/>
                                    </VBox>
                                </GridPane>
                                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                    <Button onAction="#viderFormulaireRegime" styleClass="secondary-button" text="Annuler"/>
                                    <Button onAction="#ajouterRegime" styleClass="primary-button" text="Creer le regime"/>
                                </HBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </VBox>

                <!-- 2. MODIFIER REGIME -->
                <VBox fx:id="paneRegimeEdit" alignment="CENTER" managed="false" visible="false" style="-fx-background-color: rgba(0,0,0,0.5);">
                    <ScrollPane fitToWidth="true" maxWidth="950" maxHeight="850" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 20;">
                        <content>
                            <VBox maxWidth="850" spacing="18.0" styleClass="panel-card" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 30, 0, 0, 15);">
                                <HBox alignment="CENTER_RIGHT"><Button onAction="#masquerTousLesFormulaires" text="✖ Fermer" style="-fx-background-color: #bb2d22; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 8;"/></HBox>
                                <Label styleClass="section-title" text="Modifier un regime"/>
                                <Label styleClass="section-subtitle" text="Selectionnez un regime puis mettez a jour ses donnees."/>
                                <TextField fx:id="tfRegimeId" editable="false" managed="false" visible="false"/>
                                <TableView fx:id="tableRegimesEdit" prefHeight="290.0" styleClass="data-table">
                                    <columns>
                                        <TableColumn fx:id="colRegimeIdEdit" prefWidth="60.0" text="ID"/>
                                        <TableColumn fx:id="colRegimeUserEdit" prefWidth="210.0" text="Utilisateur"/>
                                        <TableColumn fx:id="colRegimeTypeEdit" prefWidth="150.0" text="Type sante"/>
                                        <TableColumn fx:id="colRegimeCaloriesEdit" prefWidth="130.0" text="Calories"/>
                                        <TableColumn fx:id="colRegimeBmiEdit" prefWidth="100.0" text="BMI"/>
                                        <TableColumn fx:id="colRegimeRepasEdit" prefWidth="260.0" text="Repas adequats"/>
                                    </columns>
                                </TableView>
