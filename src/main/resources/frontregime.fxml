                                        <TableColumn fx:id="colRegimeIdDelete" prefWidth="60.0" text="ID"/>
                                        <TableColumn fx:id="colRegimeUserDelete" prefWidth="210.0" text="Utilisateur"/>
                                        <TableColumn fx:id="colRegimeTypeDelete" prefWidth="150.0" text="Type sante"/>
                                        <TableColumn fx:id="colRegimeCaloriesDelete" prefWidth="130.0" text="Calories"/>
                                        <TableColumn fx:id="colRegimeBmiDelete" prefWidth="100.0" text="BMI"/>
                                        <TableColumn fx:id="colRegimeRepasDelete" prefWidth="280.0" text="Repas adequats"/>
                                    </columns>
                                </TableView>
                                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                    <Label fx:id="lblRegimeSelectionDelete" styleClass="hint-label" text="Aucun regime selectionne"/>
                                    <Button onAction="#supprimerRegime" styleClass="danger-button" text="Supprimer definitivement"/>
                                </HBox>
                            </VBox>
                            <VBox fx:id="paneRegimeExplore" managed="false" spacing="18.0" styleClass="panel-card" visible="false">
                                <Label styleClass="section-title" text="Explorer les regimes"/>
                                <Label styleClass="section-subtitle" text="Lecture des regimes enregistres depuis la base Symfony."/>
                                <TableView fx:id="tableRegimes" prefHeight="580.0" styleClass="data-table">
                                    <columns>
                                        <TableColumn fx:id="colRegimeId" prefWidth="60.0" text="ID"/>
                                        <TableColumn fx:id="colRegimeUser" prefWidth="210.0" text="Utilisateur"/>
                                        <TableColumn fx:id="colRegimeType" prefWidth="150.0" text="Type sante"/>
                                        <TableColumn fx:id="colRegimeCalories" prefWidth="130.0" text="Calories"/>
                                        <TableColumn fx:id="colRegimeBmi" prefWidth="90.0" text="BMI"/>
                                        <TableColumn fx:id="colRegimeTaille" prefWidth="90.0" text="Taille"/>
                                        <TableColumn fx:id="colRegimePoids" prefWidth="90.0" text="Poids"/>
                                        <TableColumn fx:id="colRegimeAge" prefWidth="80.0" text="Age"/>
                                        <TableColumn fx:id="colRegimeRepas" prefWidth="320.0" text="Repas adequats"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </StackPane>
                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
